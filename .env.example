# ============================================================================
# QUANTIX CORE — Production Environment Configuration
#
# Copy this file to .env and fill in all values marked "REQUIRED"
# Leave template values as-is for development
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./db/custom.db"

# ── Public Domain ────────────────────────────────────────────────────────────
NEXT_PUBLIC_STOREFRONT_DOMAIN="quantixtechnology.in"

# ── Google Maps (REQUIRED for map-first address picker) ─────────────────────
# Enables Places search, the draggable-pin map and reverse geocoding on the
# storefront (Swiggy/Blinkit-style address selection). WITHOUT a key the
# storefront degrades to manual entry + GPS.
#
# Create the key in Google Cloud Console (https://console.cloud.google.com/apis):
#   1. Enable APIs:  Maps JavaScript API, Places API, Geocoding API
#   2. Create an API key under "Credentials"
#   3. Recommended: restrict the key to your storefront domain(s), e.g.
#      *.quantixtechnology.in
#   4. Set the SAME value as the GitHub Actions secret
#      NEXT_PUBLIC_GOOGLE_MAPS_API_KEY so it is baked into the VPS build
#      (never commit the key to git).
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Email / SMTP (REQUIRED FOR PRODUCTION) ──────────────────────────────────
# Gmail SMTP for transactional email (OTP, notifications, receipts)
# Gmail App Password: https://myaccount.google.com/apppasswords
# Steps:
#   1. Enable 2FA on otp@quantixtechnology.in
#   2. Generate App Password
#   3. Paste the 16-character password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=otp@quantixtechnology.in
SMTP_PASS=your-gmail-app-password-16-chars
MAIL_FROM="Quantix OTP <otp@quantixtechnology.in>"

# ── Payment / Billing (REQUIRED FOR PRODUCTION) ──────────────────────────────
# Razorpay credentials for subscription billing
# Get keys from: https://dashboard.razorpay.com/
# Production keys start with: "rzp_live_"
# Sandbox keys start with: "rzp_test_"
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Authentication ──────────────────────────────────────────────────────────
# Encryption key for credential storage (64 character hex string)
# Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPT_KEY=your-64-char-hex-encryption-key

# ── Mobile Provisioning (Optional) ──────────────────────────────────────────
# Only needed if provisioning mobile apps automatically
MOBILE_PROVISION_URL=https://provisioning.apple.example.com
MOBILE_PROVISION_API_KEY=your-api-key
MOBILE_WEBHOOK_SECRET=your-webhook-secret

# ── Deployment Webhook (Optional) ───────────────────────────────────────────
# Only needed if integrating with deployment pipeline
DEPLOY_WEBHOOK_SECRET=your-webhook-secret
DEPLOY_APP_URL=https://app.quantixtechnology.in

# ── Security / Turnstile (Optional) ─────────────────────────────────────────
# Cloudflare Turnstile for bot protection (optional, not required for MVP)
TURNSTILE_SECRET_KEY=your-turnstile-secret

# ── Realtime Service (Optional) ─────────────────────────────────────────────
# Port for realtime updates (WebSocket)
REALTIME_SERVICE_PORT=3001

# ── File Upload Storage ─────────────────────────────────────────────────────
# Path where uploaded files are stored (relative or absolute)
UPLOAD_ROOT=./public/uploads

# ── Development Only ────────────────────────────────────────────────────────
NODE_ENV=development
QUANTIX_PROJECT_DIR=./

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
#
# Before deploying to production, ensure:
# ☐ All REQUIRED fields are filled in
# ☐ Email credentials are verified (test send)
# ☐ Payment keys are from Razorpay LIVE environment (not sandbox)
# ☐ Webhook secrets match registered webhooks
# ☐ Encryption key is backed up securely
# ☐ No secrets are logged or exposed in error messages
# ============================================================================
