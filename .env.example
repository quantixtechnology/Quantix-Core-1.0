DATABASE_URL=
NEXTAUTH_SECRET=
NEXT_PUBLIC_STOREFRONT_DOMAIN=quantixtechnology.in
VPS_HOST=
CREDENTIAL_ENCRYPT_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Gmail SMTP — OTP email delivery ─────────────────────────────────────────
# 1. Enable 2-Step Verification on the Gmail account
# 2. Go to myaccount.google.com/apppasswords → create App Password
# 3. Paste the 16-char password as SMTP_PASS (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=otp@quantixtechnology.in
SMTP_PASS=
MAIL_FROM="Quantix OTP <otp@quantixtechnology.in>"

# ── Cloudflare Turnstile — Public Lead CAPTCHA ───────────────────────────────
# Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
# Must match site key used on quantixtechnology.in website (NEXT_PUBLIC_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=

# ── Deploy Webhook ───────────────────────────────────────────────────────────
# Used by POST /api/deploy — GitHub Actions sends this secret as the
# x-deploy-secret header instead of SSHing into the VPS.
# Generate: openssl rand -hex 32
# Also add as GitHub Secret: DEPLOY_WEBHOOK_SECRET (same value)
# Also add as GitHub Secret: DEPLOY_APP_URL=https://app.quantixtechnology.in
DEPLOY_WEBHOOK_SECRET=

# ── Mobile Provisioning ──────────────────────────────────────────────────────
# URL of the mobile-provision microservice (services/mobile-provision/)
MOBILE_PROVISION_URL=http://localhost:3400
# API key matching services/mobile-provision/.env API_KEY
MOBILE_PROVISION_API_KEY=
# Shared secret for inbound CI webhooks (POST /api/core/mobile/webhook)
MOBILE_WEBHOOK_SECRET=

# ── PWA / Service Worker — Temporary Bypass ──────────────────────────────────
# Set NEXT_PUBLIC_DISABLE_SW=true to disable service worker registration and
# serve a no-op worker. All existing caches are wiped on page load.
# Remove this env var once the incident investigation is resolved.
NEXT_PUBLIC_DISABLE_SW=false
