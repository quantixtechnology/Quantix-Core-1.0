# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# SQLite database — never commit the live DB; VPS keeps its own copy
prisma/db/*.db
prisma/db/*.db-journal
prisma/db/*.db-shm
prisma/db/*.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/public/manifest.json
apps/customer_app/.dart_tool/

# ── Android wrapper ─────────────────────────────────────────────────────────
# Signing material NEVER goes in the repo. Losing the keystore means future
# versions cannot install over the current ones without users uninstalling, so
# it lives in ~/.quantix-android and is backed up out of band.
*.jks
*.keystore
android-wrapper/local.properties
android-wrapper/.gradle/
android-wrapper/build/
android-wrapper/app/build/
# Generated per tenant at build time from that app's own branding icon.
android-wrapper/app/src/main/res/mipmap-*/
