_AddressDTO _$AddressDTOFromJson(Map<String, dynamic> json) => _AddressDTO(
  id: json['id'] as String,
  customerId: json['customerId'] as String,
  addressLine1: json['addressLine1'] as String,
  city: json['city'] as String,
  pincode: json['pincode'] as String,
  country: json['country'] as String,
  state: json['state'] as String,
  isDefault: json['isDefault'] as bool,
  createdAt: json['createdAt'] as String,
  updatedAt: json['updatedAt'] as String,
  label: json['label'] as String?,
  area: json['area'] as String?,
  addressLine2: json['addressLine2'] as String?,
  landmark: json['landmark'] as String?,
  instructions: json['instructions'] as String?,
  latitude: (json['latitude'] as num?)?.toDouble(),
  longitude: (json['longitude'] as num?)?.toDouble(),
  gpsAccuracy: (json['gpsAccuracy'] as num?)?.toDouble(),
);

Map<String, dynamic> _$AddressDTOToJson(_AddressDTO instance) =>
    <String, dynamic>{
      'id': instance.id,
      'customerId': instance.customerId,
      'addressLine1': instance.addressLine1,
      'city': instance.city,
      'pincode': instance.pincode,
      'country': instance.country,
      'state': instance.state,
      'isDefault': instance.isDefault,
      'createdAt': instance.createdAt,
      'updatedAt': instance.updatedAt,
      'label': instance.label,
      'area': instance.area,
      'addressLine2': instance.addressLine2,
      'landmark': instance.landmark,
      'instructions': instance.instructions,
      'latitude': instance.latitude,
      'longitude': instance.longitude,
      'gpsAccuracy': instance.gpsAccuracy,
    };

