// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

_CartVariantSummary _$CartVariantSummaryFromJson(Map<String, dynamic> json) =>
    _CartVariantSummary(
      id: json['id'] as String,
      name: json['name'] as String,
      price: (json['price'] as num).toDouble(),
      sku: json['sku'] as String?,
      mrp: (json['mrp'] as num?)?.toDouble(),
      discountPrice: (json['discountPrice'] as num?)?.toDouble(),
    );

Map<String, dynamic> _$CartVariantSummaryToJson(_CartVariantSummary instance) =>
    <String, dynamic>{
      'id': instance.id,
      'name': instance.name,
      'price': instance.price,
      'sku': instance.sku,
      'mrp': instance.mrp,
      'discountPrice': instance.discountPrice,
    };

_CartProductSummary _$CartProductSummaryFromJson(Map<String, dynamic> json) =>
    _CartProductSummary(
      name: json['name'] as String,
      slug: json['slug'] as String,
      images: (json['images'] as List<dynamic>)
          .map((e) => e as String)
          .toList(),
      status: json['status'] as String,
    );

Map<String, dynamic> _$CartProductSummaryToJson(_CartProductSummary instance) =>
    <String, dynamic>{
      'name': instance.name,
      'slug': instance.slug,
      'images': instance.images,
      'status': instance.status,
    };

_CartItemDTO _$CartItemDTOFromJson(Map<String, dynamic> json) => _CartItemDTO(
  id: json['id'] as String,
  productId: json['productId'] as String,
  storeId: json['storeId'] as String,
  quantity: (json['quantity'] as num).toInt(),
  unitPrice: (json['unitPrice'] as num).toDouble(),
  lineTotal: (json['lineTotal'] as num).toDouble(),
  product: CartProductSummary.fromJson(json['product'] as Map<String, dynamic>),
  variantId: json['variantId'] as String?,
  availableQty: (json['availableQty'] as num?)?.toInt(),
  inventoryStatus: json['inventoryStatus'] as String?,
  variant: json['variant'] == null
      ? null
      : CartVariantSummary.fromJson(json['variant'] as Map<String, dynamic>),
);

Map<String, dynamic> _$CartItemDTOToJson(_CartItemDTO instance) =>
    <String, dynamic>{
      'id': instance.id,
      'productId': instance.productId,
      'storeId': instance.storeId,
      'quantity': instance.quantity,
      'unitPrice': instance.unitPrice,
      'lineTotal': instance.lineTotal,
      'product': instance.product,
      'variantId': instance.variantId,
      'availableQty': instance.availableQty,
      'inventoryStatus': instance.inventoryStatus,
      'variant': instance.variant,
    };

_CartDTO _$CartDTOFromJson(Map<String, dynamic> json) => _CartDTO(
  data: (json['data'] as List<dynamic>)
      .map((e) => CartItemDTO.fromJson(e as Map<String, dynamic>))
      .toList(),
  total: (json['total'] as num).toDouble(),
  itemCount: (json['itemCount'] as num).toInt(),
);

Map<String, dynamic> _$CartDTOToJson(_CartDTO instance) => <String, dynamic>{
  'data': instance.data,
  'total': instance.total,
  'itemCount': instance.itemCount,
};

_AddToCartRequest _$AddToCartRequestFromJson(Map<String, dynamic> json) =>
    _AddToCartRequest(
      productId: json['productId'] as String,
      storeId: json['storeId'] as String,
      quantity: (json['quantity'] as num?)?.toInt() ?? 1,
      variantId: json['variantId'] as String?,
    );

Map<String, dynamic> _$AddToCartRequestToJson(_AddToCartRequest instance) =>
    <String, dynamic>{
      'productId': instance.productId,
      'storeId': instance.storeId,
      'quantity': instance.quantity,
      'variantId': instance.variantId,
    };

_CouponDTO _$CouponDTOFromJson(Map<String, dynamic> json) => _CouponDTO(
  id: json['id'] as String,
  code: json['code'] as String,
  type: json['type'] as String,
  value: (json['value'] as num).toDouble(),
  minOrder: (json['minOrder'] as num).toDouble(),
  validUntil: json['validUntil'] as String,
  description: json['description'] as String?,
  maxDiscount: (json['maxDiscount'] as num?)?.toDouble(),
  usageLeft: (json['usageLeft'] as num?)?.toInt(),
);

Map<String, dynamic> _$CouponDTOToJson(_CouponDTO instance) =>
    <String, dynamic>{
      'id': instance.id,
      'code': instance.code,
      'type': instance.type,
      'value': instance.value,
      'minOrder': instance.minOrder,
      'validUntil': instance.validUntil,
      'description': instance.description,
      'maxDiscount': instance.maxDiscount,
      'usageLeft': instance.usageLeft,
    };
