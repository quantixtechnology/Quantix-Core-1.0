  createdAt          DateTime        @default(now())

  @@index([businessId])
}

// ── 3. Operational Configuration ──────────────────────────────────────────
// Only these 4 toggles. They directly determine workflow stage generation.
model LaundryOperationalConfig {
  id                     String          @id @default(cuid())
  businessId             String          @unique
  business               LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transportEnabled       Boolean         @default(true)
  barcodeEnabled         Boolean         @default(true)
  homeDeliveryEnabled    Boolean         @default(true)
  ironingEnabled         Boolean         @default(true)
  // Charges & Rules — two simple business rules (minimums are MINIMUM BILL
  // VALUES per order type, not additional charges; 0 = no minimum).
  walkInMinOrder         Float           @default(0)
  pickupMinOrder         Float           @default(0)
  deliveryMinOrder       Float           @default(0)
  expressEnabled         Boolean         @default(false)
  expressTurnaroundHours Int?
  expressChargeType      String          @default("FIXED") // FIXED | PERCENT
  expressChargeValue     Float           @default(0)
  updatedAt              DateTime        @updatedAt
  createdAt              DateTime        @default(now())

  @@index([businessId])
}

// ── 4. Workflow & Quality Controls ────────────────────────────────────────
model LaundryWorkflowQualityConfig {
  id          String          @id @default(cuid())
  businessId  String          @unique
  business    LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  photoAudit  Boolean         @default(true)
  auditModule Boolean         @default(true)
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())

  @@index([businessId])
}

// ── 6. Branding & White Label ─────────────────────────────────────────────
// Quantix-controlled. Business owner can request changes; only Quantix applies.
model LaundryBrandingConfig {
  id                    String          @id @default(cuid())
  businessId            String          @unique
  business              LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logoUploaded          Boolean         @default(false)
  faviconUploaded       Boolean         @default(false)
  brandColorsConfigured Boolean         @default(false)
  dedicatedApk          Boolean         @default(false)
  customPackageName     Boolean         @default(false)
  customSplashScreen    Boolean         @default(false)
  customAppIcon         Boolean         @default(false)
  playStorePublished    Boolean         @default(false)
  customDomain          Boolean         @default(false)
  status                String          @default("PENDING") // PENDING | IN_PROGRESS | APPROVED | PUBLISHED
  updatedAt             DateTime        @updatedAt
  createdAt             DateTime        @default(now())

  @@index([businessId])
