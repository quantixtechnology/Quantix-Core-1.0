generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton settings record for the entire platform.
// Use getPlatformSettings() to read — never query this model directly.
model PlatformSettings {
  id String @id @default("singleton")

  // Company identity
  companyName    String?
  companyAddress String?
  companyEmail   String?
  companyPhone   String?
  companyWebsite String?
  companyGst     String?

  // Branding assets (stored as /uploads/platform/shared/<filename> URLs)
  logoUrl            String?
  darkLogoUrl        String?
  faviconUrl         String?
  emailLogoUrl       String?
  loginScreenLogoUrl String? // login page logo; falls back to logoUrl when null

  // Zone 1 — Core Platform: additional assets
  tagline        String?
  compactLogoUrl String? // collapsed sidebar / app icon
  watermarkUrl   String? // platform watermark

  // Zone 1 — Core Platform: brand colors
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  successColor   String?
  warningColor   String?
  infoColor      String?

  // Zone 2 — Sales Documents: assets
  salesLogoUrl      String?
  salesWatermarkUrl String?

  // Zone 2 — Sales Documents: config
  salesAccentColor String?
  salesFooterText  String?

  // Zone 3 — HRMS: assets
  hrmsLogoUrl      String?
  hrmsWatermarkUrl String?

  // Zone 3 — HRMS: config
  hrmsAccentColor      String?
  signatoryName        String?
  signatoryDesignation String?
  signatorySignUrl     String? // digital signature image
  signatoryStampUrl    String? // signature + stamp image

  // Zone 4 — Sidebar Theme
  sidebarBg           String? // e.g. #04132E
  sidebarActiveColor  String? // e.g. #2563EB
  sidebarTextColor    String? // e.g. #FFFFFF
  sidebarHeadingColor String? // e.g. #38BDF8
  sidebarLogoUrl      String? // dedicated sidebar logo; falls back to logoUrl when null

  // Billing / invoice configuration
  invoicePrefix String? @default("QTX")
  sacCode       String? @default("998314")

  // GST rates (percentages, e.g. 18 / 9 / 9)
  gstRate  Float? @default(18)
  cgstRate Float? @default(9)
  sgstRate Float? @default(9)

  // Zone 5 — Invoice Settings
  invoiceLogoUrl String? // dedicated invoice / billing logo

  // Invoice company identity (may differ from platform companyName)
  invoiceLegalName    String? // Legal company name
  invoiceBusinessName String? // Trade / business name
  invoiceAddress      String? // Full address line
  invoiceCity         String?
  invoiceState        String?
  invoicePincode      String?
  invoiceCountry      String? @default("India")
  invoicePhone        String?
  invoiceEmail        String?
  invoiceWebsite      String?

  // Tax & registration numbers (all optional; blank = hidden on invoices)
  companyPan     String? // PAN
  companyMsme    String? // MSME / Udyam registration
  companyShopEst String? // Shop & Establishment number
  companyIec     String? // IEC number
  companyCin     String? // CIN number

  // Banking details (displayed on unpaid invoices only)
  bankAccountName   String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankUpiId         String?

  // Invoice footer / notes
  invoiceFooterNotes     String? // SAC/HSN notes shown in footer
  invoiceLegalDisclaimer String? // Legal disclaimer text
  invoiceDefaultNotes    String? // Default notes on every invoice

  // Zone 6 — Quote / Proposal Settings (independent of Invoice Settings)
  quoteLogoUrl         String? // overrides salesLogoUrl for quote PDFs
  quoteAccentColor     String? // overrides salesAccentColor for quote PDFs
  quoteFooterText      String? // overrides salesFooterText for quote PDFs
  quoteFooterColor     String? // hex colour for quote footer text/line
  quoteShowPageNumber  Boolean? // show "Page N of N"; null = true
  // Header visibility toggles (null = default shown/hidden per field)
  quoteShowLogo        Boolean? // show logo in header; null = true
  quoteShowCompanyName Boolean? // show company name; null = true
  quoteShowAddress     Boolean? // show registered address; null = false
  quoteShowPhone       Boolean? // show phone; null = false
  quoteShowEmail       Boolean? // show email; null = false
  quoteShowWebsite     Boolean? // show website; null = true
  // Last page legal info visibility (null = true — show if value exists)
  quoteShowGST         Boolean?
  quoteShowPAN         Boolean?
  quoteShowMSME        Boolean?
  quoteShowShopAct     Boolean?
  quoteShowCIN         Boolean?
  quoteShowIEC         Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PLATFORM PRODUCT REGISTRY
// Master record of all products supported by Quantix Core Platform
// ============================================================================

model PlatformProduct {
  id String @id @default(cuid())

  // Product identification
  code        String  @unique // e.g., "COMMERCE", "LAUNDRY", "CARWASH"
  name        String // e.g., "Commerce OS"
  slug        String  @unique // e.g., "commerce-os"
  description String? // Product description
  productType String  @default("OS") // e.g., "OS", "SERVICE", "MODULE"

  // Deployment information
  workspaceUrl         String // Base workspace URL (e.g., commerce.quantixtechnology.in)
  currentVersion       String  @default("1.0.0")
  supportedCoreVersion String? // Minimum Quantix Core version required

  // Runtime Information (v1.4.0)
  apiBaseUrl            String? // Product API endpoint (e.g., https://commerce.../api)
  healthCheckUrl        String? // Product health endpoint
  provisionerName       String? // Provisioner identifier for registry lookup
  deploymentMode        String    @default("LOCAL_MODULE") // LOCAL_MODULE, SUBDOMAIN, REMOTE_SERVICE, CONTAINER
  deploymentStatus      String    @default("READY") // READY, DEPLOYING, FAILED, MAINTENANCE
  supportedApiVersion   String    @default("v1") // API version product supports
  buildNumber           String? // Build/release number
  lastDeploymentAt      DateTime? // When product was last deployed
  lastHealthCheckAt     DateTime? // When product was last health checked
  lastHealthCheckStatus String? // Last health check result (HEALTHY, WARNING, OFFLINE)

  // Product status & visibility
  status    String  @default("ACTIVE") // ACTIVE, PLANNED, DEPRECATED, DISABLED
  isEnabled Boolean @default(true) // Admin can disable product

  // Storage & quotas
  defaultStorageQuotaMB Int @default(1048576) // 1GB default

  // Branding
  brandingTemplate  String? // Reference to default branding template
  defaultBrandColor String  @default("#10B981") // Default primary color

  // Configuration
  defaultPlanId String? // Default plan for new businesses
  metadata      String  @default("{}") // JSON config (roles, features, etc.)

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([code])
  @@index([deploymentStatus])
}

// ============================================================================
// WORKSPACE REGISTRY
// Business workspace tracking for Quantix Super Admin
// Simple tracking of deployed customer workspaces
// ============================================================================

model PlatformWorkspace {
  id String @id @default(cuid())

  // Business & Product association
  businessId  String // Which business this workspace belongs to
  productCode String // Which product (e.g., COMMERCE, LAUNDRY)

  // Workspace identification
  workspaceUrl String @unique // The actual deployed URL (e.g., commerce.quantix.../tenantId)

  // Versioning - simple tracking
  currentVersion String @default("1.0.0") // Current deployed product version

  // Status - only what Super Admin needs to know
  status String @default("PROVISIONING") // PROVISIONING, READY, Running, Maintenance, Suspended, Archived, Failed

  // Provisioning tracking (v1.3.0)
  provisioningStatus      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  provisioningStartedAt   DateTime?
  provisioningCompletedAt DateTime?
  provisioningError       String?

  // Storage - simple tracking
  storageAllocatedMB Int @default(1048576) // Allocated quota in MB (default 1GB)
  storageUsedMB      Int @default(0) // Current usage in MB

  // Subscription info
  subscriptionPlan String? // e.g., "Starter", "Professional", "Enterprise"

  // Configuration (v1.3.0)
  websiteConfig   String @default("{}") // JSON website configuration
  workspaceConfig String @default("{}") // JSON workspace configuration

  // Website status - informational only
  websiteStatus String  @default("INACTIVE") // Active, Inactive, Pending
  websiteDomain String? // The domain if website is active

  // Feature count
  featuresEnabled Int @default(0) // Number of enabled features (informational)

  // Health - simple indicator
  healthStatus String @default("HEALTHY") // Healthy, Warning, Offline

  // Notes
  notes String? // Optional admin notes

  // Sync tracking
  lastSyncTime DateTime? // Last time workspace status was synced

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  provisioningAudits ProvisioningAuditLog[]

  @@unique([businessId, productCode]) // One workspace per business per product
  @@index([businessId])
  @@index([productCode])
  @@index([status])
  @@index([provisioningStatus])
}

// ============================================================================
// PROVISIONING AUDIT LOG (v1.3.0)
// Tracks all provisioning steps for each workspace
// ============================================================================

model ProvisioningAuditLog {
  id String @id @default(cuid())

  // Workspace reference
  workspaceId String
  workspace   PlatformWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Business reference for easier querying
  businessId String

  // Provisioning step information
  step   String // e.g., "validate_product", "assign_features", "apply_defaults", etc.
  status String // STARTED, COMPLETED, FAILED
  error  String? // Error message if failed

  // Details (JSON for flexibility)
  details String @default("{}") // Step-specific details

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int? // Duration in milliseconds

  // Audit
  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PRODUCT HOST PROVISIONING LOG (observability)
// One row per product-host provisioning attempt (POST /api/admin/products/[id]/
// provision-host). Records the per-step outcome so admins can diagnose nginx /
// certbot failures without server access. Does not affect provisioning behaviour.
// ============================================================================
model ProductHostProvisioningLog {
  id String @id @default(cuid())

  productCode String
  hostname    String
  requestedBy String? // Super Admin who triggered it (user id / email)

  // Lifecycle: PENDING -> RUNNING -> SUCCESS | FAILED
  status String @default("RUNNING")

  // Per-step status (mirror of the provisioner result; null until reached)
  nginxStatus       String? // created | existing | failed | not_reached
  certbotStatus     String? // issued | existing | failed | not_reached
  nginxReloadStatus String? // reloaded | failed | not_reached

  httpsReachable Boolean @default(false)
  success        Boolean @default(false)
  errorMessage   String? // complete error message on failure

  durationMs  Int? // execution duration
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([productCode])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PRODUCT MANAGEMENT
// Product Plans, Website Templates, Mobile Apps, Default Settings
// ============================================================================

model ProductPlan {
  id          String @id @default(cuid())
  productCode String // FK to PlatformProduct.code

  // Plan identification
  code        String // e.g., "STARTER", "PROFESSIONAL", "ENTERPRISE"
  name        String // Display name
  description String?

  // Features included
  includedFeatures String @default("[]") // JSON array of feature codes

  // Storage allocation
  storageQuotaMB Int @default(52428800) // 50GB default

  // Business limits
  userLimit   Int @default(10) // Max users
  branchLimit Int @default(1) // Max stores/branches

  // Pricing (stored as JSON for flexibility)
  pricing String @default("{}") // JSON: { currency, amount, interval }

  // Status
  status    String  @default("ACTIVE") // ACTIVE, RETIRED, BETA
  isDefault Boolean @default(false)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productCode, code])
  @@index([productCode])
  @@index([status])
}

model ProductWebsiteTemplate {
  id          String @id @default(cuid())
  productCode String @unique // FK to PlatformProduct.code

  // Template identification
  name        String // e.g., "Store Website", "Laundry Website", "Booking Website"
  description String?

  // Theme configuration (JSON)
  defaultTheme String @default("{}") // JSON: { colors, fonts, layout }

  // Page templates included
  includedPages String @default("[]") // JSON array of page types

  // Content structure (JSON)
  contentStructure String @default("{}") // JSON: typical content sections

  // Status
  status String @default("ACTIVE")

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductMobileApp {
  id          String @id @default(cuid())
  productCode String // FK to PlatformProduct.code

  // App identification
  appType     String // CUSTOMER, DELIVERY, ADMIN
  name        String // Display name
  description String?

  // Version tracking
  currentVersion String @default("1.0.0")

  // Build status
  buildStatus String @default("READY") // READY, BUILDING, FAILED

  // Store availability
  playStoreStatus String @default("AVAILABLE") // AVAILABLE, BUILDING, REJECTED, NOT_PUBLISHED
  appStoreStatus  String @default("AVAILABLE") // AVAILABLE, BUILDING, REJECTED, NOT_PUBLISHED

  // Store links
  playStoreUrl String?
  appStoreUrl  String?

  // Status
  status String @default("ACTIVE")

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productCode, appType])
  @@index([productCode])
}

model ProductDefaultSettings {
  id          String @id @default(cuid())
  productCode String @unique // FK to PlatformProduct.code

  // Localization defaults
  defaultCurrency String @default("INR") // ISO 4217
  defaultTimezone String @default("Asia/Kolkata")
  defaultLanguage String @default("en")

  // Business defaults
  orderPrefix   String @default("ORD") // Order number prefix
  invoicePrefix String @default("INV") // Invoice number prefix

  // Notification defaults (JSON)
  notificationDefaults String @default("{}") // Email, SMS, WhatsApp settings

  // Branding defaults (JSON)
  brandingDefaults String @default("{}") // Colors, logos, fonts

  // Feature defaults (JSON)
  featureDefaults String @default("{}") // Feature-specific default settings

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                     String           @id @default(cuid())
  salesRepId             String?
  assignedToUserId       String?
  businessName           String
  contactName            String
  contactEmail           String
  contactPhone           String
  businessType           BusinessType
  source                 LeadSource       @default(WEBSITE_INQUIRY)
  stage                  LeadStage        @default(LEAD)
  demoTenantId           String?
  demoSharedAt           DateTime?
  demoCredentials        String?
  demoFeedback           String?
  negotiatedMonthlyPrice Float?
  negotiatedYearlyPrice  Float?
  negotiationNotes       String?
  paymentProof           String?
  paymentVerifiedAt      DateTime?
  paymentVerifiedBy      String?
  selectedBillingCycle   String?
  convertedBusinessId    String?
  convertedAt            DateTime?
  lostReason             String?
  notes                  String?
  followUpDate           DateTime?
  estimatedValue         Float?
  tags                   String           @default("[]")
  lastContactedAt        DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  city                   String?
  createdById            String?
  lastFollowUpAt         DateTime?
  leadId                 String?          @unique
  pincode                String?
  state                  String?
  salesRep               SalesTeamMember? @relation(fields: [salesRepId], references: [id])
  assignedToUser         User?            @relation(fields: [assignedToUserId], references: [id])
  convertedBusiness      Business?        @relation("LeadConversion", fields: [convertedBusinessId], references: [id])

  @@index([leadId])
  @@index([salesRepId])
  @@index([assignedToUserId])
  @@index([stage])
  @@index([source])
  @@index([createdAt])
}

model LeadSequence {
  monthKey  String   @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ProposalSequence {
  monthKey  String   @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ProposalDocument {
  id              String    @id @default(cuid())
  proposalId      String    @unique
  documentType    String    @default("PROPOSAL")
  status          String    @default("ACTIVE")
  businessName    String
  clientName      String
  contactPhone    String?
  contactEmail    String?
  leadId          String?
  totalAmount     Float?
  salesTeamMember String?
  salesTeamEmail  String?
  formSnapshot    String    @default("{}")
  pdfPath         String?
  pdfVersion      Int       @default(1)
  createdBy       String
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedBy       String?

  @@index([proposalId])
  @@index([businessName])
  @@index([contactPhone])
  @@index([leadId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([documentType])
}

model LeadImportLog {
  id         String   @id @default(cuid())
  importedBy String
  importedAt DateTime @default(now())
  fileName   String?
  totalRows  Int      @default(0)
  imported   Int      @default(0)
  duplicates Int      @default(0)
  errors     Int      @default(0)
  notes      String?

  @@index([importedBy])
  @@index([importedAt])
}

model LeadExportLog {
  id         String    @id @default(cuid())
  exportedBy String
  exportedAt DateTime  @default(now())
  fromDate   DateTime?
  toDate     DateTime?
  filters    String?
  rowCount   Int       @default(0)

  @@index([exportedBy])
  @@index([exportedAt])
}

model DemoTenant {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  businessType     BusinessType
  status           DemoTenantStatus @default(AVAILABLE)
  accessEmail      String
  accessPassword   String
  accessUrl        String?
  currentLeadId    String?
  currentLeadName  String?
  sessionStartedAt DateTime?
  sessionExpiresAt DateTime?
  sampleDataConfig String           @default("{}")
  resetAfterUse    Boolean          @default(true)
  lastResetAt      DateTime?
  description      String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([businessType])
  @@index([status])
}

model Business {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  businessType           BusinessType
  status                 BusinessStatus          @default(ONBOARDING)
  // Product Assignment (v1.2.0)
  productCode            String? // FK to PlatformProduct.code (e.g., "COMMERCE", "LAUNDRY")
  productVersion         String? // Product version when business was created
  subscriptionPlanCode   String? // Selected subscription plan (e.g., "STARTER", "PROFESSIONAL")
  enabledFeatures        String                  @default("[]") // JSON array of enabled feature codes
  leadId                 String?
  logo                   String?
  favicon                String?
  primaryColor           String                  @default("#10B981")
  secondaryColor         String?
  darkMode               Boolean                 @default(false)
  tagline                String?
  description            String?
  gstNumber              String?
  panNumber              String?
  cinNumber              String?
  fssaiLicense           String?
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  country                String                  @default("India")
  latitude               Float?
  longitude              Float?
  contactEmail           String?
  contactPhone           String?
  supportEmail           String?
  supportPhone           String?
  defaultCurrency        String                  @default("INR")
  defaultLocale          String                  @default("en-IN")
  timezone               String                  @default("Asia/Kolkata")
  isOnline               Boolean                 @default(false)
  activationChecklist    String                  @default("{}")
  activationProgress     Int                     @default(0)
  activationCompleted    Boolean                 @default(false)
  settings               String                  @default("{}")
  features               String                  @default("{}")
  notificationConfig     String                  @default("{}")
  onboardedAt            DateTime?
  activatedAt            DateTime?
  suspendedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  salesRepId             String?
  businessCode           String?                 @unique
  activityLogs           ActivityLog[]
  salesRep               SalesTeamMember?        @relation("SalesRepClients", fields: [salesRepId], references: [id])
  gatewayAccess          BusinessGatewayAccess[]
  modules                BusinessModule[]
  businessSubscription   BusinessSubscription?
  businessUsers          BusinessUser[]
  businessRoles          BusinessRole[]
  auditLogs              BusinessAuditLog[]
  categories             Category[]
  convertedLeads         Lead[]                  @relation("LeadConversion")
  customers              Customer[]
  customerSubscriptions  CustomerSubscription[]
  deliveryPartners       DeliveryPartner[]
  deliveryZones          DeliveryZone[]
  deployments            Deployment[]
  domain                 DomainMapping?
  featureFlags           FeatureFlag[]
  invoices               Invoice[]
  notifications          Notification[]
  onboardingSteps        OnboardingStep[]
  orders                 Order[]
  posSessions            POSSession[]
  payments               Payment[]
  paymentGateways        PaymentGateway[]
  storePaymentGateways   StorePaymentGateway[]
  products               Product[]
  promoCodes             PromoCode[]
  reviews                Review[]
  stores                 Store[]
  subscriptionPlans      SubscriptionPlan[]
  addons                 Addon[]
  taxConfigs             TaxConfig[]
  workflowRules          WorkflowRule[]
  branding               BusinessBranding?
  appConfig              AppConfig?
  cartItems              CartItem[]
  favorites              Favorite[]
  supportTickets         SupportTicket[]
  workforceSettings      WorkforceSettings?
  partnerAuditLogs       PartnerAudit[]
  notificationSounds     NotificationSound[]
  notificationDevices    NotificationDevice[]
  banners                Banner[]
  refunds                Refund[]
  billingDocuments       BillingDocument[]
  recurringDateOverrides RecurringDateOverride[]
  charges                Charge[]
  billingAccount         BillingAccount?
  fileUploads            FileUpload[]
  razorpayPayments       RazorpayPayment[]

  @@index([businessType])
  @@index([status])
  @@index([salesRepId])
}

model OnboardingStep {
  id          String               @id @default(cuid())
  businessId  String
  stepKey     String
  stepName    String
  status      OnboardingStepStatus @default(PENDING)
  completedBy String?
  completedAt DateTime?
  notes       String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, stepKey])
  @@index([businessId])
  @@index([status])
}

model BusinessModule {
  id         String       @id @default(cuid())
  businessId String
  moduleKey  String
  moduleName String
  version    String       @default("1.0.0")
  status     ModuleStatus @default(DISABLED)
  config     String       @default("{}")
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, moduleKey])
  @@index([businessId])
  @@index([moduleKey])
  @@index([status])
}

model Store {
  id                   String                @id @default(cuid())
  businessId           String
  name                 String
  slug                 String
  code                 String?
  address              String?
  city                 String?
  state                String?
  pincode              String?
  country              String                @default("India")
  latitude             Float?
  longitude            Float?
  phone                String?
  email                String?
  status               StoreStatus           @default(ACTIVE)
  isMainStore          Boolean               @default(false)
  deliveryRadius       Float                 @default(5.0)
  minOrderAmount       Float                 @default(0)
  deliveryFee          Float                 @default(0)
  freeDeliveryAbove    Float?
  maxDeliveryDistance  Float?                @default(10.0)
  preparationTime      Int                   @default(30)
  operatingHours       String                @default("{}")
  posEnabled           Boolean               @default(true)
  printerConfig        String                @default("{}")
  printerType          String?
  paperSize            String                @default("80mm")
  gstNumber            String?
  settings             String                @default("{}")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  storeCode            String?
  staff                BusinessUser[]
  categories           Category[]
  deliveryZones        DeliveryZone[]
  inventory            Inventory[]
  orders               Order[]
  posSessions          POSSession[]
  products             Product[]
  taxConfigs           TaxConfig[]
  workflowRules        WorkflowRule[]
  userAssignments      UserStoreAssignment[]
  storePaymentGateways StorePaymentGateway[]
  deliveryPartners     DeliveryPartner[]
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeTimings         StoreTiming[]
  banners              Banner[]

  @@unique([businessId, slug])
  @@unique([businessId, storeCode])
  @@index([businessId])
  @@index([status])
}

model StoreTiming {
  id        String   @id @default(cuid())
  storeId   String
  day       Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@index([storeId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  loginId             String?              @unique
  phone               String?
  name                String
  avatar              String?
  passwordHash        String?
  hasPassword         Boolean              @default(false)
  mustChangePassword  Boolean              @default(false)
