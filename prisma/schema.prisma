// Internal commission tracking for Quantix sales team.
// One record per saved calculation session.
model CommissionCalculation {
  id              String   @id @default(cuid())

  salesPersonId   String
  salesPersonName String
  month           Int      // 1–12
  year            Int

  // JSON: Array<{ type, qty, totalValue, commPct, perSaleCommission, totalCommission }>
  lineItems       String

  totalQty        Int
  totalValue      Float
  qualifiedSlab   Float    // 25 | 35 | 45
  totalCommission Float

  notes             String?

  // "signup" | "renewal" — separates the two calculator types in history
  calcType          String   @default("signup")
  // "RELEASE" | "HOLD" — renewal eligibility at save time (null for signup records)
  eligibilityStatus String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([salesPersonId])
  @@index([year, month])
  @@index([calcType])
}

