// ============================================================================
// HRMS — Human Resource Management System (Phase 1)
// Isolated module — businessId fields reference Business.id by convention
// but without Prisma @relation to avoid modifying the existing Business model.
// All HRMS data is scoped to hrmsBusinessId = Quantix Technology's Business.id
// (multi-tenant ready for future expansion).
// ============================================================================

enum EmploymentType {
  PERMANENT
  CONTRACT
  COMMISSION_BASED
  CONSULTANT
  INTERN
}

enum EmployeeStatus {
  PROSPECT
  OFFERED
  JOINED
  ACTIVE
  RESIGNED
  TERMINATED
}

enum CommissionSlipStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PAID
}

enum OfferLetterStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PayrollType {
  SALARY
  COMMISSION
  HYBRID
}

