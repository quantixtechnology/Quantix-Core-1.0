  startDate   DateTime         @default(now())
  endDate     DateTime?
  invoicedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([billingType])
}

model InvoiceSequence {
  financialYear String   @id
  nextVal       Int      @default(1)
  updatedAt     DateTime @updatedAt
}

model SubscriptionPaymentAuditLog {
  id                     String   @id @default(cuid())
  billingRecordId        String?
  businessSubscriptionId String?
  businessId             String?
  businessName           String?
  userId                 String?
  userName               String?
  action                 String
  oldStatus              String?
  newStatus              String?
  amount                 Float?
  referenceNumber        String?
  attachmentUrl          String?
  notes                  String?
  metadata               String   @default("{}")
  createdAt              DateTime @default(now())

  @@index([billingRecordId])
  @@index([businessSubscriptionId])
  @@index([businessId])
  @@index([createdAt])
}

model SubscriptionPlan {
  id                 String                   @id @default(cuid())
  businessId         String
  name               String
  slug               String
  description        String?
  serviceType        SubscriptionServiceType
  billingCycle       SubscriptionBillingCycle
  price              Float
  originalPrice      Float?
  setupFee           Float                    @default(0)
  totalCredits       Int                      @default(0)
  creditLabel        String?
  image              String? // tenant marketing image (upload URL)
  // Laundry cloth-allowance plans: how the allowance is consumed and how many
  // orders/pickups it may be spread across per billing cycle. Nullable/additive
  // — legacy plans keep prior behaviour (null maxOrders = unlimited orders).
  allowanceType      String? // e.g. CLOTH_ALLOWANCE | KG_ALLOWANCE
  maxOrdersPerCycle  Int? // max orders the allowance covers per cycle
  // ── Laundry KG/Piece allowance plan (additive; null on legacy credit plans) ──
  // A plan may grant a weight allowance, a piece allowance, or BOTH at once.
  allowanceKg        Float? // KG covered per billing cycle (null = none)
  allowancePieces    Int? // pieces covered per billing cycle (null = none)
  autoRenew          Boolean                  @default(false) // auto-renew at cycle end
  graceDays          Int                      @default(0) // grace window after expiry
  validityDays       Int? // explicit validity (null = derived from billingCycle)
  coverageRules      SubscriptionPlanCoverage[]
  features           String                   @default("[]")
  isFeatured         Boolean                  @default(false)
  maxSubscribers     Int?
  currentSubscribers Int                      @default(0)
  isActive           Boolean                  @default(true)
  sortOrder          Int                      @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  subscriptions      CustomerSubscription[]
  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planItems          SubscriptionPlanItem[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([isActive])
}

model SubscriptionPlanItem {
  id              String           @id @default(cuid())
  planId          String
  productId       String?
  serviceName     String?
  creditsPerCycle Int              @default(1)
  maxPerUse       Int              @default(1)
  rollover        Boolean          @default(false)
  rolloverMax     Int              @default(0)
  createdAt       DateTime         @default(now())
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model CustomerSubscription {
  id                 String                     @id @default(cuid())
  businessId         String
  customerId         String
  planId             String
  status             CustomerSubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime
  totalCredits       Int                        @default(0)
  usedCredits        Int                        @default(0)
  remainingCredits   Int                        @default(0)
  // ── Laundry KG/Piece allowance balances (additive; ledger is authoritative) ──
  allowanceKg        Float                      @default(0) // KG granted this cycle
  usedKg             Float                      @default(0)
  remainingKg        Float                      @default(0)
  allowancePieces    Int                        @default(0) // pieces granted this cycle
  usedPieces         Int                        @default(0)
  remainingPieces    Int                        @default(0)
  graceEndsAt        DateTime? // end of grace window (set when a cycle lapses)
  ledger             SubscriptionLedgerEntry[]
  autoRenew          Boolean                    @default(true)
  cancelledAt        DateTime?
  cancelAtPeriodEnd  Boolean                    @default(false)
  pauseStartAt       DateTime?
  pauseEndAt         DateTime?
  paymentMethodId    String?
  lastPaymentAt      DateTime?
  lastPaymentAmount  Float?
  metadata           String                     @default("{}")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  plan               SubscriptionPlan           @relation(fields: [planId], references: [id])
  customer           Customer                   @relation(fields: [customerId], references: [id])
  business           Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders             Order[]
  usages             SubscriptionUsage[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
}

model SubscriptionUsage {
  id             String               @id @default(cuid())
  subscriptionId String
  orderId        String?
  creditsUsed    Int                  @default(1)
  description    String?
  createdAt      DateTime             @default(now())
  subscription   CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([createdAt])
}

// Per-plan eligibility + allowance rule (Parts 3/4/5). A row makes a SERVICE
// eligible; garmentId=null covers every garment in that service, a specific
// garmentId scopes the rule to one garment. allowanceMode says whether that
// garment consumes the KG allowance or the PIECE allowance. Additive — plans
// with no coverage rows behave like legacy credit plans.
model SubscriptionPlanCoverage {
  id            String           @id @default(cuid())
  planId        String
  serviceId     String
  garmentId     String? // null = all garments in the service
  allowanceMode String           @default("PER_PIECE") // PER_KG | PER_PIECE
  createdAt     DateTime         @default(now())
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceId, garmentId])
  @@index([planId])
  @@index([serviceId])
}

// Append-only allowance ledger (Part 8). Every movement of a subscription's
// KG/Piece balance is a row; nothing is ever overwritten. balanceAfter is the
// remaining balance in that unit immediately after the entry. entryType:
// OPENING | CONSUMPTION | ADJUSTMENT | RENEWAL | EXPIRY | MANUAL_ADJUSTMENT | CLOSING.
model SubscriptionLedgerEntry {
  id             String               @id @default(cuid())
  subscriptionId String
  businessId     String
  entryType      String
  unit           String // KG | PIECE
  delta          Float // signed movement (+grant / -consume)
  balanceAfter   Float // remaining balance in this unit after the entry
  orderId        String?
  orderItemId    String?
  note           String?
  actorName      String?
  createdAt      DateTime             @default(now())
  subscription   CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([businessId])
  @@index([orderId])
  @@index([entryType])
}

// A customer's PURCHASE of a SubscriptionPlan — the paid commercial transaction
// that precedes activation. This reuses the shared Customer + payment provider
// (PaymentGateway / Razorpay); it is NOT a separate checkout engine. The plan is
// activated (CustomerSubscription) ONLY after the payment is verified — the
// status machine below enforces that. Scalar FKs (no relations) keep this fully
// additive to the existing Customer/Business/Plan/Subscription models.
// status:        INITIATED | PAYMENT_PENDING | PAID | ACTIVATED | FAILED
// paymentStatus: PENDING | PROCESSING | COMPLETED | FAILED  (reuses platform names)
model SubscriptionPurchase {
  id                     String    @id @default(cuid())
  businessId             String
  customerId             String
  planId                 String
  amount                 Float
  amountPaid             Float     @default(0) // supports partial settlement
  currency               String    @default("INR")
  status                 String    @default("INITIATED")
  paymentStatus          String    @default("PENDING")
  paymentMethod          String?
  gateway                String?
  paymentReference       String? // gateway order id / provider reference
  paymentTransactionId   String? // gateway payment id after verification
  // A subscription can be purchased in the SAME cart as a laundry order and its
  // due collected together at Payment Collection. This links the pending
  // purchase to that order (nullable — a standalone online purchase has none).
  laundryOrderId         String?
  customerSubscriptionId String? // set once activated (only after PAID)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  paidAt                 DateTime?

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([laundryOrderId])
}

model Customer {
  id                       String                 @id @default(cuid())
  businessId               String
  userId                   String?
  name                     String
  email                    String?
  phone                    String?
  avatar                   String?
  gstNumber                String?
  dateOfBirth              DateTime?
  gender                   String?
  loyaltyTier              String                 @default("BRONZE")
  notes                    String                 @default("")
  loyaltyPoints            Int                    @default(0)
  totalOrders              Int                    @default(0)
  totalSpent               Float                  @default(0)
  avgOrderValue            Float                  @default(0)
  lastOrderAt              DateTime?
  tags                     String                 @default("[]")
  metadata                 String                 @default("{}")
  isActive                 Boolean                @default(true)
  status                   String                 @default("ACTIVE")
  source                   String                 @default("MANUAL")
  isGuest                  Boolean                @default(false)
  verified                 Boolean                @default(false)
  customerCode             String?
  createdStoreId           String?
  preferredStoreId         String?
  emailVerified            Boolean                @default(false)
  phoneVerified            Boolean                @default(false)
  walletBalance            Float                  @default(0)
  accountType              String                 @default("RETAIL")
  creditLimit              Float                  @default(0)
  outstandingBalance       Float                  @default(0)
  lastLoginAt              DateTime?
  // ── Customer-owned credentials (isolated from BusinessUser/Staff system) ──
  passwordHash             String?
  isPasswordSet            Boolean                @default(false)
  passwordCreatedAt        DateTime?
  passwordUpdatedAt        DateTime?
  passwordResetToken       String?                @unique
  passwordResetTokenExpiry DateTime?
  lastPasswordResetAt      DateTime?
  mustChangePassword       Boolean                @default(false)
  failedLoginAttempts      Int                    @default(0)
  accountLockedUntil       DateTime?
  isLoginDisabled          Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  addresses                Address[]
  user                     User?                  @relation(fields: [userId], references: [id])
  business                 Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerNotes            CustomerNote[]
  activities               CustomerActivity[]
  documents                CustomerDocument[]
  subscriptions            CustomerSubscription[]
  invoices                 Invoice[]
  orders                   Order[]
  cartItems                CartItem[]
  favorites                Favorite[]
  reviews                  Review[]
  supportTickets           SupportTicket[]

  @@unique([businessId, phone])
  @@unique([businessId, customerCode])
  @@index([businessId])
  @@index([userId])
  @@index([phone])
  @@index([status])
  @@index([businessId, email])
  @@index([passwordResetToken])
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  // Additive customer-management fields: address kind + pickup/delivery
  // defaults. Legacy rows default to HOME and false (backward compatible).
  addressType  String   @default("HOME") // HOME | OFFICE | OTHER
  isPickupDefault   Boolean @default(false)
  isDeliveryDefault Boolean @default(false)
  area         String?
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  latitude     Float?
  longitude    Float?
  gpsAccuracy  Float?
  isDefault    Boolean  @default(false)
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// Customer timeline entries created by Laundry OS admin (notes, internal
// communication log, manual adjustments, tag changes, merges). Laundry-scoped
// (actorName string, no BusinessUser/User FK) so it never couples to the
// platform auth system. Part of the Customer Management module.
model CustomerActivity {
  id         String   @id @default(cuid())
  businessId String // platform Business id (customer scope)
  customerId String
  type       String // NOTE | COMMUNICATION | ADJUSTMENT | TAG | MERGE | SYSTEM
  title      String
  body       String?
  meta       String   @default("{}") // JSON detail
  actorName  String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([businessId])
  @@index([type])
}

// ── Laundry OS RBAC (module→screen→action). Self-contained, per-business.
// Independent of the platform auth roles; the frozen stage-permission
// LaundryRole/LaundryStagePermission models are untouched. All additive.
model LaundryAccessRole {
  id          String   @id @default(cuid())
  businessId  String // platform Business id (tenant scope)
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false) // seeded default role
  isOwner     Boolean  @default(false) // full-access owner role (protected)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions LaundryAccessPermission[]
  assignments LaundryAccessAssignment[]

  @@unique([businessId, code])
  @@index([businessId])
}

// Normalized permission matrix: one row per (role, permission key). effect
// ALLOW | DENY (DENY overrides ALLOW during resolution). Absent = no access.
model LaundryAccessPermission {
  id      String            @id @default(cuid())
  roleId  String
  permKey String
  effect  String            @default("ALLOW") // ALLOW | DENY
  role    LaundryAccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permKey])
  @@index([roleId])
}

// Employee → role. One active role per user today (future: multiple).
model LaundryAccessAssignment {
  id         String            @id @default(cuid())
  businessId String
  userId     String // platform User id
  roleId     String
  storeId    String? // optional LaundryStore scope for this employee (no FK; resolved by query)
  active     Boolean           @default(true)
  assignedBy String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  role       LaundryAccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([roleId])
}

// Append-only RBAC audit trail (role/permission/assignment changes).
model LaundryAccessAudit {
  id           String   @id @default(cuid())
  businessId   String
  action       String // ROLE_CREATED | ROLE_EDITED | ROLE_DELETED | ROLE_CLONED | PERMISSIONS_CHANGED | ROLE_ASSIGNED | ROLE_REMOVED
  roleId       String?
  targetUserId String?
  actorName    String?
  detail       String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([roleId])
}

// Optional customer documents (ID proof, GST, business docs). Additive.
model CustomerDocument {
