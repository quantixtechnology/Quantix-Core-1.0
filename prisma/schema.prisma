// ============================================================================
// Quantix Technology — Managed White-Label Multi-Tenant SaaS Platform
// "Run Your Business Smarter"
// www.quantixtechnology.in
//
// ARCHITECTURE PRINCIPLE:
// This is a MANAGED platform. Customers CANNOT self-signup or create businesses.
// ONLY Quantix Super Admin creates, configures, and deploys businesses.
// Clients receive login access AFTER deployment.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PLATFORM LEVEL — Quantix Internal
// ============================================================================

model Platform {
  id                String   @id @default(cuid())
  companyName       String   @default("Quantix Technology")
  tagline           String   @default("Run Your Business Smarter")
  website           String   @default("www.quantixtechnology.in")
  supportEmail      String?
  supportPhone      String?
  defaultCurrency   String   @default("INR")
  defaultLocale     String   @default("en-IN")
  defaultTimezone   String   @default("Asia/Kolkata")
  maintenanceMode   Boolean  @default(false)
  version           String   @default("2.0.0")
  hostingProvider   String   @default("replit") // replit, vercel, aws, digitalocean
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businesses        Business[]
  salesTeam         SalesTeamMember[]
  platformPlans     PlatformPlan[]
  domains           DomainMapping[]
  deployments       Deployment[]
  leads             Lead[]
}

// ============================================================================
// SALES TEAM — Quantix Internal Sales
// ============================================================================

model SalesTeamMember {
  id          String   @id @default(cuid())
  platformId  String   @default("platform_1")
  userId      String   @unique
  name        String
  email       String
  phone       String
  avatar      String?
  target      Float    @default(0)  // Monthly target in INR
  achieved    Float    @default(0)
  region      String?  // Assigned region/territory
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platform    Platform @relation(fields: [platformId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  leads       Lead[]
  clients     Business[]  @relation("SalesRepClients")
}

model Lead {
  id              String        @id @default(cuid())
  platformId      String        @default("platform_1")
  salesRepId      String?
  businessName    String
  contactName     String
  contactEmail    String
  contactPhone    String
  businessType    BusinessType
  source          LeadSource    @default(META_ADS)
  status          LeadStatus    @default(NEW)
  notes           String?
  followUpDate    DateTime?
  estimatedValue  Float?
  convertedBusinessId String?
  tags            String        @default("[]")
  lastContactedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  platform        Platform      @relation(fields: [platformId], references: [id])
  salesRep        SalesTeamMember? @relation(fields: [salesRepId], references: [id])

  @@index([salesRepId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

// ============================================================================
// PLATFORM SUBSCRIPTION PLANS — Defined by Quantix Only
// ============================================================================

enum PlanTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

model PlatformPlan {
  id              String    @id @default(cuid())
  platformId      String    @default("platform_1")
  name            String
  tier            PlanTier
  monthlyPrice    Float
  yearlyPrice     Float
  description     String?
  features        String    @default("[]")  // JSON: included features/modules
  maxStores       Int       @default(1)
  maxProducts     Int       @default(500)
  maxOrders       Int       @default(1000)  // per month
  maxDeliveryPartners Int   @default(5)
  maxStaff        Int       @default(10)
  hasPOS          Boolean   @default(true)
  hasDelivery     Boolean   @default(true)
  hasSubscription Boolean   @default(false)
  hasCustomDomain Boolean   @default(false)
  hasWhiteLabel   Boolean   @default(false)
  hasAdvancedReports Boolean @default(false)
  hasAPIAccess    Boolean   @default(false)
  isActive        Boolean   @default(true)
  isPublic        Boolean   @default(true)  // Visible on pricing page?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  platform        Platform  @relation(fields: [platformId], references: [id])
  subscriptions   BusinessSubscription[]

  @@index([platformId])
  @@index([isActive])
}

// ============================================================================
// BUSINESS (TENANT) — Created ONLY by Quantix Super Admin
// ============================================================================

enum BusinessType {
  GROCERY
  FOOD_DELIVERY
  LAUNDRY
  CAR_WASH
  PHARMACY
  HOME_SERVICES
  ECOMMERCE
  COSMETICS
  MEAT_DELIVERY
  FURNITURE
  DIRECTORY
}

enum BusinessStatus {
  ONBOARDING     // Being set up by Quantix
  TRIAL          // Trial period
  ACTIVE         // Live and operational
  SUSPENDED      // Payment failure / policy violation
  CHURNED        // Cancelled / left
}

model Business {
  id                String         @id @default(cuid())
  platformId        String         @default("platform_1")
  salesRepId        String?        // Quantix sales rep who closed this client
  name              String
  slug              String         @unique
  businessType      BusinessType
  status            BusinessStatus @default(ONBOARDING)
  // Branding (configured by Quantix)
  logo              String?
  favicon           String?
  primaryColor      String         @default("#10B981")
  secondaryColor    String?
  darkMode          Boolean        @default(false)
  // Business details
  tagline           String?
  description       String?
  gstNumber         String?
  panNumber         String?
  cinNumber         String?
  fssaiLicense      String?        // For food businesses
  // Address
  address           String?
  city              String?
  state             String?
  pincode           String?
  country           String         @default("India")
  latitude          Float?
  longitude         Float?
  // Contact
  contactEmail      String?
  contactPhone      String?
  supportEmail      String?
  supportPhone      String?
  // Configuration
  defaultCurrency   String         @default("INR")
  defaultLocale     String         @default("en-IN")
  timezone          String         @default("Asia/Kolkata")
  isOnline          Boolean        @default(true)  // Business online/offline toggle
  // JSON configuration blobs
  settings          String         @default("{}")
  features          String         @default("{}")  // Feature flags: which modules enabled
  notificationConfig String        @default("{}")
  // Timestamps
  onboardedAt       DateTime?      // When Quantix completed setup
  trialStartsAt     DateTime?
  trialEndsAt       DateTime?
  activatedAt       DateTime?
  suspendedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  platform          Platform       @relation(fields: [platformId], references: [id])
  salesRep          SalesTeamMember? @relation("SalesRepClients", fields: [salesRepId], references: [id])
  businessUsers     BusinessUser[]
  stores            Store[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  orders            Order[]
  deliveryZones     DeliveryZone[]
  deliveryPartners  DeliveryPartner[]
  subscriptionPlans SubscriptionPlan[]   // Business's own subscription packages (car wash plans etc.)
  customerSubscriptions CustomerSubscription[]
  taxConfigs        TaxConfig[]
  paymentGateways   PaymentGateway[]
  invoices          Invoice[]
  posSessions       POSSession[]
  promoCodes        PromoCode[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  businessSubscription BusinessSubscription?
  domain            DomainMapping?
  deployments       Deployment[]

  @@index([platformId])
  @@index([businessType])
  @@index([status])
  @@index([salesRepId])
}

// ============================================================================
// BUSINESS SUBSCRIPTION — Quantix controls pricing
// ============================================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
  PAUSED
}

model BusinessSubscription {
  id                  String             @id @default(cuid())
  businessId          String             @unique
  planId              String
  status              SubscriptionStatus @default(TRIAL)
  // Pricing — supports manual override by Super Admin
  planPrice           Float              // The standard plan price
  customPrice         Float?             // Super Admin override
  discountPercentage  Float?             // Discount applied
  manualPriceOverride Boolean            @default(false)
  overrideReason      String?
  // Billing cycle
  billingCycle        String             @default("monthly") // monthly, yearly
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  nextBillingDate     DateTime
  // Trial
  trialStart          DateTime?
  trialEnd            DateTime?
  trialExtensionDays  Int                @default(0)
  // Pause
  pausedAt            DateTime?
  pauseReason         String?
  resumeAt            DateTime?
  // Payment
  lastPaymentDate     DateTime?
  lastPaymentAmount   Float?
  nextPaymentAmount   Float?
  paymentMethod       String?            // razorpay, stripe, bank_transfer, cash
  // Auto
  autoRenew           Boolean            @default(true)
  cancelledAt         DateTime?
  cancelReason        String?
  // Metadata
  notes               String?            // Internal Quantix notes
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                PlatformPlan       @relation(fields: [planId], references: [id])
  billingHistory      BillingRecord[]

  @@index([businessId])
  @@index([status])
  @@index([nextBillingDate])
}

model BillingRecord {
  id                    String   @id @default(cuid())
  businessSubscriptionId String
  amount                Float
  currency              String   @default("INR")
  status                String   @default("pending") // pending, paid, failed, refunded
  invoiceNumber         String?
  paymentGateway        String?
  gatewayTransactionId  String?
  dueDate               DateTime
  paidDate              DateTime?
  description           String?
  createdAt             DateTime @default(now())

  subscription          BusinessSubscription @relation(fields: [businessSubscriptionId], references: [id], onDelete: Cascade)

  @@index([businessSubscriptionId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================================
// DOMAIN MAPPING — Quantix manages DNS/SSL
// ============================================================================

enum DomainStatus {
  PENDING_DNS     // DNS not configured yet
  DNS_PROPAGATING // DNS configured, waiting for propagation
  SSL_PENDING     // DNS resolved, SSL being provisioned
  ACTIVE          // Live with HTTPS
  ERROR           // Configuration error
}

model DomainMapping {
  id              String       @id @default(cuid())
  platformId      String       @default("platform_1")
  businessId      String       @unique
  domain          String       // e.g., shop.example.com or www.clientbusiness.in
  subdomain       String?      // e.g., "shop" if using quantix subdomain
  isPrimary       Boolean      @default(true)
  sslStatus       String       @default("pending") // pending, active, expired, error
  sslExpiryDate   DateTime?
  dnsProvider     String?      // cloudflare, route53, godaddy, etc.
  dnsConfig       String       @default("{}") // JSON: DNS records configured
  status          DomainStatus @default(PENDING_DNS)
  configuredBy    String?      // Quantix admin who set it up
  configuredAt    DateTime?
  deployedAt      DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  platform        Platform     @relation(fields: [platformId], references: [id])
  business        Business     @relation(fields: [businessId], references: [id])

  @@unique([domain])
  @@index([businessId])
  @@index([status])
}

// ============================================================================
// DEPLOYMENT — Quantix manages deployments
// ============================================================================

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYING
  LIVE
  FAILED
  MAINTENANCE
}

enum DeploymentType {
  WEBSITE
  ADMIN_DASHBOARD
  CUSTOMER_APP
  DELIVERY_APP
  ADMIN_APP
}

model Deployment {
  id              String           @id @default(cuid())
  platformId      String           @default("platform_1")
  businessId      String
  type            DeploymentType
  status          DeploymentStatus @default(PENDING)
  environment     String           @default("production") // production, staging
  hostingProvider String           @default("replit") // replit, vercel, aws, digitalocean
  hostingConfig   String           @default("{}") // JSON: deployment-specific config
  buildUrl        String?
  liveUrl         String?
  version         String?
  deployedBy      String?          // Quantix admin
  deployedAt      DateTime?
  lastCheckedAt   DateTime?
  healthStatus    String           @default("unknown") // healthy, degraded, down, unknown
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  platform        Platform         @relation(fields: [platformId], references: [id])
  business        Business         @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([type])
  @@index([status])
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

enum AuthProvider {
  EMAIL_OTP
  WHATSAPP_OTP
  PUSH_NOTIFICATION
  GOOGLE
  PASSWORD
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  phone           String?
  name            String
  avatar          String?
  passwordHash    String?
  authProvider    AuthProvider  @default(EMAIL_OTP)
  emailVerified   Boolean      @default(false)
  phoneVerified   Boolean      @default(false)
  isActive        Boolean      @default(true)
  fcmToken        String?      // Push notification token
  lastLoginAt     DateTime?
  metadata        String       @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  businessUsers   BusinessUser[]
  customerProfiles Customer[]
  deliveryProfiles DeliveryPartner[]
  otpCodes        OTPCode[]
  refreshTokens   RefreshToken[]
  activityLogs    ActivityLog[]
  salesProfile    SalesTeamMember?
}

model OTPCode {
  id          String       @id @default(cuid())
  userId      String?
  email       String?
  phone       String?
  code        String       // 6-digit OTP
  channel     AuthProvider // EMAIL_OTP, WHATSAPP_OTP, PUSH_NOTIFICATION
  isVerified  Boolean      @default(false)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([code])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ============================================================================
// ROLES & PERMISSIONS
// ============================================================================

enum Role {
  QUANTIX_SUPER_ADMIN   // Full platform access
  QUANTIX_SALES_TEAM    // Sales & lead management
  CLIENT_OWNER          // Business owner (client)
  STORE_MANAGER         // Store operations
  DELIVERY_STAFF        // Delivery driver
  CUSTOMER              // End customer
}

model BusinessUser {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       Role
  storeId    String?
  isActive   Boolean  @default(true)
  invitedAt  DateTime?
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store      Store?   @relation(fields: [storeId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([role])
}

// ============================================================================
// STORE (Multi-Store Support)
// ============================================================================

enum StoreStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Store {
  id              String       @id @default(cuid())
  businessId      String
  name            String
  slug            String
  code            String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  country         String       @default("India")
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  status          StoreStatus  @default(ACTIVE)
  isMainStore     Boolean      @default(false)
  deliveryRadius  Float        @default(5.0)  // km — used with Haversine
  minOrderAmount  Float        @default(0)
  deliveryFee     Float        @default(0)
  freeDeliveryAbove Float?
  preparationTime Int          @default(30)   // minutes
  operatingHours  String       @default("{}") // JSON: {mon: {open: "09:00", close: "22:00"}}
  gstNumber       String?
  // POS & Printer config
  printerConfig   String       @default("{}") // JSON: thermal printer settings
  printerType     String?      // thermal_bluetooth, thermal_usb, laser
  paperSize       String       @default("80mm") // 58mm, 80mm, A4
  posEnabled      Boolean      @default(true)
  settings        String       @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory       Inventory[]
  orders          Order[]
  posSessions     POSSession[]
  staff           BusinessUser[]
  storeTimings    StoreTiming[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([slug])
  @@index([status])
}

model StoreTiming {
  id        String   @id @default(cuid())
  storeId   String
  day       Int      // 0=Sunday ... 6=Saturday
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@index([storeId])
}

// ============================================================================
// CATALOG — Categories & Products
// ============================================================================

model Category {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  slug        String
  description String?
  image       String?
  icon        String?
  parentId    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([parentId])
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
  SUBSCRIPTION
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id              String        @id @default(cuid())
  businessId      String
  storeId         String?
  categoryId      String?
  name            String
  slug            String
  description     String?
  shortDesc       String?
  type            ProductType   @default(PHYSICAL)
  status          ProductStatus @default(ACTIVE)
  sku             String?
  barcode         String?
  images          String        @default("[]")
  unit            String?
  unitQuantity    Float?
  isVeg           Boolean?
  isFeatured      Boolean       @default(false)
  isPopular       Boolean       @default(false)
  preparationTime Int?
  minOrderQty     Float         @default(1)
  maxOrderQty     Float         @default(100)
  tags            String        @default("[]")
  nutritionInfo   String?
  allergenInfo    String?
  sortOrder       Int           @default(0)
  metadata        String        @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  inventory       Inventory[]
  orderItems      OrderItem[]
  subscriptionPlanItems SubscriptionPlanItem[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([storeId])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  sku             String?
  barcode         String?
  price           Float
  mrp             Float
  costPrice       Float?
  discountPrice   Float?
  discountPercent Float?
  stock           Int      @default(0)
  minStock        Int      @default(0)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  attributes      String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       Inventory[]
  orderItems      OrderItem[]

  @@index([productId])
  @@index([isActive])
}

// ============================================================================
// INVENTORY
// ============================================================================

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

model Inventory {
  id             String          @id @default(cuid())
  businessId     String
  storeId        String
  productId      String
  variantId      String?
  quantity       Int             @default(0)
  reservedQty    Int             @default(0)
  minStock       Int             @default(5)
  maxStock       Int             @default(1000)
  status         InventoryStatus @default(IN_STOCK)
  lastRestockedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  logs           InventoryLog[]

  @@unique([storeId, productId, variantId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
}

model InventoryLog {
  id          String   @id @default(cuid())
  inventoryId String
  action      String   // RESTOCK, ORDER_RESERVED, ORDER_FULFILLED, ADJUSTMENT, RETURN
  quantity    Int
  previousQty Int
  newQty      Int
  note        String?
  performedBy String?
  createdAt   DateTime @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
}

// ============================================================================
// CUSTOMER
// ============================================================================

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  userId        String?
  name          String
  email         String?
  phone         String?
  avatar        String?
  gstNumber     String?
  loyaltyPoints Int      @default(0)
  totalOrders   Int      @default(0)
  totalSpent    Float    @default(0)
  avgOrderValue Float    @default(0)
  lastOrderAt   DateTime?
  tags          String   @default("[]")
  metadata      String   @default("{}")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])
  addresses     Address[]
  orders        Order[]
  subscriptions CustomerSubscription[]
  invoices      Invoice[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([userId])
  @@index([phone])
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  landmark     String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ============================================================================
// DELIVERY ZONES & PARTNERS
// ============================================================================

enum ZoneType {
  CIRCLE
  POLYGON
  PINCODE
}

model DeliveryZone {
  id              String    @id @default(cuid())
  businessId      String
  storeId         String?
  name            String
  zoneType        ZoneType
  centerLat       Float?
  centerLng       Float?
  radius          Float?
  polygon         String?
  pincodes        String?
  deliveryFee     Float     @default(0)
  minOrderAmount  Float     @default(0)
  freeDeliveryAbove Float?
  estimatedTime   Int       @default(30)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([storeId])
}

model DeliveryPartner {
  id              String   @id @default(cuid())
  businessId      String
  userId          String?
  name            String
  phone           String
  email           String?
  avatar          String?
  vehicleType     String?
  vehicleNumber   String?
  licenseNumber   String?
  isOnline        Boolean  @default(false)
  isActive        Boolean  @default(true)
  currentLat      Float?
  currentLng      Float?
  rating          Float    @default(0)
  totalDeliveries Int      @default(0)
  totalEarnings   Float    @default(0)
  fcmToken        String?
  bankAccount     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id])
  deliveries      Delivery[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([isOnline])
}

// ============================================================================
// ORDER MANAGEMENT
// ============================================================================

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
  POS
  SUBSCRIPTION
  PICKUP_AND_DELIVERY  // For Laundry etc.
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  SCHEDULED
  // Pickup & Delivery specific
  PICKUP_ASSIGNED
  PICKED_UP
  PROCESSING
  READY_FOR_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NETBANKING
  WALLET
  COD
  CREDIT
}

model Order {
  id              String        @id @default(cuid())
  businessId      String
  storeId         String
  orderNumber     String
  orderType       OrderType
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  // Customer info
  customerId      String?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  // Delivery
  deliveryAddressId String?
  deliveryAddress  String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryInstructions String?
  scheduledAt     DateTime?
  // Pickup (Laundry etc.)
  pickupAddress   String?       // JSON snapshot
  pickupScheduledAt DateTime?
  pickupCompletedAt DateTime?
  // Billing
  subtotal        Float         @default(0)
  totalDiscount   Float         @default(0)
  totalTax        Float         @default(0)
  deliveryFee     Float         @default(0)
  packagingFee    Float         @default(0)
  convenienceFee  Float         @default(0)
  tip             Float         @default(0)
  roundOff        Float         @default(0)
  totalAmount     Float         @default(0)
  // GST
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  cessAmount      Float         @default(0)
  // POS
  posSessionId    String?
  posOperatorId   String?
  tableNumber     String?
  // Subscription
  subscriptionId  String?
  // Promo
  promoCodeId     String?
  // Pickup & Delivery specific
  pickupPartnerId String?
  deliveryPartnerId String?
  deliveryOtp     String?
  pickupOtp       String?
  // Metadata
  notes           String?
  cancelReason    String?
  metadata        String        @default("{}")
  confirmedAt     DateTime?
  preparedAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store           Store         @relation(fields: [storeId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  delivery        Delivery?
  invoice         Invoice?
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  posSession      POSSession?   @relation(fields: [posSessionId], references: [id])
  customerSubscription CustomerSubscription? @relation(fields: [subscriptionId], references: [id])
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id])

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderType])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  variantId           String?
  productName         String
  variantName         String?
  sku                 String?
  quantity            Float
  unitPrice           Float
  mrp                 Float?
  discountPrice       Float?
  discountPercent     Float?
  totalPrice          Float
  totalMrp            Float?
  gstRate             Float    @default(0)
  gstAmount           Float    @default(0)
  cgstAmount          Float    @default(0)
  sgstAmount          Float    @default(0)
  igstAmount          Float    @default(0)
  specialInstructions String?
  customizations      String?
  isVeg               Boolean?
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])
  variant             ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ============================================================================
// DELIVERY TRACKING
// ============================================================================

enum DeliveryStatus {
  ASSIGNING
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
}

model Delivery {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  deliveryPartnerId   String?
  pickupPartnerId     String?        // Separate pickup partner (Laundry)
  status              DeliveryStatus @default(ASSIGNING)
  pickupLat           Float?
  pickupLng           Float?
  pickupAddress       String?
  dropLat             Float?
  dropLng             Float?
  dropAddress         String?
  estimatedPickupTime DateTime?
  estimatedDeliveryTime DateTime?
  actualPickupTime    DateTime?
  actualDeliveryTime  DateTime?
  distance            Float?
  deliveryOtp         String?
  pickupOtp           String?
  rating              Int?
  feedback            String?
  cancelReason        String?
  liveTracking        String         @default("[]")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner     DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])

  @@index([deliveryPartnerId])
  @@index([status])
}

// ============================================================================
// SUBSCRIPTION SERVICE ENGINE — Car Wash, Home Services etc.
// ============================================================================

enum SubscriptionServiceType {
  CAR_WASH
  HOME_SERVICE
  LAUNDRY
  GROCERY
  CUSTOM
}

enum SubscriptionBillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum CustomerSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  TRIAL
}

model SubscriptionPlan {
  id                String                 @id @default(cuid())
  businessId        String
  name              String
  slug              String
  description       String?
  serviceType       SubscriptionServiceType
  billingCycle      SubscriptionBillingCycle
  price             Float
  originalPrice     Float?
  setupFee          Float                  @default(0)
  trialDays         Int                    @default(0)
  totalCredits      Int                    @default(0)
  creditLabel       String?                // "washes", "pickups", "sessions"
  features          String                 @default("[]")
  isFeatured        Boolean                @default(false)
  maxSubscribers    Int?
  currentSubscribers Int                   @default(0)
  isActive          Boolean                @default(true)
  sortOrder         Int                    @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planItems         SubscriptionPlanItem[]
  subscriptions     CustomerSubscription[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([isActive])
}

model SubscriptionPlanItem {
  id              String            @id @default(cuid())
  planId          String
  productId       String?
  serviceName     String?
  creditsPerCycle Int               @default(1)
  maxPerUse       Int               @default(1)
  rollover        Boolean           @default(false)
  rolloverMax     Int               @default(0)
  createdAt       DateTime          @default(now())

  plan            SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  product         Product?          @relation(fields: [productId], references: [id])

  @@index([planId])
}

model CustomerSubscription {
  id                String                   @id @default(cuid())
  businessId        String
  customerId        String
  planId            String
  status            CustomerSubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime
  totalCredits      Int                      @default(0)
  usedCredits       Int                      @default(0)
  remainingCredits  Int                      @default(0)
  autoRenew         Boolean                  @default(true)
  cancelledAt       DateTime?
  cancelAtPeriodEnd Boolean                  @default(false)
  pauseStartAt      DateTime?
  pauseEndAt        DateTime?
  paymentMethodId   String?
  lastPaymentAt     DateTime?
  lastPaymentAmount Float?
  metadata          String                   @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer          Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan         @relation(fields: [planId], references: [id])
  usages            SubscriptionUsage[]
  orders            Order[]
  invoices          Invoice[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionUsage {
  id               String              @id @default(cuid())
  subscriptionId   String
  orderId          String?
  creditsUsed      Int                 @default(1)
  description      String?
  usedAt           DateTime            @default(now())

  subscription     CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([usedAt])
}

// ============================================================================
// POS SYSTEM
// ============================================================================

enum POSSessionStatus {
  OPEN
  CLOSED
  SUSPENDED
}

model POSSession {
  id              String           @id @default(cuid())
  businessId      String
  storeId         String
  operatorId      String
  sessionNumber   String
  status          POSSessionStatus @default(OPEN)
  openingBalance  Float            @default(0)
  closingBalance  Float?
  totalSales      Float            @default(0)
  totalCash       Float            @default(0)
  totalCard       Float            @default(0)
  totalUpi        Float            @default(0)
  totalRefunds    Float            @default(0)
  totalOrders     Int              @default(0)
  cashDrawer      String           @default("{}")
  printerQueue    String           @default("[]")
  openedAt        DateTime         @default(now())
  closedAt        DateTime?

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store           Store            @relation(fields: [storeId], references: [id])
  orders          Order[]

  @@unique([businessId, sessionNumber])
  @@index([businessId])
  @@index([storeId])
  @@index([status])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  businessId       String
  amount           Float
  currency         String        @default("INR")
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  gateway          String?
  gatewayPaymentId String?
  gatewayOrderId   String?
  gatewaySignature String?
  refundId         String?
  refundAmount     Float?
  refundedAt       DateTime?
  transactionId    String?
  receiptNumber    String?
  metadata         String        @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([businessId])
  @@index([gatewayPaymentId])
  @@index([status])
}

model PaymentGateway {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  type          String
  isActive      Boolean  @default(true)
  config        String   @default("{}")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ============================================================================
// TAX (GST)
// ============================================================================

enum TaxType {
  GST_0
  GST_5
  GST_12
  GST_18
  GST_28
  CUSTOM
}

model TaxConfig {
  id         String   @id @default(cuid())
  businessId String
  name       String
  taxType    TaxType
  gstRate    Float
  cgstRate   Float    @default(0)
  sgstRate   Float    @default(0)
  igstRate   Float    @default(0)
  cessRate   Float    @default(0)
  hsnCode    String?
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ============================================================================
// INVOICES (GST Compliant)
// ============================================================================

enum InvoiceType {
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  PROFORMA
  RECEIPT
}

model Invoice {
  id              String      @id @default(cuid())
  businessId      String
  orderId         String?     @unique
  customerId      String?
  subscriptionId  String?
  invoiceNumber   String
  invoiceType     InvoiceType @default(TAX_INVOICE)
  businessName    String
  businessAddress String?
  businessGst     String?
  businessPan     String?
  customerName    String
  customerAddress String?
  customerGst     String?
  customerPan     String?
  customerState   String?
  subtotal        Float       @default(0)
  totalDiscount   Float       @default(0)
  totalTax        Float       @default(0)
  cgstTotal       Float       @default(0)
  sgstTotal       Float       @default(0)
  igstTotal       Float       @default(0)
  cessTotal       Float       @default(0)
  deliveryFee     Float       @default(0)
  packagingFee    Float       @default(0)
  roundOff        Float       @default(0)
  totalAmount     Float       @default(0)
  amountInWords   String?
  reverseCharge   Boolean     @default(false)
  placeOfSupply   String?
  terms           String?
  notes           String?
  dueDate         DateTime?
  paidAt          DateTime?
  isGstCompliant  Boolean     @default(true)
  pdfUrl          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order?      @relation(fields: [orderId], references: [id])
  subscription    CustomerSubscription? @relation(fields: [subscriptionId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([createdAt])
}

// ============================================================================
// PROMO CODES
// ============================================================================

enum PromoType {
  PERCENTAGE
  FLAT
  FREE_DELIVERY
  BOGO
}

model PromoCode {
  id                 String    @id @default(cuid())
  businessId         String
  code               String
  description        String?
  promoType          PromoType
  value              Float
  minOrderAmount     Float     @default(0)
  maxDiscount        Float?
  usageLimit         Int?
  usageCount         Int       @default(0)
  perCustomerLimit   Int?
  applicableCategories String  @default("[]")
  applicableProducts String   @default("[]")
  isFirstOrderOnly   Boolean   @default(false)
  isActive           Boolean   @default(true)
  startsAt           DateTime
  endsAt             DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders             Order[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([code])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  ORDER_STATUS
  DELIVERY_UPDATE
  PROMOTION
  SUBSCRIPTION
  PAYMENT
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  businessId  String
  userId      String?
  type        NotificationType
  title       String
  message     String
  data        String           @default("{}")
  isRead      Boolean          @default(false)
  readAt      DateTime?
  channel     String           @default("in_app")
  sentAt      DateTime?
  createdAt   DateTime         @default(now())

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([isRead])
}

// ============================================================================
// ACTIVITY LOG
// ============================================================================

model ActivityLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String?
  action      String
  entity      String?
  entityId    String?
  details     String   @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// LEAD SOURCES (Enum)
// ============================================================================

enum LeadSource {
  META_ADS
  GOOGLE_ADS
  DIRECT_REFERRAL
  WEBSITE_INQUIRY
  COLD_OUTREACH
  WHATSAPP_INQUIRY
  PHONE_CALL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  FOLLOW_UP
}
