generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton settings record for the entire platform.
// Use getPlatformSettings() to read — never query this model directly.
model PlatformSettings {
  id             String  @id @default("singleton")

  // Company identity
  companyName    String?
  companyAddress String?
  companyEmail   String?
  companyPhone   String?
  companyWebsite String?
  companyGst     String?

  // Branding assets (stored as /uploads/platform/shared/<filename> URLs)
  logoUrl        String?
  darkLogoUrl    String?
  faviconUrl     String?
  emailLogoUrl   String?

  // Brand colors
  primaryColor   String?
  secondaryColor String?
  accentColor    String?

  // Billing / invoice configuration
  invoicePrefix  String? @default("QTX")
  sacCode        String? @default("998314")

  // GST rates (percentages, e.g. 18 / 9 / 9)
  gstRate        Float?  @default(18)
  cgstRate       Float?  @default(9)
  sgstRate       Float?  @default(9)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Lead {
  id                     String           @id @default(cuid())
  salesRepId             String?
  businessName           String
  contactName            String
  contactEmail           String
  contactPhone           String
  businessType           BusinessType
  source                 LeadSource       @default(WEBSITE_INQUIRY)
  stage                  LeadStage        @default(LEAD)
  demoTenantId           String?
  demoSharedAt           DateTime?
  demoCredentials        String?
  demoFeedback           String?
  negotiatedMonthlyPrice Float?
  negotiatedYearlyPrice  Float?
  negotiationNotes       String?
  paymentProof           String?
  paymentVerifiedAt      DateTime?
  paymentVerifiedBy      String?
  selectedBillingCycle   String?
  convertedBusinessId    String?
  convertedAt            DateTime?
  lostReason             String?
  notes                  String?
  followUpDate           DateTime?
  estimatedValue         Float?
  tags                   String           @default("[]")
  lastContactedAt        DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  city                   String?
  createdById            String?
  lastFollowUpAt         DateTime?
  leadId                 String?          @unique
  pincode                String?
  state                  String?
  salesRep               SalesTeamMember? @relation(fields: [salesRepId], references: [id])
  convertedBusiness      Business?        @relation("LeadConversion", fields: [convertedBusinessId], references: [id])

  @@index([leadId])
  @@index([salesRepId])
  @@index([stage])
  @@index([source])
  @@index([createdAt])
}

model LeadSequence {
  monthKey  String   @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ProposalSequence {
  monthKey  String   @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ProposalDocument {
  id              String    @id @default(cuid())
  proposalId      String    @unique
  documentType    String    @default("PROPOSAL")
  status          String    @default("ACTIVE")
  businessName    String
  clientName      String
  contactPhone    String?
  contactEmail    String?
  leadId          String?
  totalAmount     Float?
  salesTeamMember String?
  salesTeamEmail  String?
  formSnapshot    String    @default("{}")
  pdfPath         String?
  pdfVersion      Int       @default(1)
  createdBy       String
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedBy       String?

  @@index([proposalId])
  @@index([businessName])
  @@index([contactPhone])
  @@index([leadId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([documentType])
}

model LeadImportLog {
  id         String   @id @default(cuid())
  importedBy String
  importedAt DateTime @default(now())
  fileName   String?
  totalRows  Int      @default(0)
  imported   Int      @default(0)
  duplicates Int      @default(0)
  errors     Int      @default(0)
  notes      String?

  @@index([importedBy])
  @@index([importedAt])
}

model LeadExportLog {
  id         String    @id @default(cuid())
  exportedBy String
  exportedAt DateTime  @default(now())
  fromDate   DateTime?
  toDate     DateTime?
  filters    String?
  rowCount   Int       @default(0)

  @@index([exportedBy])
  @@index([exportedAt])
}

model DemoTenant {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  businessType     BusinessType
  status           DemoTenantStatus @default(AVAILABLE)
  accessEmail      String
  accessPassword   String
  accessUrl        String?
  currentLeadId    String?
  currentLeadName  String?
  sessionStartedAt DateTime?
  sessionExpiresAt DateTime?
  sampleDataConfig String           @default("{}")
  resetAfterUse    Boolean          @default(true)
  lastResetAt      DateTime?
  description      String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([businessType])
  @@index([status])
}

model Business {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  businessType          BusinessType
  status                BusinessStatus          @default(ONBOARDING)
  leadId                String?
  logo                  String?
  favicon               String?
  primaryColor          String                  @default("#10B981")
  secondaryColor        String?
  darkMode              Boolean                 @default(false)
  tagline               String?
  description           String?
  gstNumber             String?
  panNumber             String?
  cinNumber             String?
  fssaiLicense          String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String                  @default("India")
  latitude              Float?
  longitude             Float?
  contactEmail          String?
  contactPhone          String?
  supportEmail          String?
  supportPhone          String?
  defaultCurrency       String                  @default("INR")
  defaultLocale         String                  @default("en-IN")
  timezone              String                  @default("Asia/Kolkata")
  isOnline              Boolean                 @default(false)
  settings              String                  @default("{}")
  features              String                  @default("{}")
  notificationConfig    String                  @default("{}")
  onboardedAt           DateTime?
  activatedAt           DateTime?
  suspendedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  salesRepId            String?
  businessCode          String?                 @unique
  activityLogs          ActivityLog[]
  salesRep              SalesTeamMember?        @relation("SalesRepClients", fields: [salesRepId], references: [id])
  gatewayAccess         BusinessGatewayAccess[]
  modules               BusinessModule[]
  businessSubscription  BusinessSubscription?
  businessUsers         BusinessUser[]
  businessRoles         BusinessRole[]
  auditLogs             BusinessAuditLog[]
  categories            Category[]
  convertedLeads        Lead[]                  @relation("LeadConversion")
  customers             Customer[]
  customerSubscriptions CustomerSubscription[]
  deliveryPartners      DeliveryPartner[]
  deliveryZones         DeliveryZone[]
  deployments           Deployment[]
  domain                DomainMapping?
  featureFlags          FeatureFlag[]
  invoices              Invoice[]
  notifications         Notification[]
  onboardingSteps       OnboardingStep[]
  orders                Order[]
  posSessions           POSSession[]
  payments              Payment[]
  paymentGateways       PaymentGateway[]
  storePaymentGateways  StorePaymentGateway[]
  products              Product[]
  promoCodes            PromoCode[]
  reviews               Review[]
  stores                Store[]
  subscriptionPlans     SubscriptionPlan[]
  addons                Addon[]
  taxConfigs            TaxConfig[]
  workflowRules         WorkflowRule[]
  branding              BusinessBranding?
  appConfig             AppConfig?
  cartItems             CartItem[]
  favorites             Favorite[]
  supportTickets        SupportTicket[]
  workforceSettings     WorkforceSettings?
  partnerAuditLogs      PartnerAudit[]
  notificationSounds    NotificationSound[]
  notificationDevices   NotificationDevice[]
  banners               Banner[]
  refunds               Refund[]

  @@index([businessType])
  @@index([status])
  @@index([salesRepId])
}

model OnboardingStep {
  id          String               @id @default(cuid())
  businessId  String
  stepKey     String
  stepName    String
  status      OnboardingStepStatus @default(PENDING)
  completedBy String?
  completedAt DateTime?
  notes       String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, stepKey])
  @@index([businessId])
  @@index([status])
}

model BusinessModule {
  id         String       @id @default(cuid())
  businessId String
  moduleKey  String
  moduleName String
  version    String       @default("1.0.0")
  status     ModuleStatus @default(DISABLED)
  config     String       @default("{}")
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, moduleKey])
  @@index([businessId])
  @@index([moduleKey])
  @@index([status])
}

model Store {
  id                  String         @id @default(cuid())
  businessId          String
  name                String
  slug                String
  code                String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  country             String         @default("India")
  latitude            Float?
  longitude           Float?
  phone               String?
  email               String?
  status              StoreStatus    @default(ACTIVE)
  isMainStore         Boolean        @default(false)
  deliveryRadius      Float          @default(5.0)
  minOrderAmount      Float          @default(0)
  deliveryFee         Float          @default(0)
  freeDeliveryAbove   Float?
  maxDeliveryDistance Float?         @default(10.0)
  preparationTime     Int            @default(30)
  operatingHours      String         @default("{}")
  posEnabled          Boolean        @default(true)
  printerConfig       String         @default("{}")
  printerType         String?
  paperSize           String         @default("80mm")
  gstNumber           String?
  settings            String         @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  storeCode           String?
  staff               BusinessUser[]
  categories          Category[]
  deliveryZones       DeliveryZone[]
  inventory           Inventory[]
  orders              Order[]
  posSessions         POSSession[]
  products            Product[]
  taxConfigs          TaxConfig[]
  workflowRules       WorkflowRule[]
  userAssignments     UserStoreAssignment[]
  storePaymentGateways StorePaymentGateway[]
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeTimings        StoreTiming[]
  banners             Banner[]

  @@unique([businessId, slug])
  @@unique([businessId, storeCode])
  @@index([businessId])
  @@index([status])
}

model StoreTiming {
  id        String   @id @default(cuid())
  storeId   String
  day       Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@index([storeId])
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  loginId             String?           @unique
  phone               String?
  name                String
  avatar              String?
  passwordHash        String?
  hasPassword         Boolean           @default(false)
  authProvider        AuthProvider      @default(EMAIL_OTP)
  emailVerified       Boolean           @default(false)
  phoneVerified       Boolean           @default(false)
  isActive            Boolean           @default(true)
  fcmToken            String?
  lastLoginAt         DateTime?
  metadata            String            @default("{}")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  platformRole        Role?
  platformPermissions String?
  activityLogs        ActivityLog[]
  businessUsers       BusinessUser[]
  customerProfiles    Customer[]
  customerNotes       CustomerNote[]
  deliveryProfiles    DeliveryPartner[]
  notifications       Notification[]
  notificationDevices NotificationDevice[]
  otpCodes            OTPCode[]
  posSessions         POSSession[]      @relation("POSOperator")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  salesProfile        SalesTeamMember?
}

model OTPCode {
  id         String       @id @default(cuid())
  userId     String?
  email      String?
  phone      String?
  code       String
  channel    AuthProvider
  isVerified Boolean      @default(false)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([code])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model BusinessUser {
  id              String                @id @default(cuid())
  userId          String
  businessId      String
  role            Role
  storeId         String?
  businessRoleId  String?
  createdBy       String?
  permissions     String                @default("[]")
  isActive        Boolean               @default(true)
  invitedAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  store           Store?                @relation(fields: [storeId], references: [id])
  businessRole    BusinessRole?         @relation(fields: [businessRoleId], references: [id])
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeAssignments UserStoreAssignment[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([role])
  @@index([businessRoleId])
}

model BusinessRole {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  description String?
  permissions String         @default("{}")
  isSystem    Boolean        @default(false)
  isActive    Boolean        @default(true)
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       BusinessUser[]

  @@unique([businessId, name])
  @@index([businessId])
}

model UserStoreAssignment {
  id             String       @id @default(cuid())
  businessUserId String
  storeId        String
  createdAt      DateTime     @default(now())
  businessUser   BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([businessUserId, storeId])
  @@index([businessUserId])
  @@index([storeId])
}

model BusinessAuditLog {
  id         String   @id @default(cuid())
  businessId String
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Order {
  id                   String                @id @default(cuid())
  businessId           String
  storeId              String
  orderNumber          String
  orderType            OrderType
  orderSource          String                @default("online")
  status               OrderStatus           @default(PENDING)
  paymentStatus        PaymentStatus         @default(PENDING)
  paymentMethod        PaymentMethodType?
  customerId           String?
  customerName         String?
  customerPhone        String?
  customerEmail        String?
  deliveryAddressId    String?
  deliveryAddress      String?
  deliveryLat          Float?
  deliveryLng          Float?
  deliveryInstructions String?
  scheduledAt          DateTime?
  pickupAddress        String?
  pickupScheduledAt    DateTime?
  pickupCompletedAt    DateTime?
  subtotal             Float                 @default(0)
  totalDiscount        Float                 @default(0)
  totalTax             Float                 @default(0)
  deliveryFee          Float                 @default(0)
  packagingFee         Float                 @default(0)
  convenienceFee       Float                 @default(0)
  tip                  Float                 @default(0)
  roundOff             Float                 @default(0)
  totalAmount          Float                 @default(0)
  cgstAmount           Float                 @default(0)
  sgstAmount           Float                 @default(0)
  igstAmount           Float                 @default(0)
  cessAmount           Float                 @default(0)
  posSessionId         String?
  posOperatorId        String?
  tableNumber          String?
  subscriptionId       String?
  promoCodeId          String?
  pickupPartnerId      String?
  deliveryPartnerId    String?
  deliveryOtp          String?
  pickupOtp            String?
  notes                String?
  cancelReason         String?
  metadata             String                @default("{}")
  confirmedAt          DateTime?
  preparedAt           DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  delivery             Delivery?
  invoice              Invoice?
  promoCode            PromoCode?            @relation(fields: [promoCodeId], references: [id])
  customerSubscription CustomerSubscription? @relation(fields: [subscriptionId], references: [id])
  posSession           POSSession?           @relation(fields: [posSessionId], references: [id])
  customer             Customer?             @relation(fields: [customerId], references: [id])
  store                Store                 @relation(fields: [storeId], references: [id])
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveryPartner      DeliveryPartner?      @relation("OrderDeliveryPartner", fields: [deliveryPartnerId], references: [id])
  pickupPartner        DeliveryPartner?      @relation("OrderPickupPartner", fields: [pickupPartnerId], references: [id])
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  refunds              Refund[]
  locationHistory      PartnerLocationHistory[]
  liveTrackingSession  LiveTrackingSession?

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderType])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  itemType            String
  itemId              String
  itemName            String
  variantName         String?
  sku                 String?
  barcode             String?
  quantity            Float
  unitPrice           Float
  mrp                 Float?
  discountPrice       Float?
  discountPercent     Float?
  totalPrice          Float
  totalMrp            Float?
  gstRate             Float    @default(0)
  gstAmount           Float    @default(0)
  cgstAmount          Float    @default(0)
  sgstAmount          Float    @default(0)
  igstAmount          Float    @default(0)
  specialInstructions String?
  customizations      String?
  isVeg               Boolean?
  unit                String?
  metadata            String   @default("{}")
  createdAt           DateTime @default(now())
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemType])
  @@index([itemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model Delivery {
  id                    String           @id @default(cuid())
  orderId               String           @unique
  deliveryPartnerId     String?
  pickupPartnerId       String?
  status                DeliveryStatus   @default(ASSIGNING)
  pickupLat             Float?
  pickupLng             Float?
  pickupAddress         String?
  dropLat               Float?
  dropLng               Float?
  dropAddress           String?
  estimatedPickupTime   DateTime?
  estimatedDeliveryTime DateTime?
  actualPickupTime      DateTime?
  actualDeliveryTime    DateTime?
  distance              Float?
  deliveryOtp           String?
  pickupOtp             String?
  rating                Int?
  feedback              String?
  cancelReason          String?
  liveTracking          String           @default("[]")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deliveryPartner       DeliveryPartner? @relation("DeliveryAssignedPartner", fields: [deliveryPartnerId], references: [id])
  pickupPartner         DeliveryPartner? @relation("DeliveryPickupPartner", fields: [pickupPartnerId], references: [id])
  order                 Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([deliveryPartnerId])
  @@index([status])
}

model DeliveryZone {
  id                String   @id @default(cuid())
  businessId        String
  storeId           String?
  name              String
  zoneType          ZoneType
  centerLat         Float?
  centerLng         Float?
  radius            Float?
  polygon           String?
  pincodes          String?
  deliveryFee       Float    @default(0)
  minOrderAmount    Float    @default(0)
  freeDeliveryAbove Float?
  estimatedTime     Int      @default(30)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  store             Store?   @relation(fields: [storeId], references: [id])
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([storeId])
}

model DeliveryPartner {
  id              String              @id @default(cuid())
  businessId      String
  userId          String?
  name            String
  phone           String
  email           String?
  avatar          String?
  vehicleType     String?
  vehicleNumber   String?
  licenseNumber   String?
  isOnline        Boolean             @default(false)
  isActive        Boolean             @default(true)
  currentLat      Float?
  currentLng      Float?
  rating          Float               @default(0)
  totalDeliveries Int                 @default(0)
  totalEarnings   Float               @default(0)
  fcmToken        String?
  bankAccount     String?
  partnerCode     String?
  partnerType     PartnerType         @default(INTERNAL)
  availability    PartnerAvailability @default(OFFLINE)
  appEnabled      Boolean             @default(false)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deliveries      Delivery[]          @relation("DeliveryAssignedPartner")
  pickupDeliveries Delivery[]         @relation("DeliveryPickupPartner")
  deliveryOrders      Order[]               @relation("OrderDeliveryPartner")
  pickupOrders        Order[]               @relation("OrderPickupPartner")
  auditLogs           PartnerAudit[]
  locationHistory     PartnerLocationHistory[]
  liveTrackingSessions LiveTrackingSession[]
  user            User?               @relation(fields: [userId], references: [id])
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@unique([businessId, partnerCode])
  @@index([businessId])
  @@index([isOnline])
  @@index([availability])
}

model WorkforceSettings {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  partnerLabel       String   @default("Delivery Partner")
  partnerLabelPlural String   @default("Delivery Partners")
  onlineLabel        String   @default("Online")
  offlineLabel       String   @default("Offline")
  busyLabel          String   @default("Busy")
  internalLabel      String   @default("Internal")
  externalLabel      String   @default("External")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PartnerAudit {
  id          String          @id @default(cuid())
  businessId  String
  partnerId   String
  action      String
  field       String?
  oldValue    String?
  newValue    String?
  performedBy String?
  note        String?
  createdAt   DateTime        @default(now())
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([partnerId])
}

model NotificationSound {
  id         String   @id @default(cuid())
  businessId String
  name       String
  url        String
  eventType  String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model NotificationDevice {
  id          String         @id @default(cuid())
  userId      String
  businessId  String
  fcmToken    String
  platform    DevicePlatform
  deviceId    String?
  appVersion  String?
