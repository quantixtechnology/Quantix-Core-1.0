  user       User?     @relation(fields: [userId], references: [id])
  business   Business? @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Category {
  id           String       @id @default(cuid())
  businessId   String
  storeId      String?
  name         String
  slug         String
  description  String?
  image        String?
  icon         String?
  color        String?
  parentId     String?
  workflowType WorkflowType @default(ECOMMERCE)
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryHierarchy")
  store        Store?       @relation(fields: [storeId], references: [id])
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([storeId])
  @@index([parentId])
  @@index([workflowType])
}

model Product {
  id              String           @id @default(cuid())
  businessId      String
  storeId         String?
  categoryId      String?
  name            String
  slug            String
  description     String?
  shortDesc       String?
  type            ProductType      @default(PHYSICAL)
  status          ProductStatus    @default(ACTIVE)
  sku             String?
  barcode         String?
  images          String           @default("[]")
  unit            String?
  unitQuantity    Float?
  isVeg           Boolean?
  isFeatured      Boolean          @default(false)
  isPopular       Boolean          @default(false)
  preparationTime Int?
  minOrderQty     Float            @default(1)
  maxOrderQty     Float            @default(100)
  tags            String           @default("[]")
  nutritionInfo   String?
  allergenInfo    String?
  workflowType    WorkflowType?
  sortOrder       Int              @default(0)
  metadata        String           @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventory       Inventory[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  store           Store?           @relation(fields: [storeId], references: [id])
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  cartItems       CartItem[]
  favorites       Favorite[]
  reviews         Review[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([storeId])
  @@index([workflowType])
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  name            String
  sku             String?
  barcode         String?
  price           Float
  mrp             Float
  costPrice       Float?
  discountPrice   Float?
  discountPercent Float?
  isDefault       Boolean     @default(false)
  isActive        Boolean     @default(true)
  attributes      String      @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  inventory       Inventory[]
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
}

model Inventory {
  id              String          @id @default(cuid())
  businessId      String
  storeId         String
  productId       String
  variantId       String?
  quantity        Int             @default(0)
  reservedQty     Int             @default(0)
  minStock        Int             @default(5)
  maxStock        Int             @default(1000)
  status          InventoryStatus @default(IN_STOCK)
  lastRestockedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  logs            InventoryLog[]

  @@unique([storeId, productId, variantId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
}

model InventoryLog {
  id          String    @id @default(cuid())
  inventoryId String
  action      String
  quantity    Int
  previousQty Int
  newQty      Int
  note        String?
  performedBy String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
}

model RolePermission {
  id          String   @id @default(cuid())
  role        String   @unique
  permissions Json
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([role])
}

model PermissionChangeLog {
  id             String   @id @default(cuid())
  role           String
  changedBy      String
  changedByEmail String?
  oldPerms       Json
  newPerms       Json
  added          Json
  removed        Json
  note           String?
  createdAt      DateTime @default(now())

  @@index([role])
  @@index([changedBy])
  @@index([createdAt])
}

model BusinessBranding {
  id             String   @id @default(cuid())
  businessId     String   @unique
  primaryColor   String   @default("#10B981")
  secondaryColor String?
  accentColor    String?
  logo           String?
  favicon        String?
  coverImage     String?
  appIcon        String?
  fontFamily     String?
  borderRadius   String   @default("8")
  darkMode       Boolean  @default(false)
  customCss      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id          String   @id @default(cuid())
  businessId  String   @unique
  appName     String?
  tagline     String?
  splashColor String?
  theme       String   @default("{}")
  social      String   @default("{}")
  contactInfo String   @default("{}")
  seoConfig   String   @default("{}")
  analytics   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id         String   @id @default(cuid())
  businessId String
  key        String
  enabled    Boolean  @default(false)
  value      String   @default("{}")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
  @@index([key])
}

model WorkflowRule {
  id         String   @id @default(cuid())
  businessId String
  storeId    String?
  ruleKey    String
  ruleName   String
  trigger    String
  conditions String   @default("[]")
  actions    String   @default("[]")
  isActive   Boolean  @default(true)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  store      Store?   @relation(fields: [storeId], references: [id])
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, ruleKey])
  @@index([businessId])
  @@index([storeId])
  @@index([trigger])
  @@index([isActive])
}

model CartItem {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  storeId    String
  productId  String
  variantId  String?
  quantity   Int      @default(1)
  addedAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, storeId, productId, variantId])
  @@index([customerId])
  @@index([businessId])
  @@index([storeId])
}

model Favorite {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  productId  String
  addedAt    DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([businessId])
}

model SupportTicket {
  id         String   @id @default(cuid())
  businessId String
  customerId String?
  name       String
  phone      String?
  subject    String
  category   String
  message    String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
}

