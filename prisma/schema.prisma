  orders          LaundryOrder[]
  pricingRules    LaundryPricingRule[]

  @@index([laundryBusinessId])
  @@index([storeCode])
  @@index([storeType])
}

model LaundryBusinessFeature {
  id         String   @id @default(cuid())
  businessId String
  featureKey String
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureKey])
  @@index([businessId])
}

// ============================================================================
// LAUNDRY OS — Order Management (Stage 1 – Order Intake)
// Fully isolated order models for the Laundry OS workflow.
// ============================================================================

enum LaundryOrderStatus {
  DRAFT
  PENDING_STORE_AUDIT
  UNDER_AUDIT
  PAYMENT_PENDING
  READY_FOR_PROCESSING
  PACKED
  IN_TRANSIT_TO_PROCESSING
  PROCESSING
  QC_PENDING
  RETURN_IN_TRANSIT
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model LaundryOrder {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique
  businessId           String
  storeId              String
  customerId           String?
  orderType            String             @default("WALK_IN") // WALK_IN | STORE_DROP | HOME_PICKUP | CORPORATE | SUBSCRIPTION
  source               String             @default("MANUAL")
  // Informational channel that CREATED the order. Never branches business logic —
  // the workflow is identical for every source. ONLINE_WEB | ONLINE_APP |
  // STORE_WALKIN | STORE_DROP | HOME_PICKUP | CORPORATE | SUBSCRIPTION | API.
  orderSource          String             @default("STORE_WALKIN")
  status               LaundryOrderStatus @default(DRAFT)
  paymentPreference    String             @default("COD") // FULL_ADVANCE | PARTIAL_ADVANCE | COD | SUBSCRIPTION_BILLING
  expectedDeliveryDate DateTime?
  deliveryOverride     Boolean            @default(false)
  overrideReason       String?
  pickupDate           DateTime?
  pickupTimeSlot       String?
  pickupAddress        String?
  pickupInstructions   String?
  specialInstructions  String?
  notes                String?
  createdBy            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // ── Financial snapshot ───────────────────────────────────────────────────
  // Resolved by the Billing Engine and PERSISTED at order creation. This is the
  // immutable financial record of the order — invoices, payments and reports
  // read these values and must NEVER recalculate from the Pricing Engine, so
  // later price changes never alter historical orders.
  subtotal       Float     @default(0)
  gstTotal       Float     @default(0)
  pickupCharge   Float     @default(0)
  deliveryCharge Float     @default(0)
  expressCharge  Float     @default(0)
  discount       Float     @default(0)
  grandTotal     Float     @default(0)
  amountPaid     Float     @default(0)
  balanceDue     Float     @default(0)
  paymentStatus  String    @default("UNPAID") // UNPAID | PARTIAL | PAID | SUBSCRIPTION
  // Portion of this order's charges met by an active customer subscription
  // allowance (KG/Piece). Additive: 0 for every walk-in/regular order — the
  // frozen billing snapshot above is untouched; this only records how much of
  // it was covered so the invoice can separate "Covered by Subscription" from
  // "Extra Charges". The uncovered remainder stays in balanceDue.
  subscriptionCoveredAmount Float @default(0)
  isExpress      Boolean   @default(false)
  customerType   String? // resolved customer type used for pricing
  billedAt       DateTime? // when the financial snapshot was persisted

  // ── Store Audit (Stage 2) — inspection captured against the garments the
  //    order already carries; the audit does not re-enter garments. ──
  auditNotes  String?
  auditPhotos String? // JSON array of uploaded photo URLs
  auditedBy   String?
  auditedAt   DateTime?
  // The single total order weight (KG) measured at Store Audit. Drives PER_KG
  // billing for the whole order (weight × rate). 0 until weighed. Garment
  // quantities remain on the items for inventory/tracking/barcode/QC/delivery.
  totalWeightKg Float @default(0)

  // ── Delivery completion (final operational action) ──
  deliveredAt   DateTime?
  deliveredBy   String?
  recipientName String?

  business   LaundryBusiness         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store      LaundryStore            @relation(fields: [storeId], references: [id])
  packet     LaundryPacket?
  services   LaundryOrderService[]
  items      LaundryOrderItem[]
  payments   LaundryPayment[]
  invoice    LaundryInvoice?
  timestamps LaundryStageTimestamp[]
  events     LaundryOrderEvent[]

  @@index([businessId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([paymentStatus])
}

// ── Operational master data (per laundry business) ─────────────────────────
// Category master — garment/service grouping (Wash, Dry Clean, Premium, …).
model LaundryCategory {
  id                String   @id @default(cuid())
  businessId        String
  name              String
  code              String?
  description       String?
  color             String? // hex swatch
  icon              String? // icon name / emoji
  image             String? // image URL
  defaultGstPercent Float? // GST default for garments/services in this category
  displayOnWebsite  Boolean  @default(true)
  displayInPOS      Boolean  @default(true)
  displayInApp      Boolean  @default(true)
  displayOrder      Int      @default(0) // = sort priority
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  garments             LaundryGarment[]
  services             LaundryService[]
  pricingRules         LaundryPricingRule[]
  serviceCompatibility LaundryServiceGarmentCategory[]

  @@index([businessId])
}

// Garment master — referenced by pricing. Default unit Piece/Kg.
model LaundryGarment {
  id               String   @id @default(cuid())
  businessId       String
  name             String
  code             String?
  categoryId       String?
  defaultService   String?
  defaultUnit      String   @default("PIECE") // PIECE | KG
  image            String? // image URL
  material         String? // Cotton, Silk, Wool, …
  careInstructions String?
  barcodePrefix    String?
  weightFactor     Float? // multiplier for weight-based pricing
  averageWeight    Float? // avg weight (kg) for estimates
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category     LaundryCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pricingRules LaundryPricingRule[]

  @@index([businessId])
  @@index([categoryId])
}

// Service master — what is done to a garment (Wash, Dry Clean, …).
model LaundryService {
  // Configurable processing route (JSON array of stage codes). When null the
  // engine falls back to the legacy name-based heuristic. Managed from
  // Services & Pricing; snapshotted onto garments when processing starts.
  processFlow            String?
  id                     String   @id @default(cuid())
  businessId             String
  name                   String
  code                   String?
  categoryId             String?
  description            String?
  icon                   String?
  image                  String? // tenant marketing image (upload URL)
  color                  String?
  defaultPricingType     String   @default("PER_PIECE") // PER_PIECE | PER_KG | FIXED | SUBSCRIPTION | CORPORATE
  defaultGstPercent      Float?
  defaultTurnaroundHours Int      @default(24)
  processingSequence     Int      @default(0) // order in the processing line
  expressAvailable       Boolean  @default(false)
  displayOnWebsite       Boolean  @default(true)
  availableInStore       Boolean  @default(true)
  availableForPickup     Boolean  @default(true)
  subscriptionEligible   Boolean  @default(false)
  displayOrder           Int      @default(0)
  isActive               Boolean  @default(true)
  // Booking method (additive). GARMENT = customer counts garments at booking
  // (existing default). BAG = Pickup-First: customer books the service only;
  // one bag per service; garments are counted later at Store Audit.
  orderMode              String   @default("GARMENT") // GARMENT | BAG
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  category             LaundryCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pricingRules         LaundryPricingRule[]
  compatibleCategories LaundryServiceGarmentCategory[]

  @@index([businessId])
  @@index([categoryId])
}

// Pricing Engine — every billable rule. Connected to Service / Garment /
// Category / Store; customerType + pricingType drive bill calculation.
model LaundryPricingRule {
  id                    String    @id @default(cuid())
  businessId            String
  name                  String? // human label for the rule
  description           String?
  notes                 String?
  serviceId             String?
  garmentId             String?
  categoryId            String?
  storeId               String?
  customerType          String? // WALK_IN|PICKUP|CORPORATE|HOTEL|HOSPITAL|SUBSCRIPTION|VIP
  pricingType           String    @default("PER_PIECE") // PER_PIECE|PER_KG|FIXED|SUBSCRIPTION|CORPORATE
  price                 Float     @default(0)
  gstPercent            Float     @default(0)
  minCharge             Float?
  maxCharge             Float? // optional cap
  minWeightKg           Float? // Per-KG minimum billable weight
  maxWeightKg           Float? // Per-KG / Subscription included cap
  extraWeightCharge     Float? // excess rate beyond cap
  includedPieces        Int? // Subscription included pieces (future consumption)
  discountPercent       Float? // Corporate discount %
  weekendPrice          Float?
  expressCharge         Float?
  pickupCharge          Float?
  deliveryCharge        Float?
  freeDeliveryThreshold Float? // waive delivery when order subtotal ≥ this
  urgentDeliveryCharge  Float? // charge for urgent / same-day delivery
  hsnCode               String? // future-ready GST HSN
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  priority              Int       @default(0)
  // Lifecycle: DRAFT | ACTIVE | INACTIVE | ARCHIVED. isActive stays in sync
  // (ACTIVE => true, else false) so the Billing Resolver — which filters on
  // isActive — is never matched against draft/inactive/archived rules.
  status                String    @default("ACTIVE")
  isActive              Boolean   @default(true)
  // Audit / versioning — history is never overwritten.
  createdById           String?
  createdByName         String?
  modifiedById          String?
  modifiedByName        String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  service  LaundryService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  garment  LaundryGarment?  @relation(fields: [garmentId], references: [id], onDelete: SetNull)
  category LaundryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  store    LaundryStore?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([serviceId])
  @@index([garmentId])
  @@index([storeId])
  @@index([status])
}

// Append-only audit trail for pricing rules — one row per create/update/
// archive/restore/duplicate, with a JSON snapshot of the rule at that version.
// History is never overwritten.
model LaundryPricingRuleAudit {
  id         String   @id @default(cuid())
  ruleId     String
  businessId String
  version    Int
  action     String // CREATE | UPDATE | ARCHIVE | RESTORE | DUPLICATE
  actorId    String?
  actorName  String?
  snapshot   String // JSON of the rule at this version
  createdAt  DateTime @default(now())

  @@index([ruleId])
  @@index([businessId])
}

// Per-order workflow event log — the audit trail / timeline of every stage
// transition (who moved it, from which status to which, when, with a note).
model LaundryOrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  businessId String
  fromStatus String?
  toStatus   String
  action     String // e.g. STORE_AUDIT, COLLECT_PAYMENT, DISPATCH_TO_PROCESSING
  actorId    String?
  actorName  String?
  note       String?
  createdAt  DateTime @default(now())

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([businessId])
  @@index([createdAt])
}

model LaundryOrderService {
  id              String   @id @default(cuid())
  orderId         String
  serviceId       String?
  serviceName     String
  turnaroundHours Int      @default(24)
  createdAt       DateTime @default(now())

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Per-order billing line — the persisted financial snapshot of one priced
// garment+service line. Captures the Pricing Rule used and every computed
// figure so invoices/reports never recalculate. Distinct from
// LaundryOrderService, which records the workflow service lines.
model LaundryOrderItem {
  id               String    @id @default(cuid())
  orderId          String
  itemNumber       String? // permanent garment ID: ITM-{orderNumber}-NNNN
  barcode          String?   @unique // barcode value = itemNumber (per-garment)
  barcodeGenerated Boolean   @default(false) // label generated at Processing Center
  barcodePrintedAt DateTime?
  printCount       Int       @default(0)
  lastPrintedBy    String?
  // ── Processing Center per-garment stage tracking ──
  processingStage  String? // RECEIVED|SORTING|WASH|DRYCLEAN|DRY|STEAM|IRON|FOLD|QC|PACKED|DISPATCHED
  processingStatus String? // WAITING|IN_PROGRESS|DONE|REJECTED
  processingDept   String? // department that owns the current stage
  receivedAt       DateTime?
  serviceId        String?
  serviceName      String
  garmentId        String?
  garmentName      String
  categoryId       String?
  pricingRuleId    String? // which rule resolved this line
  pricingType      String    @default("PER_PIECE")
  quantity         Float     @default(0)
  weightKg         Float     @default(0)
  unitPrice        Float     @default(0)
  lineAmount       Float     @default(0) // base, pre-GST, post-discount
  gstPercent       Float     @default(0)
  gstAmount        Float     @default(0)
  discount         Float     @default(0)
  total            Float     @default(0) // lineAmount + gstAmount
  // Processing route SNAPSHOT — frozen when the garment moves to processing so
  // later service-route config changes never rewrite in-progress history.
  processFlow      String? // JSON array of stage codes, e.g. ["WASH","DRY","IRON","QC","PACKED"]
  qcFailCount      Int       @default(0) // QC attempts tracking (rework cycles)
  // Store Audit inspection (captured at Stage 2, never re-entering garments).
  condition        String? // GOOD | DAMAGED
  defects          String? // CSV of defect codes
  inspectionNotes  String?
  inspectedAt      DateTime?
  createdAt        DateTime  @default(now())

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([serviceId])
  @@index([garmentId])
}

// Per-garment timeline — every scan/action on an item (Processing Center).
model LaundryItemEvent {
  id         String   @id @default(cuid())
  itemId     String
  orderId    String
  businessId String
  stage      String? // stage the event relates to (WASH, IRON, QC, …)
  action     String // RECEIVED|START|COMPLETE|REJECT|QC_PASS|QC_FAIL|PACKED|SCAN|NOTE
  fromStage  String?
  toStage    String?
  department String?
  actorId    String?
  actorName  String?
  note       String?
  photos     String? // JSON array of URLs
  createdAt  DateTime @default(now())

  @@index([itemId])
  @@index([orderId])
  @@index([businessId])
}

// Per-order payment record. Payment Collection reads the order's persisted
// totals and appends these; amountPaid/balanceDue/paymentStatus on the order
// are the running summary.
model LaundryPayment {
  id         String   @id @default(cuid())
  orderId    String
  businessId String
  method     String // CASH | UPI | CARD | WALLET | CREDIT | SUBSCRIPTION | PARTIAL
  amount     Float
  reference  String?
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([businessId])
  @@index([createdAt])
}

// ============================================================================
// LAUNDRY OS — Invoice & Financial Engine (single source of truth)
//
// ONE invoice per LaundryOrder. Totals are NOT duplicated — they are read from
// the order's persisted financial snapshot (subtotal / gstTotal / grandTotal /
// amountPaid / balanceDue, finalised at Store Audit → billedAt). Payment history
// reuses the existing LaundryPayment records. This model only adds the invoice
// DOCUMENT identity: number, status, GST treatment, issue date, lifecycle.
// ============================================================================
model LaundryInvoice {
  id            String    @id @default(cuid())
  businessId    String
  orderId       String    @unique
  invoiceNumber String    @unique
  // DRAFT | GENERATED | PARTIALLY_PAID | PAID | CANCELLED | REFUNDED | CREDIT_NOTE | VOID
  status        String    @default("GENERATED")
  // NONE | INTRA_STATE (CGST+SGST) | INTER_STATE (IGST)
  gstTreatment  String    @default("NONE")
  placeOfSupply String?
  issuedAt      DateTime  @default(now())
  cancelledAt   DateTime?
  cancelReason  String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceNumber])
  @@index([status])
}

// Per-tenant financial identity + the invoice number counter. Central config so
// invoice/GST/currency/rounding/branding rules are never hardcoded and can be
// reused across products. Numbering is sequential, tenant-scoped, gap-tolerant
// (a failed transaction may skip a number; numbers are never reused/changed).
model LaundryFinancialSettings {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  // Invoice numbering
  invoicePrefix        String   @default("INV-LND")
  invoiceNextNumber    Int      @default(1)
  invoiceNumberPadding Int      @default(6)
  // GST
  gstEnabled           Boolean  @default(false)
  gstNumber            String?
  taxInclusive         Boolean  @default(false)
  homeState            String? // business place-of-supply (intra vs inter state)
  // Presentation / branding
  currency             String   @default("INR")
  rounding             String   @default("NEAREST") // NEAREST | UP | DOWN | NONE
  decimalPrecision     Int      @default(2)
  businessLogo         String?
  businessName         String?
  businessAddress      String?
  businessPhone        String?
  businessEmail        String?
  businessWebsite      String?
  primaryColor         String? // invoice accent colour (tenant branding)
  invoiceFooter        String?
  invoiceTerms         String?
  declaration          String?
  authorizedSignatory  String? // name printed under the signature
  signatureUrl         String?
  bankDetails          String? // free-text bank account block (optional)
  upiQr                String? // UPI QR image URL (optional)
  paymentInstructions  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([businessId])
}

// ============================================================================
// LAUNDRY OS — Workflow Engine (Phase 4)
// Fully isolated, no relationships with existing Quantix Core entities.
// ============================================================================

model LaundryWorkflowStage {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  sequence    Int
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  configurations LaundryWorkflowConfiguration[]
  permissions    LaundryStagePermission[]
  timestamps     LaundryStageTimestamp[]

  @@index([code])
  @@index([sequence])
}

model LaundryWorkflowConfiguration {
  id                      String   @id @default(cuid())
  businessId              String
  stageId                 String
  enabled                 Boolean  @default(true)
  sequence                Int?
  responsibleRoleId       String?
  responsibleDepartmentId String?
  canView                 Boolean  @default(true)
  canUpdate               Boolean  @default(false)
  canApprove              Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  stage                 LaundryWorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  business              LaundryBusiness      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  responsibleRole       LaundryRole?         @relation(fields: [responsibleRoleId], references: [id], onDelete: SetNull)
  responsibleDepartment LaundryDepartment?   @relation(fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)

  @@unique([businessId, stageId])
  @@index([businessId])
  @@index([stageId])
  @@index([responsibleRoleId])
  @@index([responsibleDepartmentId])
}

model LaundryRole {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions     LaundryStagePermission[]
  assignments     LaundryUserAssignment[]
  workflowConfigs LaundryWorkflowConfiguration[]

  @@index([code])
}

model LaundryStagePermission {
  id        String   @id @default(cuid())
  stageId   String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage LaundryWorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  role  LaundryRole          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([stageId, roleId])
  @@index([stageId])
  @@index([roleId])
}

model LaundryStageTimestamp {
  id        String    @id @default(cuid())
  orderId   String
  stageId   String
  enteredAt DateTime?
  exitedAt  DateTime?
  movedBy   String?
  duration  Int?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stage LaundryWorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  order LaundryOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([stageId])
  @@index([orderId, stageId])
}

// ============================================================================
// LAUNDRY OS — Operational Structure (Phase 5)
// Fully isolated, no relationships with existing Quantix Core entities.
// ============================================================================

model LaundryDepartment {
  id         String   @id @default(cuid())
  businessId String
  storeId    String?
  code       String
  name       String
  enabled    Boolean  @default(true)
  sequence   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business        LaundryBusiness                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store           LaundryStore?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  assignments     LaundryUserAssignment[]
  workflowConfigs LaundryWorkflowConfiguration[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([storeId])
}

model LaundryProcessingCenter {
  id              String   @id @default(cuid())
  centerCode      String   @unique
  businessId      String
  centerName      String
  centerType      String   @default("PROCESSING_HUB")
  managerName     String?
  mobile          String?
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  dailyCapacityKg Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([centerCode])
  @@index([centerType])
}

// File uploads (logos, product images, documents)
model FileUpload {
  id           String   @id @default(cuid())
  businessId   String
  originalName String
  filename     String
  size         Int
  mimeType     String
  uploadPath   String
  category     String? // customers|garments|audit|invoice|documents|branding|orders|processing|delivery|temp
  status       String   @default("COMPLETED") // COMPLETED, PROCESSING, FAILED
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
  @@index([category])
}

// Payment records from Razorpay webhooks
model RazorpayPayment {
  id             String    @id @default(cuid())
  businessId     String
  subscriptionId String
  paymentId      String    @unique // Razorpay payment ID
  amount         Float
  status         String    @default("COMPLETED") // COMPLETED, FAILED, REFUNDED
  method         String    @default("RAZORPAY")
  lastPaymentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([subscriptionId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model LaundryUserAssignment {
  id           String   @id @default(cuid())
  businessId   String
  storeId      String?
  departmentId String?
  roleId       String
  userId       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business   LaundryBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store      LaundryStore?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  department LaundryDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role       LaundryRole        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([storeId])
  @@index([departmentId])
  @@index([roleId])
}

// ============================================================================
// LAUNDRY OS — Optional CRM Module (feature-gated per tenant via
// LaundryBusinessFeature featureKey "CRM"). Lead → Opportunity → configurable
// Sales Stages → Won/Lost. No Contact/Company entities by design.
// All businessId columns reference LaundryBusiness.id (tenant isolation).
// SQLite: JSON payloads stored as String (existing convention).
// ============================================================================

// Dynamic Lead field definition (metadata-driven Lead form).
model LaundryCrmLeadField {
  id           String   @id @default(cuid())
  businessId   String
  fieldKey     String // stable internal key, e.g. "first_name"
  label        String
  type         String   @default("TEXT") // TEXT | TEXTAREA | PHONE | EMAIL | NUMBER | DECIMAL | CURRENCY | DATE | DATETIME | SELECT | MULTISELECT | RADIO | CHECKBOX | TOGGLE | URL | ADDRESS
  description  String?
  placeholder  String?
  defaultValue String?
  options      String? // JSON [{value,label,order,active}] for SELECT/MULTISELECT/RADIO
  validation   String? // JSON validation rules (min,max,pattern…)
  required     Boolean  @default(false)
  active       Boolean  @default(true)
  isSystem     Boolean  @default(false) // protected — cannot be deleted/deactivated
  displayOrder Int      @default(0)
  searchable   Boolean  @default(false)
  filterable   Boolean  @default(false)
  showInList   Boolean  @default(false)
  showInCreate Boolean  @default(true)
  showInEdit   Boolean  @default(true)
  showInDetail Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, fieldKey])
  @@index([businessId])
}

model LaundryCrmLeadStatus {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  color           String           @default("#64748B")
  displayOrder    Int              @default(0)
  active          Boolean          @default(true)
  isDefault       Boolean          @default(false)
  kind            String           @default("OPEN") // OPEN | CLOSED | CONVERTED | LOST — behaviour key (never match on name)
  allowConversion Boolean          @default(true)
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  laundryCrmLeads LaundryCrmLead[]

  @@index([businessId])
}

model LaundryCrmLeadSource {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  color           String           @default("#64748B")
  displayOrder    Int              @default(0)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  laundryCrmLeads LaundryCrmLead[]

  @@index([businessId])
}

model LaundryCrmSalesStage {
  id                      String                  @id @default(cuid())
  businessId              String
  name                    String
  color                   String                  @default("#2563EB")
  displayOrder            Int                     @default(0)
  active                  Boolean                 @default(true)
  probability             Int                     @default(0) // 0-100
  stageType               String                  @default("OPEN") // OPEN | WON | LOST — behaviour key (never match on name)
  isInitial               Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  laundryCrmOpportunities LaundryCrmOpportunity[]

  @@index([businessId])
}

model LaundryCrmLostReason {
  id                      String                  @id @default(cuid())
  businessId              String
  name                    String
  displayOrder            Int                     @default(0)
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  laundryCrmOpportunities LaundryCrmOpportunity[]

  @@index([businessId])
}

model LaundryCrmActivityType {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}

model LaundryCrmLead {
  id             String    @id @default(cuid())
  leadCode       String    @unique // LED-CRM-YYYYMM-NNNNNN
  businessId     String
  statusId       String?
  sourceId       String?
  // Promoted system-field values (indexed search); full values live in fieldValues.
  displayName    String    @default("")
  phone          String?
  email          String?
  fieldValues    String    @default("{}") // JSON { fieldKey: value }
  assignedToId   String?
  assignedToName String?
  converted      Boolean   @default(false)
  convertedAt    DateTime?
  archived       Boolean   @default(false)
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  status      LaundryCrmLeadStatus?  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  source      LaundryCrmLeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  opportunity LaundryCrmOpportunity?
  activities  LaundryCrmActivity[]
  tasks       LaundryCrmTask[]
  events      LaundryCrmEvent[]

  @@index([businessId])
  @@index([businessId, statusId])
  @@index([businessId, sourceId])
  @@index([businessId, assignedToId])
  @@index([businessId, createdAt])
  @@index([businessId, archived])
}

model LaundryCrmOpportunity {
  id                String    @id @default(cuid())
  oppCode           String    @unique // OPP-CRM-YYYYMM-NNNNNN
  businessId        String
  leadId            String    @unique // one primary opportunity per lead
  name              String
  stageId           String?
  value             Float     @default(0)
  probability       Int?
  expectedCloseDate DateTime?
  state             String    @default("OPEN") // OPEN | WON | LOST — derived from stageType on move
  stageEnteredAt    DateTime  @default(now())
  wonAt             DateTime?
  wonValue          Float?
  lostAt            DateTime?
  lostReasonId      String?
  lostNotes         String?
  notes             String?
  assignedToId      String?
  assignedToName    String?
  createdById       String?
  createdByName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lead         LaundryCrmLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage        LaundryCrmSalesStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  lostReason   LaundryCrmLostReason?    @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  stageHistory LaundryCrmStageHistory[]
  activities   LaundryCrmActivity[]
  tasks        LaundryCrmTask[]
  events       LaundryCrmEvent[]

  @@index([businessId])
  @@index([businessId, stageId])
  @@index([businessId, state])
  @@index([businessId, assignedToId])
  @@index([businessId, expectedCloseDate])
  @@index([businessId, createdAt])
}

model LaundryCrmStageHistory {
  id            String   @id @default(cuid())
  businessId    String
  opportunityId String
  fromStageId   String?
  fromStageName String?
  toStageId     String
  toStageName   String
  durationMs    Float? // time spent in the previous stage
  changedById   String?
  changedByName String?
  createdAt     DateTime @default(now())

  opportunity LaundryCrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([opportunityId])
  @@index([createdAt])
}

model LaundryCrmActivity {
  id             String   @id @default(cuid())
  actCode        String   @unique // ACT-CRM-YYYYMM-NNNNNN
  businessId     String
  leadId         String?
  opportunityId  String?
  type           String   @default("GENERAL") // matches LaundryCrmActivityType.name at creation time
  subject        String
  description    String?
  outcome        String?
  activityAt     DateTime @default(now())
  assignedToId   String?
  assignedToName String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  lead        LaundryCrmLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity LaundryCrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([businessId, activityAt])
}

model LaundryCrmTask {
  id             String    @id @default(cuid())
  taskCode       String    @unique // TSK-CRM-YYYYMM-NNNNNN
  businessId     String
  leadId         String?
  opportunityId  String?
  title          String
  description    String?
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status         String    @default("OPEN") // OPEN | COMPLETED | CANCELLED
  dueAt          DateTime?
  assignedToId   String?
  assignedToName String?
  createdById    String?
  createdByName  String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead        LaundryCrmLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity LaundryCrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, dueAt])
  @@index([leadId])
  @@index([opportunityId])
}

// System timeline events (created/updated/status-changed/assigned/converted/…).
// Mirrors the LaundryOrderEvent pattern.
model LaundryCrmEvent {
  id            String   @id @default(cuid())
  businessId    String
  leadId        String?
  opportunityId String?
  kind          String // LEAD_CREATED | LEAD_UPDATED | STATUS_CHANGED | ASSIGNED | CONVERTED | STAGE_CHANGED | WON | LOST | NOTE | TASK_CREATED | TASK_COMPLETED | …
  label         String
  meta          String? // JSON details
  actorId       String?
  actorName     String?
  createdAt     DateTime @default(now())

  lead        LaundryCrmLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity LaundryCrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt])
}

// ── Package / Packet — persistent identity for store ⇄ processing transport ──
// ONE packet per order (enforced by the unique orderId): the store packs the
// audited order into a single package whose QR resolves to packetNumber.
// Covers both legs: store → processing center and the return to store.
model LaundryPacket {
  id                 String    @id @default(cuid())
  packetNumber       String    @unique // PKT-{orderNumber}
  businessId         String
  storeId            String
  orderId            String    @unique
  status             String    @default("PACKED") // PACKED | IN_TRANSIT_TO_PC | AT_PROCESSING_CENTER | RETURN_IN_TRANSIT | RETURNED_TO_STORE
  qrValue            String // stable QR payload = packetNumber
  itemCount          Int       @default(0)
  packedBy           String?
  packedAt           DateTime  @default(now())
  dispatchedBy       String?
  dispatchedAt       DateTime?
  dispatchNote       String?
  receivedBy         String?
  receivedAt         DateTime?
  receiveNote        String?
  returnDispatchedBy String?
  returnDispatchedAt DateTime?
  returnReceivedBy   String?
  returnReceivedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([packetNumber])
}

// ── Service ↔ garment-Category compatibility (catalogue selection rule) ──────
// Which garment categories are "compatible" with a service, so the Add Garments
// dialog defaults to relevant garments (e.g. Blanket Cleaning → Bedding /
// Household). This is a SELECTION rule only — it never affects the actual
// Service↔Garment pricing (LaundryPricingRule), orders, or processing routes.
// A service with NO rows falls back to "show all garments" (backward-compat).
model LaundryServiceGarmentCategory {
  id         String   @id @default(cuid())
  businessId String
  serviceId  String
  categoryId String
  createdAt  DateTime @default(now())

  service  LaundryService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category LaundryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([serviceId, categoryId])
  @@index([businessId])
  @@index([serviceId])
  @@index([categoryId])
}

// ============================================================================
// COMMERCE TEMPLATE ENGINE (Phase 1 foundation)
// Platform-owned storefront template domain. Master templates belong to Quantix
// Core; tenants edit an isolated CommerceTenantTemplate instance. Catalogue data
// is NEVER copied into template config — sections carry only presentation +
// dataSource config and the storefront resolves live catalogue per tenant.
// SQLite: JSON payloads stored as String (existing convention).
// ============================================================================

// Master template (Quantix Core owned). Scoped to a Commerce business category
// (Business.businessType, e.g. GROCERY | ECOMMERCE | MEAT_DELIVERY). Never
// tenant-editable.
model CommerceTemplate {
  id                      String    @id @default(cuid())
  code                    String    @unique // stable key, e.g. "grocery-fresh"
  name                    String
  description             String?
  workspaceType           String    @default("COMMERCE") // PlatformProduct.code
  businessCategory        String // Business.businessType this template targets
  templateType            String    @default("STOREFRONT")
  thumbnailUrl            String?
  previewUrl              String?
  status                  String    @default("DRAFT") // DRAFT | ACTIVE | INACTIVE | ARCHIVED
  isDefault               Boolean   @default(false) // convenience flag; authoritative default is CommerceCategoryDefault
  version                 Int       @default(1) // draft content version (increments on publish-worthy edits)
  // ── Master content publish lifecycle (separate from operational `status`) ──
  // Pages/sections are the editable DRAFT working content; publishing snapshots
  // them into publishedConfig with previousPublishedConfig kept for rollback.
  publishedVersion        Int       @default(0)
  publishedAt             DateTime?
  publishedConfig         String? // JSON snapshot of published pages/sections tree
  previousPublishedConfig String? // prior published snapshot (rollback safety)
  createdBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  pages            CommerceTemplatePage[]
  assignments      CommerceTemplateAssignment[]
  categories       CommerceTemplateCategory[]
  categoryDefaults CommerceCategoryDefault[]

  @@index([workspaceType, businessCategory])
  @@index([status])
  @@index([businessCategory, isDefault])
}

model CommerceTemplatePage {
  id         String   @id @default(cuid())
  templateId String
  name       String
  slug       String // unique within a template
  pageType   String   @default("CUSTOM") // HOME | CATEGORIES | PRODUCTS | PRODUCT_DETAIL | OFFERS | ABOUT | CONTACT | CUSTOM
  route      String? // storefront route
  sortOrder  Int      @default(0)
  isHomePage Boolean  @default(false)
  status     String   @default("DRAFT") // DRAFT | ACTIVE
  seoConfig  String? // JSON { title, description, ogImage, … }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template CommerceTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sections CommerceTemplateSection[]

  @@unique([templateId, slug])
  @@index([templateId])
}

model CommerceTemplateSection {
  id               String   @id @default(cuid())
  pageId           String
  sectionType      String // registry key: HEADER | HERO | CATEGORY_GRID | PRODUCT_GRID | IMAGE_BANNER | TEXT_BLOCK | CTA | FOOTER | …
  sectionKey       String? // stable instance key for overrides
  sortOrder        Int      @default(0)
  layoutConfig     String? // JSON: width, columns, alignment, spacing, responsive
  styleConfig      String? // JSON: colors, typography, background (brand tokens)
  visibilityConfig String? // JSON: desktop/tablet/mobile visibility
  dataSourceConfig String? // JSON: catalogue data source (mode + ids) — NEVER copied data
  contentConfig    String? // JSON: text, images, CTA, section-specific content
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  page CommerceTemplatePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

// Template → business/store assignment (platform-controlled). Resolution
// priority: store override → business assignment → category default → neutral
// Commerce fallback (see lib/commerce/template-resolver).
model CommerceTemplateAssignment {
  id         String   @id @default(cuid())
  templateId String
  businessId String
  storeId    String? // optional store-specific override
  assignedBy String?
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template CommerceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([businessId, storeId])
  @@index([businessId])
  @@index([templateId])
}

// Tenant-owned editable instance of an assigned template. Tenant edits are
// isolated here and NEVER mutate the master CommerceTemplate. The live
// storefront renders publishedConfig only.
model CommerceTenantTemplate {
  id                    String    @id @default(cuid())
  businessId            String
  storeId               String?
  sourceTemplateId      String // the master template this was instantiated from
  sourceTemplateVersion Int       @default(1)
  status                String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedVersion      Int       @default(0)
  draftConfig           String? // JSON: full page/section tree (tenant working copy)
  publishedConfig       String? // JSON: last published tree — the live storefront source
  previousPublished     String? // JSON: prior published tree (rollback safety)
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([businessId, storeId])
  @@index([businessId])
  @@index([sourceTemplateId])
}

// Template ↔ business-category compatibility (many-to-many). A template may be
// compatible with more than one Commerce category. `businessCategory` values
// are Business.businessType (the authoritative category vocabulary).
model CommerceTemplateCategory {
  id               String   @id @default(cuid())
  templateId       String
  businessCategory String
  createdAt        DateTime @default(now())

  template CommerceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, businessCategory])
  @@index([businessCategory])
}

// Authoritative category default template (one per workspaceType+category).
// Changing this never touches explicit business assignments or tenant instances.
model CommerceCategoryDefault {
  id               String   @id @default(cuid())
  workspaceType    String   @default("COMMERCE")
  businessCategory String
  templateId       String
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  template CommerceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([workspaceType, businessCategory])
  @@index([templateId])
}

// ============================================================================
// QUANTIX MARKETING ENGINE — Phase 1 (Vouchers/Coupons).
// Additive, business-scoped, workspace-agnostic. Reuses existing Customer /
// Cart / Order / Pricing engines — the Marketing layer only DECIDES a benefit
// and records issuance/redemption. See docs/QUANTIX_MARKETING_ENGINE_STANDARD.md.
// `businessId` is a plain scoped key (no relation) so existing models are
// untouched. Gated per business by the existing feature-toggle ("MARKETING").
// ============================================================================
model Promotion {
  id                 String    @id @default(cuid())
  businessId         String // platform Business id (scoped; no relation — additive)
  workspaceType      String? // LAUNDRY | COMMERCE | ... (null = all workspaces)
  kind               String    @default("VOUCHER") // DISCOUNT | VOUCHER
  title              String
  description        String?
  code               String? // manual coupon code (unique per business when set)
  discountType       String    @default("PERCENT") // FIXED | PERCENT
  discountValue      Float     @default(0)
  maxDiscount        Float? // cap for PERCENT
  minOrderValue      Float? // order condition
  status             String    @default("DRAFT") // DRAFT|SCHEDULED|ACTIVE|PAUSED|EXPIRED|CANCELLED
  enabled            Boolean   @default(true) // feature-flag / quick on-off
  startAt            DateTime?
  endAt              DateTime?
  maxUses            Int? // global cap (null = unlimited)
  maxUsesPerCustomer Int?
  usedCount          Int       @default(0)
  applyTo            String    @default("[\"ORDER\"]") // JSON: ORDER|SUBSCRIPTION_PURCHASE|SUBSCRIPTION_RENEWAL
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  rules       PromotionRule[]
  redemptions PromotionRedemption[]

  @@index([businessId])
  @@index([businessId, code])
  @@index([businessId, status])
}

// Data-driven eligibility rule (fact/op/value) — NO hardcoded promo logic.
model PromotionRule {
  id          String @id @default(cuid())
  promotionId String
  fact        String // firstOrder|orderValue|customerTier|customerTags|mobile|email|subscriptionActive|...
  op          String // eq|neq|gt|gte|lt|lte|in|contains|isTrue|isFalse
  value       String // JSON-encoded comparison value

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
}

// Append-only issuance / redemption ledger — the single source for reports and
// per-customer limits. Laundry redemptions sit at PENDING_AUDIT until the
// invoice finalizes them; commerce goes straight to APPLIED.
model PromotionRedemption {
  id          String   @id @default(cuid())
  promotionId String
  businessId  String
  customerId  String?
  orderId     String?
  status      String   @default("APPLIED") // HELD|APPLIED|PENDING_AUDIT|FINALIZED|REVERSED
  amount      Float    @default(0) // discount amount (0 while pending)
  workspaceType String?
  meta        String? // JSON snapshot (code, orderValue, applyTo)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([businessId])
  @@index([customerId])
  @@index([orderId])
  @@index([businessId, status])
}

// ============================================================================
// PICKUP-FIRST tracking (additive). One Order → one/more Pickup Bags (one per
// service, QR at pickup) → one/more Processing Packages (QR after Store Audit)
// → one Invoice. Reuses the existing order/audit/pricing/invoice engines; these
// tables only track the physical bags/packages + their QR + status. `orderId`
// is a plain scoped key (no relation) so LaundryOrder is untouched.
// See the Pickup-First service mode ([[laundry-pickup-first-bag-mode]]).
// ============================================================================
model LaundryPickupBag {
  id              String    @id @default(cuid())
  code            String    @unique // PB-YYYYMM-NNNNNN
  qrValue         String // stable QR payload = code
  businessId      String
  orderId         String
  orderNumber     String?
  serviceId       String?
  serviceName     String
  customerId      String?
  customerName    String?
  pickupDate      DateTime?
  pickupExecutive String?
  status          String    @default("COLLECTED") // COLLECTED | RECEIVED_AT_STORE | AUDITED
  collectedAt     DateTime  @default(now())
  receivedAt      DateTime?
  receivedBy      String?
  auditedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId])
  @@index([orderId])
  @@index([businessId, status])
  @@index([code])
}

model LaundryProcessingPackage {
  id            String    @id @default(cuid())
  code          String    @unique // PKG-YYYYMM-NNNNNN (or reused Pickup Bag code)
  qrValue       String
  businessId    String
  orderId       String
  orderNumber   String?
  pickupBagId   String? // parent bag when generated from a pickup bag
  serviceId     String?
  serviceName   String?
  garmentCount  Int       @default(0)
  weightKg      Float     @default(0)
  reusedBagQr   Boolean   @default(false) // tenant setting: reuse the Pickup Bag QR
  status        String    @default("CREATED") // CREATED | IN_PROCESSING | QC | READY | RETURNED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessId])
  @@index([orderId])
  @@index([code])
}
