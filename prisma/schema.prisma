// Generated Offer Letter — rendered content after merge tag substitution
model OfferLetter {
  id               String               @id @default(cuid())
  offerRef         String?
  templateId       String?
  employeeId       String?
  candidateName    String
  candidateEmail   String?
  candidateMobile  String?
  designation      String
  joiningDate      DateTime?
  department       String?
