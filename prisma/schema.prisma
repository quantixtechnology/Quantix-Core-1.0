// ============================================================================
// QUANTIX CORE PLATFORM — Managed White-Label Multi-Tenant SaaS
// "Run Your Business Smarter" — www.quantixtechnology.in
//
// BUSINESS MODEL (FINAL):
//   - NO free trial, NO self-signup, NO self-onboarding, NO public creation
//   - 2 plans: STANDARD (₹2,999/mo, ₹30,000/yr) and PRO (₹4,999/mo, ₹49,999/yr)
//   - ₹1,999 implementation charge for both plans
//   - Super Admin can override pricing per customer
//   - Lead → Demo → Negotiation → Payment → Onboarding → Deployment → Active
//   - Demo credentials given first; tenant created ONLY after payment verified
//   - Business owners CANNOT create businesses — only Quantix team does
//   - Quantix controls: deployment, domains, branding, onboarding, app activation
//
// ARCHITECTURE — PRODUCT/SERVICE WORKFLOW ENGINE:
//   The platform does NOT design around business types.
//   Instead, each CATEGORY/PRODUCT/SERVICE gets assigned a WORKFLOW TYPE.
//   Within the SAME business, different products can use different workflows.
//
//   Example: Car Wash Business:
//     - Subscription Wash → Subscription Workflow
//     - Pickup Wash → Pickup Workflow
//     - Accessories → Ecommerce Workflow
//     - Appointment Wash → Appointment Workflow
//
//   5 Supported Workflow Types:
//     1. ECOMMERCE — cart → checkout → payment → delivery
//     2. PICKUP_DELIVERY — pickup scheduling → delivery scheduling → assignment → return
//     3. APPOINTMENT — date/time booking → technician assignment → slot management
//     4. SUBSCRIPTION — package purchase → credit tracking → usage deduction → renewal
//     5. POST_SERVICE_BILLING — estimated pricing → inspection → final billing → approval → delayed payment
//
//   ALL workflows reuse: same backend, auth, inventory, notifications, POS, delivery, deployment
//
// EXTENSIBILITY:
//   - BusinessModule table tracks which modules a business has enabled
//   - Category/Product.workflowType determines the workflow for each item
//   - OrderItem uses itemType/itemId (polymorphic) so any workflow's items
//     can be added to an order without core knowing about them
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SECTION 1: PLATFORM CONFIG
// ============================================================================

model PlatformConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String   // JSON string for complex configs
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// SECTION 2: LEAD LIFECYCLE — The ONLY way businesses enter the platform
// No self-signup. Every business starts as a Lead managed by Quantix Sales.
//
// FLOW: LEAD → DEMO_SHARED → NEGOTIATION → PAYMENT_PENDING → PAYMENT_RECEIVED
//       → ONBOARDING → DEPLOYMENT → ACTIVE
// ============================================================================

enum LeadSource {
  META_ADS
  GOOGLE_ADS
  DIRECT_REFERRAL
  WEBSITE_INQUIRY
  COLD_OUTREACH
  WHATSAPP_INQUIRY
  PHONE_CALL
  OTHER
}

enum LeadStage {
  LEAD
  DEMO_SHARED
  NEGOTIATION
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  ONBOARDING
  DEPLOYMENT
  ACTIVE
  LOST
  CHURNED
}

model Lead {
  id              String     @id @default(cuid())
  salesRepId      String?
  businessName    String
  contactName     String
  contactEmail    String
  contactPhone    String
  businessType    BusinessType
  source          LeadSource @default(WEBSITE_INQUIRY)
  stage           LeadStage  @default(LEAD)
  // Demo tracking
  demoTenantId    String?    // Link to shared demo tenant when stage >= DEMO_SHARED
  demoSharedAt    DateTime?
  demoCredentials String?    // JSON: { email, password, url }
  demoFeedback    String?
  // Negotiation
  negotiatedMonthlyPrice Float?  // Super Admin override — can differ from plan price
  negotiatedYearlyPrice  Float?
  negotiationNotes String?
  // Payment
  paymentProof     String?   // URL to uploaded payment proof
  paymentVerifiedAt DateTime?
  paymentVerifiedBy String?  // Super Admin who verified
  selectedBillingCycle String? // "monthly" or "yearly"
  // Conversion
  convertedBusinessId String?
  convertedAt      DateTime?
  // Lost/churn reason
  lostReason       String?
  // General
  notes           String?
  followUpDate    DateTime?
  estimatedValue  Float?
  tags            String    @default("[]")
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  salesRep        SalesTeamMember? @relation(fields: [salesRepId], references: [id])

  @@index([salesRepId])
  @@index([stage])
  @@index([source])
  @@index([createdAt])
}

// ============================================================================
// SECTION 3: DEMO TENANT — Shared demo environment for prospects
// Quantix creates demo tenants with sample data.
// Prospects receive demo credentials (no real tenant created yet).
// ============================================================================

enum DemoTenantStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DISABLED
}

model DemoTenant {
  id              String           @id @default(cuid())
  name            String           // "Demo - Grocery Store"
  slug            String           @unique // "demo-grocery-1"
  businessType    BusinessType
  status          DemoTenantStatus @default(AVAILABLE)
  // Access credentials (shared — reset after each use)
  accessEmail     String
  accessPassword  String           // Hashed
  accessUrl       String?          // e.g., https://demo-grocery.quantixtechnology.in
  // Current prospect
  currentLeadId   String?
  currentLeadName String?
  sessionStartedAt DateTime?
  sessionExpiresAt DateTime?
  // Sample data config
  sampleDataConfig String          @default("{}") // JSON: what demo data to include
  resetAfterUse   Boolean          @default(true)
  lastResetAt     DateTime?
  // Metadata
  description     String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([businessType])
  @@index([status])
}

// ============================================================================
// SECTION 4: TENANT (BUSINESS) — Created ONLY by Quantix Super Admin
// AFTER payment verification. No public creation. No self-signup.
// ============================================================================

enum BusinessType {
  GROCERY
  FOOD_DELIVERY
  LAUNDRY
  CAR_WASH
  PHARMACY
  HOME_SERVICES
  ECOMMERCE
  COSMETICS
  MEAT_DELIVERY
  FURNITURE
  DIRECTORY
}

// ============================================================================
// WORKFLOW TYPE — Assigned per Category/Product/Service, NOT per business
// ============================================================================

enum WorkflowType {
  ECOMMERCE              // cart → checkout → payment → delivery
  PICKUP_DELIVERY        // pickup scheduling → delivery scheduling → assignment → return delivery
  APPOINTMENT            // date/time booking → technician assignment → slot management
  SUBSCRIPTION           // package purchase → credit tracking → usage deduction → renewal reminders
  POST_SERVICE_BILLING   // estimated pricing → inspection/weight → final billing → customer approval → delayed payment
}

enum BusinessStatus {
  ONBOARDING    // Being set up by Quantix team after payment
  ACTIVE        // Fully operational
  SUSPENDED     // Payment issue or policy violation
  CHURNED       // Left the platform
}

model Business {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  businessType      BusinessType
  status            BusinessStatus @default(ONBOARDING)
  // Origin — every business comes from a paid lead
  leadId            String?        // The Lead that converted to this business
  // Branding (configured by Quantix ONLY)
  logo              String?
  favicon           String?
  primaryColor      String         @default("#10B981")
  secondaryColor    String?
  darkMode          Boolean        @default(false)
  // Business details
  tagline           String?
  description       String?
  gstNumber         String?
  panNumber         String?
  cinNumber         String?
  fssaiLicense      String?
  // Address
  address           String?
  city              String?
  state             String?
  pincode           String?
  country           String         @default("India")
  latitude          Float?
  longitude         Float?
  // Contact
  contactEmail      String?
  contactPhone      String?
  supportEmail      String?
  supportPhone      String?
  // Configuration
  defaultCurrency   String         @default("INR")
  defaultLocale     String         @default("en-IN")
  timezone          String         @default("Asia/Kolkata")
  isOnline          Boolean        @default(false) // Quantix activates after deployment
  // JSON configuration blobs
  settings          String         @default("{}")
  features          String         @default("{}")  // Feature flags — controlled by Quantix
  notificationConfig String        @default("{}")
  // Timestamps — NO trial fields. Business is born from payment.
  onboardedAt       DateTime?      // When onboarding was completed
  activatedAt       DateTime?      // When Quantix activated the business
  suspendedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  businessUsers     BusinessUser[]
  modules           BusinessModule[]
  stores            Store[]
  orders            Order[]
  customers         Customer[]
  deliveryZones     DeliveryZone[]
  deliveryPartners  DeliveryPartner[]
  taxConfigs        TaxConfig[]
  invoices          Invoice[]
  posSessions       POSSession[]
  promoCodes        PromoCode[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  businessSubscription BusinessSubscription?
  domain            DomainMapping?
  deployments       Deployment[]
  salesRepId        String?
  salesRep          SalesTeamMember? @relation("SalesRepClients", fields: [salesRepId], references: [id])
  paymentGateways   PaymentGateway[]
  gatewayAccess     BusinessGatewayAccess[]
  payments          Payment[]
  subscriptionPlans SubscriptionPlan[]
  customerSubscriptions CustomerSubscription[]
  categories        Category[]
  products          Product[]
  onboardingSteps   OnboardingStep[]

  @@index([businessType])
  @@index([status])
  @@index([salesRepId])
}

// ============================================================================
// SECTION 5: ONBOARDING TRACKER — Quantix-controlled onboarding steps
// ============================================================================

enum OnboardingStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model OnboardingStep {
  id          String              @id @default(cuid())
  businessId  String
  stepKey     String              // "branding", "stores", "products", "payment_gateway", "delivery_zones", etc.
  stepName    String
  status      OnboardingStepStatus @default(PENDING)
  completedBy String?             // Quantix team member who completed this step
  completedAt DateTime?
  notes       String?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, stepKey])
  @@index([businessId])
  @@index([status])
}

// ============================================================================
// SECTION 6: BUSINESS MODULE REGISTRY — Extensibility System
// ============================================================================

enum ModuleStatus {
  DISABLED
  ENABLED
}

model BusinessModule {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  moduleKey     String       // "grocery", "restaurant", "pharmacy", "car_wash", etc.
  moduleName    String       // Display name
  version       String       @default("1.0.0")
  status        ModuleStatus @default(DISABLED)
  config        String       @default("{}")  // Module-specific config (JSON)
  enabledAt     DateTime?
  disabledAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([businessId, moduleKey])
  @@index([businessId])
  @@index([moduleKey])
  @@index([status])
}

// ============================================================================
// SECTION 7: STORES (Multi-Store per Business)
// ============================================================================

enum StoreStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Store {
  id              String       @id @default(cuid())
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  code            String?      // Short code for POS
  // Address
  address         String?
  city            String?
  state           String?
  pincode         String?
  country         String       @default("India")
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  status          StoreStatus  @default(ACTIVE)
  isMainStore     Boolean      @default(false)
  // Delivery configuration
  deliveryRadius  Float        @default(5.0)
  minOrderAmount  Float        @default(0)
  deliveryFee     Float        @default(0)
  freeDeliveryAbove Float?
  maxDeliveryDistance Float?    @default(10.0)
  preparationTime Int          @default(30)
  // Operating hours
  operatingHours  String       @default("{}")
  // POS & Printer config
  posEnabled      Boolean      @default(true)
  printerConfig   String       @default("{}")
  printerType     String?      // thermal_bluetooth, thermal_usb, laser
  paperSize       String       @default("80mm") // 58mm, 80mm, A4
  // GST
  gstNumber       String?
  // Settings
  settings        String       @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  inventory       Inventory[]
  orders          Order[]
  posSessions     POSSession[]
  staff           BusinessUser[]
  storeTimings    StoreTiming[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([status])
}

model StoreTiming {
  id        String   @id @default(cuid())
  storeId   String
  day       Int      // 0=Sunday ... 6=Saturday
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@index([storeId])
}

// ============================================================================
// SECTION 8: USERS & AUTHENTICATION
// Auth: Email OTP, WhatsApp OTP, Push Notification — NO SMS
// No self-signup for business owners. Only customers can self-register.
// Business team members are invited by Quantix or Client Owner.
// ============================================================================

enum AuthProvider {
  EMAIL_OTP
  WHATSAPP_OTP
  PUSH_NOTIFICATION
  GOOGLE
  PASSWORD
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  phone           String?
  name            String
  avatar          String?
  passwordHash    String?
  authProvider    AuthProvider @default(EMAIL_OTP)
  emailVerified   Boolean      @default(false)
  phoneVerified   Boolean      @default(false)
  isActive        Boolean      @default(true)
  fcmToken        String?
  lastLoginAt     DateTime?
  metadata        String       @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  businessUsers   BusinessUser[]
  customerProfiles Customer[]
  deliveryProfiles DeliveryPartner[]
  otpCodes        OTPCode[]
  refreshTokens   RefreshToken[]
  activityLogs    ActivityLog[]
  salesProfile    SalesTeamMember?
  customerNotes   CustomerNote[]
}

model OTPCode {
  id          String       @id @default(cuid())
  userId      String?
  email       String?
  phone       String?
  code        String       // 6-digit OTP
  channel     AuthProvider // EMAIL_OTP, WHATSAPP_OTP, PUSH_NOTIFICATION
  isVerified  Boolean      @default(false)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([code])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ============================================================================
// SECTION 9: ROLES & PERMISSIONS
// 6 roles. CLIENT_OWNER is invited — cannot create businesses.
// ============================================================================

enum Role {
  QUANTIX_SUPER_ADMIN    // Full platform control, creates businesses, overrides pricing
  QUANTIX_SALES_TEAM     // Manages leads, demos, negotiations
  CLIENT_OWNER           // Business owner — invited after payment, CANNOT create businesses
  STORE_MANAGER          // Manages store operations
  DELIVERY_STAFF         // Handles deliveries
  CUSTOMER               // End customer — only self-registerable role
}

enum CustomerPermission {
  VIEW_CUSTOMERS
  EDIT_CUSTOMERS
  DELETE_CUSTOMERS
  EXPORT_CUSTOMERS
  EDIT_LOYALTY
  VIEW_ORDERS
  EDIT_ORDERS
  VIEW_REVENUE
}

model BusinessUser {
  id           String   @id @default(cuid())
  userId       String
  businessId   String
  role         Role
  storeId      String?
  permissions  String   @default("[]") // JSON array of CustomerPermission
  isActive     Boolean  @default(true)
  invitedAt    DateTime?  // Invited by Quantix or Client Owner
  acceptedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store      Store?   @relation(fields: [storeId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([role])
}

// ============================================================================
// SECTION 10: ORDERS (CORE — Polymorphic OrderItem)
// ============================================================================

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
  POS
  SUBSCRIPTION
  PICKUP_AND_DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  SCHEDULED
  PICKUP_ASSIGNED
  PICKED_UP
  PROCESSING
  READY_FOR_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CASH
  CARD
  UPI
  NETBANKING
  WALLET
  COD
  CREDIT
  MIXED
}

model Order {
  id              String        @id @default(cuid())
  businessId      String
  storeId         String
  orderNumber     String
  orderType       OrderType
  orderSource     String        @default("online")
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethodType?
  // Customer info
  customerId      String?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  // Delivery
  deliveryAddressId String?
  deliveryAddress  String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryInstructions String?
  scheduledAt     DateTime?
  // Pickup
  pickupAddress   String?
  pickupScheduledAt DateTime?
  pickupCompletedAt DateTime?
  // Billing
  subtotal        Float         @default(0)
  totalDiscount   Float         @default(0)
  totalTax        Float         @default(0)
  deliveryFee     Float         @default(0)
  packagingFee    Float         @default(0)
  convenienceFee  Float         @default(0)
  tip             Float         @default(0)
  roundOff        Float         @default(0)
  totalAmount     Float         @default(0)
  // GST
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  cessAmount      Float         @default(0)
  // POS
  posSessionId    String?
  posOperatorId   String?
  tableNumber     String?
  // Subscription
  subscriptionId  String?
  // Promo
  promoCodeId     String?
  // Pickup & Delivery specific
  pickupPartnerId String?
  deliveryPartnerId String?
  deliveryOtp     String?
  pickupOtp       String?
  // Metadata
  notes           String?
  cancelReason    String?
  metadata        String        @default("{}")
  confirmedAt     DateTime?
  preparedAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store           Store         @relation(fields: [storeId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  delivery        Delivery?
  invoice         Invoice?
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  posSession      POSSession?   @relation(fields: [posSessionId], references: [id])
  customerSubscription CustomerSubscription? @relation(fields: [subscriptionId], references: [id])
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id])

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderType])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  itemType            String   // Polymorphic: "grocery_product", "menu_item", etc.
  itemId              String
  itemName            String
  variantName         String?
  sku                 String?
  barcode             String?
  quantity            Float
  unitPrice           Float
  mrp                 Float?
  discountPrice       Float?
  discountPercent     Float?
  totalPrice          Float
  totalMrp            Float?
  gstRate             Float    @default(0)
  gstAmount           Float    @default(0)
  cgstAmount          Float    @default(0)
  sgstAmount          Float    @default(0)
  igstAmount          Float    @default(0)
  specialInstructions String?
  customizations      String?
  isVeg               Boolean?
  unit                String?
  metadata            String   @default("{}")
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemType])
  @@index([itemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ============================================================================
// SECTION 11: DELIVERY CORE
// ============================================================================

enum DeliveryStatus {
  ASSIGNING
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
}

enum ZoneType {
  CIRCLE
  POLYGON
  PINCODE
}

model Delivery {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  deliveryPartnerId   String?
  pickupPartnerId     String?
  status              DeliveryStatus @default(ASSIGNING)
  pickupLat           Float?
  pickupLng           Float?
  pickupAddress       String?
  dropLat             Float?
  dropLng             Float?
  dropAddress         String?
  estimatedPickupTime DateTime?
  estimatedDeliveryTime DateTime?
  actualPickupTime    DateTime?
  actualDeliveryTime  DateTime?
  distance            Float?
  deliveryOtp         String?
  pickupOtp           String?
  rating              Int?
  feedback            String?
  cancelReason        String?
  liveTracking        String         @default("[]")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner     DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])

  @@index([deliveryPartnerId])
  @@index([status])
}

model DeliveryZone {
  id              String    @id @default(cuid())
  businessId      String
  storeId         String?
  name            String
  zoneType        ZoneType
  centerLat       Float?
  centerLng       Float?
  radius          Float?
  polygon         String?
  pincodes        String?
  deliveryFee     Float     @default(0)
  minOrderAmount  Float     @default(0)
  freeDeliveryAbove Float?
  estimatedTime   Int       @default(30)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([storeId])
}

model DeliveryPartner {
  id              String   @id @default(cuid())
  businessId      String
  userId          String?
  name            String
  phone           String
  email           String?
  avatar          String?
  vehicleType     String?
  vehicleNumber   String?
  licenseNumber   String?
  isOnline        Boolean  @default(false)
  isActive        Boolean  @default(true)
  currentLat      Float?
  currentLng      Float?
  rating          Float    @default(0)
  totalDeliveries Int      @default(0)
  totalEarnings   Float    @default(0)
  fcmToken        String?
  bankAccount     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id])
  deliveries      Delivery[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([isOnline])
}

// ============================================================================
// SECTION 12: POS CORE
// ============================================================================

enum POSSessionStatus {
  OPEN
  CLOSED
  SUSPENDED
}

model POSSession {
  id              String          @id @default(cuid())
  businessId      String
  storeId         String
  sessionNumber   String
  operatorId      String
  status          POSSessionStatus @default(OPEN)
  openingBalance  Float           @default(0)
  closingBalance  Float?
  totalSales      Float           @default(0)
  totalCash       Float           @default(0)
  totalCard       Float           @default(0)
  totalUpi        Float           @default(0)
  totalOther      Float           @default(0)
  totalRefunds    Float           @default(0)
  totalOrders     Int             @default(0)
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [storeId], references: [id])
  orders          Order[]

  @@index([businessId])
  @@index([storeId])
  @@index([status])
}

// ============================================================================
// SECTION 13: PAYMENTS
// ============================================================================

model Payment {
  id                  String          @id @default(cuid())
  orderId             String
  businessId          String
  amount              Float
  currency            String          @default("INR")
  method              PaymentMethodType
  status              PaymentStatus   @default(PENDING)
  gatewayTransactionId String?
  gatewayName         String?
  gatewayResponse     String?
  refundAmount        Float?
  refundStatus        String?
  refundedAt          DateTime?
  paidAt              DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([businessId])
  @@index([status])
}

model PaymentGateway {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  gateway         String
  isActive        Boolean  @default(true)
  isTestMode      Boolean  @default(true)
  config          String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

// ============================================================================
// PLATFORM PAYMENT PLUGIN REGISTRY (Super Admin controlled)
// Controls which payment gateways are available globally and per business.
// ============================================================================

model PlatformPaymentPlugin {
  id                  String   @id @default(cuid())
  gateway             String   @unique  // "razorpay" | "phonepe" | "paytm" etc.
  displayName         String            // "Razorpay", "PhonePe Business"
  description         String?
  isGloballyEnabled   Boolean  @default(false)
  supportedMethods    String   @default("[]")   // JSON: ["UPI","CARD","NETBANKING"]
  configSchema        String   @default("{}")   // JSON schema for credential fields
  webhookPath         String?
  docsUrl             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  businessAccess      BusinessGatewayAccess[]
}

// Per-business gateway assignment and permission control (Super Admin sets this)
model BusinessGatewayAccess {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pluginId      String
  plugin        PlatformPaymentPlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  isAssigned    Boolean  @default(false)   // Super Admin assigned gateway to this business
  canConfigure  Boolean  @default(false)   // Business Owner can edit credentials
  isActive      Boolean  @default(false)   // Business has activated this gateway
  config        String   @default("{}")    // Admin-provided config when canConfigure=false
  notes         String?
  assignedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, pluginId])
  @@index([businessId])
  @@index([pluginId])
}

// ============================================================================
// SECTION 14: SUBSCRIPTION ENGINE (Platform → Business)
// ONLY 2 fixed plans: ₹4,999/mo and ₹49,999/yr
// Super Admin can override pricing per customer.
// NO trial. Business is created ONLY after payment is verified.
// ============================================================================

enum PlanTier {
  STANDARD    // ₹2,999/mo, ₹30,000/yr — Ecommerce workflow, Standard POS, Delivery
  PRO         // ₹4,999/mo, ₹49,999/yr — Multiple workflows, Subscription, Pickup, Appointment, Post-Service
}

enum PlanBillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE       // Paid and running
  PAST_DUE     // Payment overdue
  SUSPENDED    // Suspended due to non-payment or policy
  CANCELLED    // Cancelled by Quantix
  EXPIRED      // Subscription ended
}

model PlatformPlan {
  id              String           @id @default(cuid())
  tier            PlanTier         @default(STANDARD)
  billingCycle    PlanBillingCycle
  price           Float            // 2999/4999 monthly, 30000/49999 yearly
  implementationCharge Float       @default(1999) // ₹1,999 one-time
  name            String           // "Quantix Standard Monthly", "Quantix Pro Yearly", etc.
  description     String?
  features        String           @default("[]")
  // Limits
  maxStores       Int              @default(5)
  maxProducts     Int              @default(5000)
  maxOrders       Int              @default(10000)
  maxDeliveryPartners Int          @default(50)
  maxStaff        Int              @default(50)
  // Feature flags
  hasPOS                  Boolean  @default(true)
  hasDelivery             Boolean  @default(true)
  hasSubscription         Boolean  @default(true)
  hasCustomDomain         Boolean  @default(true)
  hasWhiteLabel           Boolean  @default(true)
  hasAdvancedReports      Boolean  @default(true)
  hasAPIAccess            Boolean  @default(true)
  // Workflow access (STANDARD gets Ecommerce only; PRO gets all)
  hasEcommerceWorkflow    Boolean  @default(true)
  hasPickupWorkflow       Boolean  @default(false)
  hasAppointmentWorkflow  Boolean  @default(false)
  hasSubscriptionWorkflow Boolean  @default(false)
  hasPostServiceWorkflow  Boolean  @default(false)
  hasAdvancedWorkflowEngine Boolean @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscriptions   BusinessSubscription[]

  @@unique([tier, billingCycle])
  @@index([isActive])
  @@index([tier])
}

model BusinessSubscription {
  id                  String             @id @default(cuid())
  businessId          String             @unique
  planId              String
  status              SubscriptionStatus @default(ACTIVE) // Starts ACTIVE — no trial
  // Pricing — Super Admin can override
  planPrice           Float              // Standard plan price
  customPrice         Float?             // Override price set by Super Admin
  discountPercentage  Float?             // Discount percentage
  manualPriceOverride Boolean            @default(false)
  overrideReason      String?            // Why the override was applied
  overrideApprovedBy  String?            // Super Admin who approved the override
  // Billing
  billingCycle        PlanBillingCycle
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  nextBillingDate     DateTime
  // Payment verification — business creation requires this
  paymentVerified     Boolean            @default(false)
  paymentVerifiedAt   DateTime?
  paymentVerifiedBy   String?
  // Pause
  pausedAt            DateTime?
  pauseReason         String?
  resumeAt            DateTime?
  // Payment history
  lastPaymentDate     DateTime?
  lastPaymentAmount   Float?
  nextPaymentAmount   Float?
  paymentMethod       String?
  // Auto renewal
  autoRenew           Boolean            @default(true)
  cancelledAt         DateTime?
  cancelReason        String?
  // Notes
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                PlatformPlan       @relation(fields: [planId], references: [id])
  billingHistory      BillingRecord[]

  @@index([status])
  @@index([nextBillingDate])
}

model BillingRecord {
  id                    String   @id @default(cuid())
  businessSubscriptionId String
  amount                Float
  currency              String   @default("INR")
  status                String   @default("pending")
  invoiceNumber         String?
  paymentGateway        String?
  gatewayTransactionId  String?
  dueDate               DateTime
  paidDate              DateTime?
  description           String?
  createdAt             DateTime @default(now())

  subscription          BusinessSubscription @relation(fields: [businessSubscriptionId], references: [id], onDelete: Cascade)

  @@index([businessSubscriptionId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================================
// SECTION 15: CUSTOMER-SUBSCRIPTION ENGINE (Business → Customer)
// Credit-based packages for Car Wash, Home Services, Laundry etc.
// ============================================================================

enum SubscriptionServiceType {
  CAR_WASH
  HOME_SERVICE
  LAUNDRY
  GROCERY
  CUSTOM
}

enum SubscriptionBillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum CustomerSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model SubscriptionPlan {
  id                String                 @id @default(cuid())
  businessId        String
  name              String
  slug              String
  description       String?
  serviceType       SubscriptionServiceType
  billingCycle      SubscriptionBillingCycle
  price             Float
  originalPrice     Float?
  setupFee          Float                  @default(0)
  totalCredits      Int                    @default(0)
  creditLabel       String?
  features          String                 @default("[]")
  isFeatured        Boolean                @default(false)
  maxSubscribers    Int?
  currentSubscribers Int                   @default(0)
  isActive          Boolean                @default(true)
  sortOrder         Int                    @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planItems         SubscriptionPlanItem[]
  subscriptions     CustomerSubscription[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([isActive])
}

model SubscriptionPlanItem {
  id              String            @id @default(cuid())
  planId          String
  productId       String?
  serviceName     String?
  creditsPerCycle Int               @default(1)
  maxPerUse       Int               @default(1)
  rollover        Boolean           @default(false)
  rolloverMax     Int               @default(0)
  createdAt       DateTime          @default(now())

  plan            SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model CustomerSubscription {
  id                String                   @id @default(cuid())
  businessId        String
  customerId        String
  planId            String
  status            CustomerSubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime
  totalCredits      Int                      @default(0)
  usedCredits       Int                      @default(0)
  remainingCredits  Int                      @default(0)
  autoRenew         Boolean                  @default(true)
  cancelledAt       DateTime?
  cancelAtPeriodEnd Boolean                  @default(false)
  pauseStartAt      DateTime?
  pauseEndAt        DateTime?
  paymentMethodId   String?
  lastPaymentAt     DateTime?
  lastPaymentAmount Float?
  metadata          String                   @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer          Customer                 @relation(fields: [customerId], references: [id])
  plan              SubscriptionPlan          @relation(fields: [planId], references: [id])
  usages            SubscriptionUsage[]
  orders            Order[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
}

model SubscriptionUsage {
  id              String   @id @default(cuid())
  subscriptionId  String
  orderId         String?
  creditsUsed     Int      @default(1)
  description     String?
  createdAt       DateTime @default(now())

  subscription    CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([createdAt])
}

// ============================================================================
// SECTION 16: CUSTOMER
// ============================================================================

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  userId        String?
  name          String
  email         String?
  phone         String?
  avatar        String?
  gstNumber     String?
  dateOfBirth   DateTime?
  gender        String?  // "MALE", "FEMALE", "OTHER"
  loyaltyTier   String   @default("BRONZE") // "BRONZE", "SILVER", "GOLD", "PLATINUM"
  notes         String   @default("")
  loyaltyPoints Int      @default(0)
  totalOrders   Int      @default(0)
  totalSpent    Float    @default(0)
  avgOrderValue Float    @default(0)
  lastOrderAt   DateTime?
  tags          String   @default("[]")
  metadata      String   @default("{}")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])
  addresses     Address[]
  orders        Order[]
  subscriptions CustomerSubscription[]
  invoices      Invoice[]
  customerNotes CustomerNote[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([userId])
  @@index([phone])
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  landmark     String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  content    String
  isPrivate  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
}

// ============================================================================
// SECTION 17: NOTIFICATIONS (Push, WhatsApp, Email — NO SMS)
// ============================================================================

enum NotificationType {
  ORDER_STATUS
  DELIVERY_UPDATE
  PROMOTION
  SUBSCRIPTION
  PAYMENT
  SYSTEM
}

enum NotificationChannel {
  PUSH
  EMAIL
  WHATSAPP
  IN_APP
}

model NotificationTemplate {
  id          String              @id @default(cuid())
  key         String
  name        String
  channel     NotificationChannel
  subject     String?
  body        String
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([key, channel])
}

model Notification {
  id          String             @id @default(cuid())
  businessId  String
  userId      String?
  type        NotificationType
  channel     NotificationChannel
  title       String
  message     String
  data        String             @default("{}")
  isRead      Boolean            @default(false)
  readAt      DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime           @default(now())

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================================================
// SECTION 18: INVOICE & TAX
// ============================================================================

enum InvoiceType {
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  PROFORMA
  RECEIPT
}

model Invoice {
  id              String      @id @default(cuid())
  businessId      String
  orderId         String?     @unique
  customerId      String?
  invoiceNumber   String
  invoiceType     InvoiceType @default(TAX_INVOICE)
  subtotal        Float       @default(0)
  totalTax        Float       @default(0)
  totalDiscount   Float       @default(0)
  totalAmount     Float       @default(0)
  cgstAmount      Float       @default(0)
  sgstAmount      Float       @default(0)
  igstAmount      Float       @default(0)
  dueDate         DateTime?
  paidAt          DateTime?
  status          String      @default("pending")
  pdfUrl          String?
  metadata        String      @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order?      @relation(fields: [orderId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model TaxConfig {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  taxType     String
  rate        Float
  cgstRate    Float?
  sgstRate    Float?
  igstRate    Float?
  cessRate    Float?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([taxType])
}

// ============================================================================
// SECTION 19: PROMO CODES
// ============================================================================

enum PromoType {
  PERCENTAGE
  FLAT
  FREE_DELIVERY
  BOGO
}

model PromoCode {
  id              String    @id @default(cuid())
  businessId      String
  code            String
  description     String?
  type            PromoType
  value           Float
  minOrderAmount  Float     @default(0)
  maxDiscount     Float?
  usageLimit      Int?
  usedCount       Int       @default(0)
  perUserLimit    Int       @default(1)
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean   @default(true)
  applicableModules String  @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([code])
  @@index([isActive])
}

// ============================================================================
// SECTION 20: SALES TEAM (Quantix Internal)
// Manages leads, demos, negotiations — NOT business creation.
// ============================================================================

model SalesTeamMember {
  id          String   @id @default(cuid())
  userId      String   @unique
  name               String
  email              String
  phone              String
  avatar             String?
  designation        String?
  region             String?
  reportingManager   String?
  commissionPercent  Float    @default(0)
  target             Float    @default(0)
  achieved           Float    @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  leads       Lead[]
  clients     Business[]  @relation("SalesRepClients")
}

// ============================================================================
// SECTION 21: DOMAIN & DEPLOYMENT (Quantix Managed)
// Quantix controls all deployment, domains, and branding.
// ============================================================================

enum DomainStatus {
  PENDING_DNS
  DNS_PROPAGATING
  SSL_PENDING
  ACTIVE
  ERROR
}

model DomainMapping {
  id              String       @id @default(cuid())
  businessId      String       @unique
  domain          String
  subdomain       String?
  isPrimary       Boolean      @default(true)
  sslStatus       String       @default("pending")
  sslExpiryDate   DateTime?
  dnsProvider     String?
  dnsConfig       String       @default("{}")
  status          DomainStatus @default(PENDING_DNS)
  configuredBy    String?      // Quantix team member
  configuredAt    DateTime?
  deployedAt      DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business        Business     @relation(fields: [businessId], references: [id])

  @@unique([domain])
  @@index([status])
}

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYING
  LIVE
  FAILED
  MAINTENANCE
}

enum DeploymentType {
  WEBSITE
  ADMIN_DASHBOARD
  CUSTOMER_APP
  DELIVERY_APP
  ADMIN_APP
}

model Deployment {
  id              String           @id @default(cuid())
  businessId      String
  type            DeploymentType
  status          DeploymentStatus @default(PENDING)
  environment     String           @default("production")
  hostingProvider String           @default("replit")
  hostingConfig   String           @default("{}")
  buildUrl        String?
  liveUrl         String?
  version         String?
  deployedBy      String?          // Quantix team member who deployed
  deployedAt      DateTime?
  lastCheckedAt   DateTime?
  healthStatus    String           @default("unknown")
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business        Business         @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([type])
  @@index([status])
}

// ============================================================================
// SECTION 22: AUDIT LOG
// ============================================================================

model ActivityLog {
  id          String   @id @default(cuid())
  businessId  String?
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  business    Business? @relation(fields: [businessId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// SECTION 23: CATALOG MODULE (Shared product/category/inventory)
// Used by: GROCERY, PHARMACY, ECOMMERCE, COSMETICS, MEAT_DELIVERY, FURNITURE
// ============================================================================

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
  SUBSCRIPTION
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

model Category {
  id            String      @id @default(cuid())
  businessId    String
  name          String
  slug          String
  description   String?
  image         String?
  icon          String?
  parentId      String?
  // WORKFLOW ASSIGNMENT — determines how products in this category are processed
  workflowType  WorkflowType @default(ECOMMERCE)
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent        Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]  @relation("CategoryHierarchy")
  products      Product[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([parentId])
  @@index([workflowType])
}

model Product {
  id              String        @id @default(cuid())
  businessId      String
  storeId         String?
  categoryId      String?
  name            String
  slug            String
  description     String?
  shortDesc       String?
  type            ProductType   @default(PHYSICAL)
  status          ProductStatus @default(ACTIVE)
  sku             String?
  barcode         String?
  images          String        @default("[]")
  unit            String?
  unitQuantity    Float?
  isVeg           Boolean?
  isFeatured      Boolean       @default(false)
  isPopular       Boolean       @default(false)
  preparationTime Int?
  minOrderQty     Float         @default(1)
  maxOrderQty     Float         @default(100)
  tags            String        @default("[]")
  nutritionInfo   String?
  allergenInfo    String?
  // WORKFLOW ASSIGNMENT — overrides category workflow if set, inherits from category if null
  workflowType    WorkflowType? 
  sortOrder       Int           @default(0)
  metadata        String        @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  inventory       Inventory[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([storeId])
  @@index([workflowType])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  sku             String?
  barcode         String?
  price           Float
  mrp             Float
  costPrice       Float?
  discountPrice   Float?
  discountPercent Float?
  stock           Int      @default(0)
  minStock        Int      @default(0)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  attributes      String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       Inventory[]

  @@index([productId])
  @@index([isActive])
}

model Inventory {
  id             String          @id @default(cuid())
  businessId     String
  storeId        String
  productId      String
  variantId      String?
  quantity       Int             @default(0)
  reservedQty    Int             @default(0)
  minStock       Int             @default(5)
  maxStock       Int             @default(1000)
  status         InventoryStatus @default(IN_STOCK)
  lastRestockedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  logs           InventoryLog[]

  @@unique([storeId, productId, variantId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
}

model InventoryLog {
  id          String   @id @default(cuid())
  inventoryId String
  action      String
  quantity    Int
  previousQty Int
  newQty      Int
  note        String?
  performedBy String?
  createdAt   DateTime @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
}
