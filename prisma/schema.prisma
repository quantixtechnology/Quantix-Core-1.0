// ── 6. Capacity Controls ──────────────────────────────────────────────────
model LaundryScalingLimit {
  id                       String          @id @default(cuid())
  businessId               String          @unique
  business                 LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storesAllowed            Int             @default(1)
  storesUsed               Int             @default(0)
  processingCentersAllowed Int             @default(1)
  processingCentersUsed    Int             @default(0)
  storeCapacityKg          Int             @default(500)
  processingCapacityKg     Int             @default(1000)
  employeesAllowed         Int             @default(5)
  employeesUsed            Int             @default(0)
  deliveryStaffAllowed     Int             @default(2)
  deliveryStaffUsed        Int             @default(0)
  ordersPerDay             Int             @default(50)
  ordersPerMonthLimit      Int             @default(500)
  storageLimitMB           Int             @default(500)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([businessId])
}

model LaundryStore {
  id                String   @id @default(cuid())
  storeCode         String   @unique
  laundryBusinessId String
  storeName         String
  storeType         String   @default("RETAIL_STORE")
  managerName       String?
  mobile            String?
  email             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  serviceRadiusKm   Float?
  dailyCapacityKg   Float?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  laundryBusiness LaundryBusiness         @relation(fields: [laundryBusinessId], references: [id], onDelete: Cascade)
  departments     LaundryDepartment[]
