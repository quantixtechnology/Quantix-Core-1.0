// ── Account & Billing Engine ──────────────────────────────────────

// Unified document table: PROFORMA, TAX_INVOICE, CREDIT_NOTE,
// DEBIT_NOTE, PAYMENT_RECEIPT, ADJUSTMENT_NOTE. Future types added
// as new documentType string values without schema changes.
model BillingDocument {
  id              String    @id @default(cuid())
  documentNumber  String    @unique
  documentType    String // PROFORMA | TAX_INVOICE | CREDIT_NOTE |
  // DEBIT_NOTE | PAYMENT_RECEIPT | ADJUSTMENT_NOTE
  businessId      String
  chargeId        String? // source charge that generated this document
  billingRecordId String? // linked to BillingRecord when payment triggers a doc
  linkedDocId     String? // e.g. TAX_INVOICE linked back to its PROFORMA
  status          String    @default("Draft")
  // Draft | Sent | Viewed | Accepted | Payment Submitted |
  // Under Verification | Paid | Converted To Invoice |
  // Cancelled | Expired
  amount          Float
  currency        String    @default("INR")
  gstRate         Float?
  cgstAmount      Float?
  sgstAmount      Float?
  igstAmount      Float?
  totalWithGst    Float?
  lineItems       String    @default("[]") // JSON LineItem[]
  notes           String?
  validUntil      DateTime?
  issuedDate      DateTime?
  paidDate        DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  createdById     String?
  createdByName   String?
  metadata        String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  charge          Charge?   @relation(fields: [chargeId], references: [id])

  @@index([businessId])
  @@index([documentType])
  @@index([status])
  @@index([documentNumber])
  @@index([billingRecordId])
  @@index([chargeId])
  @@index([createdAt])
}

// Per-(financialYear, documentType) sequence for BillingDocument numbering.
// Completely separate from legacy InvoiceSequence used by BillingRecord.
model BillingDocumentSequence {
  financialYear String
  documentType  String
  nextVal       Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@id([financialYear, documentType])
}

// Centralized service catalog — never hardcoded. Admins manage items here.
// Used as the source when creating BillingDocument line items.
model ServiceCatalog {
  id            String   @id @default(cuid())
  name          String
  description   String?
  serviceType   String // Platform Plan | Add-On | Mobile App | Implementation |
  // Training | Support | Integration | Credits |
  // Custom Development | Other
  billingType   String // Recurring | One-Time | Usage Based | Credit | Discount | Refund
  defaultAmount Float?
  currency      String   @default("INR")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serviceType])
  @@index([isActive])
  @@index([sortOrder])
}

// Every admin-initiated change to a business recurring due date.
// overrideUntil = NEXT_BILLING_ONLY → reverts after one cycle.
// overrideUntil = PERMANENT → stays until changed again.
model RecurringDateOverride {
  id                     String    @id @default(cuid())
  businessSubscriptionId String
  businessId             String
  originalDueDate        DateTime
  overrideDueDate        DateTime
  overrideReason         String
  overrideUntil          String    @default("NEXT_BILLING_ONLY")
  // NEXT_BILLING_ONLY | PERMANENT
  createdById            String?
  createdByName          String?
  appliedAt              DateTime?
  revertedAt             DateTime?
  metadata               String    @default("{}")
  createdAt              DateTime  @default(now())
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessSubscriptionId])
  @@index([businessId])
  @@index([createdAt])
}

// A billable event against a specific service line.
// Primary entry point for the charge-based billing workflow:
//   Service → Charge → Proforma → Payment → Verification → Tax Invoice → Receipt
model Charge {
  id            String            @id @default(cuid())
  businessId    String
  serviceId     String? // null for manual / one-off charges
  serviceName   String
  description   String?
  amount        Float
  currency      String            @default("INR")
  chargeType    String            @default("ONE_TIME")
  // ONE_TIME | RECURRING | IMPLEMENTATION | CREDIT | ADJUSTMENT
  status        String            @default("PENDING")
  // PENDING | INVOICED | PAID | CANCELLED | WAIVED
  dueDate       DateTime?
  periodStart   DateTime? // billing period start (RECURRING charges)
  periodEnd     DateTime? // billing period end  (RECURRING charges)
  notes         String?
  createdById   String?
  createdByName String?
  metadata      String            @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documents     BillingDocument[]

  @@index([businessId])
  @@index([status])
  @@index([chargeType])
  @@index([createdAt])
}

// ╔══════════════════════════════════════════════════════════════════╗
// ║  NEW BILLING ARCHITECTURE                                        ║
// ║  Business → BillingAccount → BillingService → BillingInvoice    ║
// ║            → BillingPayment → BillingLedger → BillingAudit      ║
// ║  One invoice per billing cycle per account.                      ║
// ║  All billable items are Services. No Charge / Subscription.      ║
// ╚══════════════════════════════════════════════════════════════════╝

// One billing account per Business. Auto-created on first access.
model BillingAccount {
  id             String           @id @default(cuid())
  businessId     String           @unique
  currency       String           @default("INR")
  notes          String?
  billingEmail   String?
  billingPhone   String?
  billingAddress String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services       BillingService[]
  invoices       BillingInvoice[]
  payments       BillingPayment[]
  ledger         BillingLedger[]
  auditLog       BillingAudit[]

  @@index([businessId])
}

// Every billable item is a Service.
// Examples: "Quantix Standard", "Additional Store", "iOS App", "Implementation Fee"
model BillingService {
  id              String               @id @default(cuid())
  accountId       String
  businessId      String
  name            String
  description     String?
  category        String               @default("PLATFORM")
  // PLATFORM | MOBILE_APP | IMPLEMENTATION | SUPPORT | CUSTOM
  billingType     String               @default("RECURRING")
  // RECURRING | ONE_TIME
  billingCycle    String?
  // MONTHLY | QUARTERLY | HALF_YEARLY | YEARLY
  unitPrice       Float
  quantity        Int                  @default(1)
  status          String               @default("ACTIVE")
  // ACTIVE | PAUSED | CANCELLED
  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime?
  createdById     String?
  createdByName   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  account         BillingAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoiceItems    BillingInvoiceItem[]

  @@index([accountId])
  @@index([businessId])
  @@index([status])
}

// One invoice per billing cycle per account.
// lineItems is a JSON array so any service composition works without schema changes.
model BillingInvoice {
  id            String               @id @default(cuid())
  invoiceNumber String               @unique // INV/2026-27/0001
  accountId     String
  businessId    String
  status        String               @default("DRAFT")
  // DRAFT | SENT | PAID | PARTIALLY_PAID | OVERDUE | CANCELLED
  billingPeriod String? // human label: "June 2026"
  periodStart   DateTime?
  periodEnd     DateTime?
  lineItems     String               @default("[]") // JSON: [{serviceId,name,qty,unitPrice,amount}]
  subtotal      Float                @default(0)
  taxRate       Float                @default(18)
  cgstRate      Float                @default(9)
  sgstRate      Float                @default(9)
  igstRate      Float                @default(0)
  cgstAmount    Float                @default(0)
  sgstAmount    Float                @default(0)
  igstAmount    Float                @default(0)
  taxAmount     Float                @default(0)
  totalAmount   Float                @default(0)
  paidAmount    Float                @default(0)
  currency      String               @default("INR")
  issuedDate    DateTime?
  dueDate       DateTime?
  sentAt        DateTime?
  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  account       BillingAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payments      BillingPayment[]
  items         BillingInvoiceItem[]

  @@index([accountId])
  @@index([businessId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([createdAt])
}

// Normalised line-items for reporting (invoice body also stored in lineItems JSON).
model BillingInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  serviceId   String?
  name        String
  description String?
  quantity    Int             @default(1)
  unitPrice   Float
  amount      Float
  invoice     BillingInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     BillingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceId])
}

// Per-financial-year invoice number sequence.
model BillingInvoiceSeq {
  financialYear String   @id // "2026-27"
  nextVal       Int      @default(1)
  updatedAt     DateTime @updatedAt
}

// Payment recorded against a specific invoice.
model BillingPayment {
  id              String         @id @default(cuid())
  accountId       String
  businessId      String
  invoiceId       String
  amount          Float
  currency        String         @default("INR")
  paymentMode     String?
  // CASH | BANK_TRANSFER | UPI | CHEQUE | CARD | ONLINE
  transactionId   String?
  referenceNumber String?
  bankName        String?
  status          String         @default("COMPLETED")
  // COMPLETED | PENDING_VERIFICATION | FAILED | REFUNDED
  notes           String?
  proofUrl        String?
  proofFileType   String?
  paidAt          DateTime
  recordedById    String?
  recordedByName  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  account         BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice         BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([businessId])
  @@index([invoiceId])
  @@index([createdAt])
}

// Chronological ledger with pre-computed running balance.
model BillingLedger {
  id              String         @id @default(cuid())
  accountId       String
  businessId      String
  entryType       String
  // INVOICE_RAISED | PAYMENT_RECEIVED | CREDIT | ADJUSTMENT
  description     String
  debit           Float          @default(0)
  credit          Float          @default(0)
  balance         Float          @default(0)
  referenceType   String? // INVOICE | PAYMENT
  referenceId     String?
  referenceNumber String?
  date            DateTime
  createdAt       DateTime       @default(now())
  account         BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([businessId])
  @@index([date])
}

// Full audit trail for every billing action.
model BillingAudit {
  id              String         @id @default(cuid())
  accountId       String
  businessId      String
  action          String
  // SERVICE_CREATED | SERVICE_UPDATED | SERVICE_CANCELLED
  // INVOICE_CREATED | INVOICE_SENT | INVOICE_PAID | INVOICE_CANCELLED
  // PAYMENT_RECORDED | PAYMENT_VERIFIED | PAYMENT_REFUNDED
  entityType      String? // SERVICE | INVOICE | PAYMENT
  entityId        String?
  description     String
  oldValue        String?
  newValue        String?
  metadata        String         @default("{}")
  performedById   String?
  performedByName String?
  createdAt       DateTime       @default(now())
  account         BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([businessId])
  @@index([createdAt])
}

// ============================================================================
// LAUNDRY OS — Fully isolated platform module
// No relationships with existing Quantix Core entities.
// ============================================================================

model LaundryBusiness {
  id                           String    @id @default(cuid())
  businessCode                 String    @unique
  businessName                 String
  legalName                    String?
  ownerName                    String
  mobile                       String
  email                        String?
  gstNumber                    String?
  logo                         String?
  favicon                      String?
  address                      String?
  plan                         String    @default("STANDARD")
  status                       String    @default("ONBOARDING")
  // Payment policy: ADVANCE_REQUIRED | BEFORE_DELIVERY | SUBSCRIPTION | CUSTOM.
  // Only ADVANCE_REQUIRED blocks processing before payment; the default lets
  // garments process and requires payment before delivery.
  paymentPolicy                String    @default("BEFORE_DELIVERY")
  allowProcessingBeforePayment Boolean   @default(false) // deprecated (kept for compat)
  // Pickup-First: how the operational QR is created after Store Audit.
  processingPackageQrMode      String    @default("GENERATE_NEW") // GENERATE_NEW | REUSE_BAG
  defaultServiceRadius         Float?
  defaultDailyCapacity         Float?
  platformBusinessId           String?   @unique
  setupCompletedAt             DateTime? // Guided Initial Setup finished → dashboard is operational
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  stores               LaundryStore[]
  features             LaundryBusinessFeature[]
  configurations       LaundryWorkflowConfiguration[]
  departments          LaundryDepartment[]
  processingCenters    LaundryProcessingCenter[]
  assignments          LaundryUserAssignment[]
  subscription         LaundrySubscription?
  scalingLimit         LaundryScalingLimit?
  provisioning         LaundryProvisioningItem[]
  operationalConfig    LaundryOperationalConfig?
  platformProvisioning LaundryPlatformProvisioning?
  brandingConfig       LaundryBrandingConfig?
  workflowQuality      LaundryWorkflowQualityConfig?
  auditLogs            LaundryAuditLog[]
  orders               LaundryOrder[]

  @@index([businessCode])
  @@index([status])
  @@index([plan])
}

// ============================================================================
// Laundry OS Licensing Engine
// ============================================================================

model LaundrySubscription {
  id               String          @id @default(cuid())
  businessId       String          @unique
  business         LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan             String          @default("STARTER") // STARTER | PROFESSIONAL | ENTERPRISE | CUSTOM
  templatePreset   String          @default("STARTER")
  billingCycle     String          @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY
  status           String          @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  startDate        DateTime        @default(now())
  renewalDate      DateTime
  trialExpiry      DateTime?
  lastPaymentDate  DateTime?
  nextInvoiceDate  DateTime?
  workspaceType    String          @default("LAUNDRY_OS")
  businessCategory String          @default("LAUNDRY")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([businessId])
  @@index([plan])
  @@index([status])
}

// ── 2. Platform Provisioning ──────────────────────────────────────────────
// Individual provisioning items with status tracking.
model LaundryProvisioningItem {
  id         String          @id @default(cuid())
  businessId String
  business   LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  item       String // workspace | domain | ssl | pwa | customerApp | deliveryApp | adminApp | apkBuild | playStore | monitoring | backup
  status     String          @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([businessId, item])
  @@index([businessId])
}

// ── 2. Platform Provisioning (Quantix-Controlled) ─────────────────────────
// Which platform features Quantix has enabled for this business.
model LaundryPlatformProvisioning {
  id                 String          @id @default(cuid())
  businessId         String          @unique
  business           LaundryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerWebsite    Boolean         @default(false)
  customerPWA        Boolean         @default(true)
  androidCustomerApp Boolean         @default(false)
  deliveryApp        Boolean         @default(false)
  adminApp           Boolean         @default(true)
  ssl                Boolean         @default(true)
  cloudStorage       Boolean         @default(true)
