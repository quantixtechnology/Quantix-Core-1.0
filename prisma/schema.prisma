generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton settings record for the entire platform.
// Use getPlatformSettings() to read — never query this model directly.
model PlatformSettings {
  id             String  @id @default("singleton")

  // Company identity
  companyName    String?
  companyAddress String?
  companyEmail   String?
  companyPhone   String?
  companyWebsite String?
  companyGst     String?

  // Branding assets (stored as /uploads/platform/shared/<filename> URLs)
  logoUrl             String?
  darkLogoUrl         String?
  faviconUrl          String?
  emailLogoUrl        String?
  loginScreenLogoUrl  String?  // login page logo; falls back to logoUrl when null

  // Zone 1 — Core Platform: additional assets
  tagline        String?
  compactLogoUrl String?  // collapsed sidebar / app icon
  watermarkUrl   String?  // platform watermark

  // Zone 1 — Core Platform: brand colors
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  successColor   String?
  warningColor   String?
  infoColor      String?

  // Zone 2 — Sales Documents: assets
  salesLogoUrl      String?
  salesWatermarkUrl String?

  // Zone 2 — Sales Documents: config
  salesAccentColor  String?
  salesFooterText   String?

  // Zone 3 — HRMS: assets
  hrmsLogoUrl      String?
  hrmsWatermarkUrl String?

  // Zone 3 — HRMS: config
  hrmsAccentColor      String?
  signatoryName        String?
  signatoryDesignation String?
  signatorySignUrl     String?  // digital signature image
  signatoryStampUrl    String?  // signature + stamp image

  // Zone 4 — Sidebar Theme
  sidebarBg           String?  // e.g. #04132E
  sidebarActiveColor  String?  // e.g. #2563EB
  sidebarTextColor    String?  // e.g. #FFFFFF
  sidebarHeadingColor String?  // e.g. #38BDF8
  sidebarLogoUrl      String?  // dedicated sidebar logo; falls back to logoUrl when null

  // Billing / invoice configuration
  invoicePrefix  String? @default("QTX")
  sacCode        String? @default("998314")

  // GST rates (percentages, e.g. 18 / 9 / 9)
  gstRate        Float?  @default(18)
  cgstRate       Float?  @default(9)
  sgstRate       Float?  @default(9)

  // Zone 5 — Invoice Settings
  invoiceLogoUrl         String?  // dedicated invoice / billing logo

  // Invoice company identity (may differ from platform companyName)
  invoiceLegalName       String?  // Legal company name
  invoiceBusinessName    String?  // Trade / business name
  invoiceAddress         String?  // Full address line
  invoiceCity            String?
  invoiceState           String?
  invoicePincode         String?
  invoiceCountry         String?  @default("India")
  invoicePhone           String?
  invoiceEmail           String?
  invoiceWebsite         String?

  // Tax & registration numbers (all optional; blank = hidden on invoices)
  companyPan             String?  // PAN
  companyMsme            String?  // MSME / Udyam registration
  companyShopEst         String?  // Shop & Establishment number
  companyIec             String?  // IEC number
  companyCin             String?  // CIN number

  // Banking details (displayed on unpaid invoices only)
  bankAccountName        String?
  bankName               String?
  bankAccountNumber      String?
  bankIfsc               String?
  bankUpiId              String?

  // Invoice footer / notes
  invoiceFooterNotes     String?  // SAC/HSN notes shown in footer
  invoiceLegalDisclaimer String?  // Legal disclaimer text
  invoiceDefaultNotes    String?  // Default notes on every invoice

  // Zone 6 — Quote / Proposal Settings (independent of Invoice Settings)
  quoteLogoUrl         String?   // overrides salesLogoUrl for quote PDFs
  quoteAccentColor     String?   // overrides salesAccentColor for quote PDFs
  quoteFooterText      String?   // overrides salesFooterText for quote PDFs
  quoteFooterColor     String?   // hex colour for quote footer text/line
  quoteShowPageNumber  Boolean?  // show "Page N of N"; null = true
  // Header visibility toggles (null = default shown/hidden per field)
  quoteShowLogo        Boolean?  // show logo in header; null = true
  quoteShowCompanyName Boolean?  // show company name; null = true
  quoteShowAddress     Boolean?  // show registered address; null = false
  quoteShowPhone       Boolean?  // show phone; null = false
  quoteShowEmail       Boolean?  // show email; null = false
  quoteShowWebsite     Boolean?  // show website; null = true
  // Last page legal info visibility (null = true — show if value exists)
  quoteShowGST         Boolean?
  quoteShowPAN         Boolean?
  quoteShowMSME        Boolean?
  quoteShowShopAct     Boolean?
  quoteShowCIN         Boolean?
  quoteShowIEC         Boolean?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// PLATFORM PRODUCT REGISTRY
// Master record of all products supported by Quantix Core Platform
// ============================================================================

model PlatformProduct {
  id                     String   @id @default(cuid())

  // Product identification
  code                   String   @unique  // e.g., "COMMERCE", "LAUNDRY", "CARWASH"
  name                   String            // e.g., "Commerce OS"
  slug                   String   @unique  // e.g., "commerce-os"
  description            String?           // Product description
  productType            String   @default("OS")  // e.g., "OS", "SERVICE", "MODULE"

  // Deployment information
  workspaceUrl           String            // Base workspace URL (e.g., commerce.quantixtechnology.in)
  currentVersion         String   @default("1.0.0")
  supportedCoreVersion   String?           // Minimum Quantix Core version required

  // Product status & visibility
  status                 String   @default("ACTIVE")  // ACTIVE, PLANNED, DEPRECATED, DISABLED
  isEnabled              Boolean  @default(true)      // Admin can disable product

  // Storage & quotas
  defaultStorageQuotaMB  Int      @default(1048576)   // 1GB default

  // Branding
  brandingTemplate       String?           // Reference to default branding template
  defaultBrandColor      String   @default("#10B981") // Default primary color

  // Configuration
  defaultPlanId          String?           // Default plan for new businesses
  metadata               String   @default("{}")     // JSON config (roles, features, etc.)

  // Audit
  createdBy              String?
  createdAt              DateTime @default(now())
  updatedBy              String?
  updatedAt              DateTime @updatedAt

  @@index([status])
  @@index([code])
}

model Lead {
  id                     String           @id @default(cuid())
  salesRepId             String?
  assignedToUserId       String?
  businessName           String
  contactName            String
  contactEmail           String
  contactPhone           String
  businessType           BusinessType
  source                 LeadSource       @default(WEBSITE_INQUIRY)
  stage                  LeadStage        @default(LEAD)
  demoTenantId           String?
  demoSharedAt           DateTime?
  demoCredentials        String?
  demoFeedback           String?
  negotiatedMonthlyPrice Float?
  negotiatedYearlyPrice  Float?
  negotiationNotes       String?
  paymentProof           String?
  paymentVerifiedAt      DateTime?
  paymentVerifiedBy      String?
  selectedBillingCycle   String?
  convertedBusinessId    String?
  convertedAt            DateTime?
  lostReason             String?
  notes                  String?
  followUpDate           DateTime?
  estimatedValue         Float?
  tags                   String           @default("[]")
  lastContactedAt        DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  city                   String?
  createdById            String?
  lastFollowUpAt         DateTime?
  leadId                 String?          @unique
  pincode                String?
  state                  String?
  salesRep               SalesTeamMember? @relation(fields: [salesRepId], references: [id])
  assignedToUser         User?            @relation(fields: [assignedToUserId], references: [id])
  convertedBusiness      Business?        @relation("LeadConversion", fields: [convertedBusinessId], references: [id])

  @@index([leadId])
  @@index([salesRepId])
  @@index([assignedToUserId])
  @@index([stage])
  @@index([source])
  @@index([createdAt])
}

model LeadSequence {
  monthKey  String   @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ProposalSequence {
  monthKey  String   @id
  nextVal   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ProposalDocument {
  id              String    @id @default(cuid())
  proposalId      String    @unique
  documentType    String    @default("PROPOSAL")
  status          String    @default("ACTIVE")
  businessName    String
  clientName      String
  contactPhone    String?
  contactEmail    String?
  leadId          String?
  totalAmount     Float?
  salesTeamMember String?
  salesTeamEmail  String?
  formSnapshot    String    @default("{}")
  pdfPath         String?
  pdfVersion      Int       @default(1)
  createdBy       String
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedBy       String?

  @@index([proposalId])
  @@index([businessName])
  @@index([contactPhone])
  @@index([leadId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([documentType])
}

model LeadImportLog {
  id         String   @id @default(cuid())
  importedBy String
  importedAt DateTime @default(now())
  fileName   String?
  totalRows  Int      @default(0)
  imported   Int      @default(0)
  duplicates Int      @default(0)
  errors     Int      @default(0)
  notes      String?

  @@index([importedBy])
  @@index([importedAt])
}

model LeadExportLog {
  id         String    @id @default(cuid())
  exportedBy String
  exportedAt DateTime  @default(now())
  fromDate   DateTime?
  toDate     DateTime?
  filters    String?
  rowCount   Int       @default(0)

  @@index([exportedBy])
  @@index([exportedAt])
}

model DemoTenant {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  businessType     BusinessType
  status           DemoTenantStatus @default(AVAILABLE)
  accessEmail      String
  accessPassword   String
  accessUrl        String?
  currentLeadId    String?
  currentLeadName  String?
  sessionStartedAt DateTime?
  sessionExpiresAt DateTime?
  sampleDataConfig String           @default("{}")
  resetAfterUse    Boolean          @default(true)
  lastResetAt      DateTime?
  description      String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([businessType])
  @@index([status])
}

model Business {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  businessType          BusinessType
  status                BusinessStatus          @default(ONBOARDING)
  leadId                String?
  logo                  String?
  favicon               String?
  primaryColor          String                  @default("#10B981")
  secondaryColor        String?
  darkMode              Boolean                 @default(false)
  tagline               String?
  description           String?
  gstNumber             String?
  panNumber             String?
  cinNumber             String?
  fssaiLicense          String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String                  @default("India")
  latitude              Float?
  longitude             Float?
  contactEmail          String?
  contactPhone          String?
  supportEmail          String?
  supportPhone          String?
  defaultCurrency       String                  @default("INR")
  defaultLocale         String                  @default("en-IN")
  timezone              String                  @default("Asia/Kolkata")
  isOnline              Boolean                 @default(false)
  activationChecklist   String                  @default("{}")
  activationProgress    Int                     @default(0)
  activationCompleted   Boolean                 @default(false)
  settings              String                  @default("{}")
  features              String                  @default("{}")
  notificationConfig    String                  @default("{}")
  onboardedAt           DateTime?
  activatedAt           DateTime?
  suspendedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  salesRepId            String?
  businessCode          String?                 @unique
  activityLogs          ActivityLog[]
  salesRep              SalesTeamMember?        @relation("SalesRepClients", fields: [salesRepId], references: [id])
  gatewayAccess         BusinessGatewayAccess[]
  modules               BusinessModule[]
  businessSubscription  BusinessSubscription?
  businessUsers         BusinessUser[]
  businessRoles         BusinessRole[]
  auditLogs             BusinessAuditLog[]
  categories            Category[]
  convertedLeads        Lead[]                  @relation("LeadConversion")
  customers             Customer[]
  customerSubscriptions CustomerSubscription[]
  deliveryPartners      DeliveryPartner[]
  deliveryZones         DeliveryZone[]
  deployments           Deployment[]
  domain                DomainMapping?
  featureFlags          FeatureFlag[]
  invoices              Invoice[]
  notifications         Notification[]
  onboardingSteps       OnboardingStep[]
  orders                Order[]
  posSessions           POSSession[]
  payments              Payment[]
  paymentGateways       PaymentGateway[]
  storePaymentGateways  StorePaymentGateway[]
  products              Product[]
  promoCodes            PromoCode[]
  reviews               Review[]
  stores                Store[]
  subscriptionPlans     SubscriptionPlan[]
  addons                Addon[]
  taxConfigs            TaxConfig[]
  workflowRules         WorkflowRule[]
  branding              BusinessBranding?
  appConfig             AppConfig?
  cartItems             CartItem[]
  favorites             Favorite[]
  supportTickets        SupportTicket[]
  workforceSettings     WorkforceSettings?
  partnerAuditLogs      PartnerAudit[]
  notificationSounds    NotificationSound[]
  notificationDevices   NotificationDevice[]
  banners               Banner[]
  refunds               Refund[]
  billingDocuments      BillingDocument[]
  recurringDateOverrides RecurringDateOverride[]
  charges               Charge[]
  billingAccount        BillingAccount?

  @@index([businessType])
  @@index([status])
  @@index([salesRepId])
}

model OnboardingStep {
  id          String               @id @default(cuid())
  businessId  String
  stepKey     String
  stepName    String
  status      OnboardingStepStatus @default(PENDING)
  completedBy String?
  completedAt DateTime?
  notes       String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, stepKey])
  @@index([businessId])
  @@index([status])
}

model BusinessModule {
  id         String       @id @default(cuid())
  businessId String
  moduleKey  String
  moduleName String
  version    String       @default("1.0.0")
  status     ModuleStatus @default(DISABLED)
  config     String       @default("{}")
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, moduleKey])
  @@index([businessId])
  @@index([moduleKey])
  @@index([status])
}

model Store {
  id                  String         @id @default(cuid())
  businessId          String
  name                String
  slug                String
  code                String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  country             String         @default("India")
  latitude            Float?
  longitude           Float?
  phone               String?
  email               String?
  status              StoreStatus    @default(ACTIVE)
  isMainStore         Boolean        @default(false)
  deliveryRadius      Float          @default(5.0)
  minOrderAmount      Float          @default(0)
  deliveryFee         Float          @default(0)
  freeDeliveryAbove   Float?
  maxDeliveryDistance Float?         @default(10.0)
  preparationTime     Int            @default(30)
  operatingHours      String         @default("{}")
  posEnabled          Boolean        @default(true)
  printerConfig       String         @default("{}")
  printerType         String?
  paperSize           String         @default("80mm")
  gstNumber           String?
  settings            String         @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  storeCode           String?
  staff               BusinessUser[]
  categories          Category[]
  deliveryZones       DeliveryZone[]
  inventory           Inventory[]
  orders              Order[]
  posSessions         POSSession[]
  products            Product[]
  taxConfigs          TaxConfig[]
  workflowRules       WorkflowRule[]
  userAssignments     UserStoreAssignment[]
  storePaymentGateways StorePaymentGateway[]
  deliveryPartners    DeliveryPartner[]
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeTimings        StoreTiming[]
  banners             Banner[]

  @@unique([businessId, slug])
  @@unique([businessId, storeCode])
  @@index([businessId])
  @@index([status])
}

model StoreTiming {
  id        String   @id @default(cuid())
  storeId   String
  day       Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@index([storeId])
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  loginId             String?           @unique
  phone               String?
  name                String
  avatar              String?
  passwordHash        String?
  hasPassword         Boolean           @default(false)
  mustChangePassword  Boolean           @default(false)
  authProvider        AuthProvider      @default(EMAIL_OTP)
  emailVerified       Boolean           @default(false)
  phoneVerified       Boolean           @default(false)
  isActive            Boolean           @default(true)
  fcmToken            String?
  lastLoginAt         DateTime?
  metadata            String            @default("{}")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  platformRole        Role?
  platformPermissions String?
  activityLogs        ActivityLog[]
  businessUsers       BusinessUser[]
  customerProfiles    Customer[]
  customerNotes       CustomerNote[]
  deliveryProfiles    DeliveryPartner[]
  notifications       Notification[]
  notificationDevices NotificationDevice[]
  otpCodes            OTPCode[]
  posSessions         POSSession[]      @relation("POSOperator")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  salesProfile        SalesTeamMember?
  assignedLeads       Lead[]
}

model OTPCode {
  id         String       @id @default(cuid())
  userId     String?
  email      String?
  phone      String?
  code       String
  channel    AuthProvider
  isVerified Boolean      @default(false)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([code])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model BusinessUser {
  id              String                @id @default(cuid())
  userId          String
  businessId      String
  role            Role
  storeId         String?
  businessRoleId  String?
  createdBy       String?
  permissions     String                @default("[]")
  isActive        Boolean               @default(true)
  invitedAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  store           Store?                @relation(fields: [storeId], references: [id])
  businessRole    BusinessRole?         @relation(fields: [businessRoleId], references: [id])
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeAssignments UserStoreAssignment[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([role])
  @@index([businessRoleId])
}

model BusinessRole {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  description String?
  permissions String         @default("{}")
  isSystem    Boolean        @default(false)
  isActive    Boolean        @default(true)
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       BusinessUser[]

  @@unique([businessId, name])
  @@index([businessId])
}

model UserStoreAssignment {
  id             String       @id @default(cuid())
  businessUserId String
  storeId        String
  createdAt      DateTime     @default(now())
  businessUser   BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([businessUserId, storeId])
  @@index([businessUserId])
  @@index([storeId])
}

model BusinessAuditLog {
  id         String   @id @default(cuid())
  businessId String
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Order {
  id                   String                @id @default(cuid())
  businessId           String
  storeId              String
  orderNumber          String
  orderType            OrderType
  orderSource          String                @default("online")
  status               OrderStatus           @default(PENDING)
  paymentStatus        PaymentStatus         @default(PENDING)
  paymentMethod        PaymentMethodType?
  customerId           String?
  customerName         String?
  customerPhone        String?
  customerEmail        String?
  deliveryAddressId    String?
  deliveryAddress      String?
  deliveryLat          Float?
  deliveryLng          Float?
  deliveryInstructions String?
  scheduledAt          DateTime?
  pickupAddress        String?
  pickupScheduledAt    DateTime?
  pickupCompletedAt    DateTime?
  subtotal             Float                 @default(0)
  totalDiscount        Float                 @default(0)
  totalTax             Float                 @default(0)
  deliveryFee          Float                 @default(0)
  packagingFee         Float                 @default(0)
  convenienceFee       Float                 @default(0)
  tip                  Float                 @default(0)
  roundOff             Float                 @default(0)
  totalAmount          Float                 @default(0)
  cgstAmount           Float                 @default(0)
  sgstAmount           Float                 @default(0)
  igstAmount           Float                 @default(0)
  cessAmount           Float                 @default(0)
  posSessionId         String?
  posOperatorId        String?
  tableNumber          String?
  subscriptionId       String?
  promoCodeId          String?
  pickupPartnerId      String?
  deliveryPartnerId    String?
  deliveryOtp          String?
  pickupOtp            String?
  notes                String?
  cancelReason         String?
  metadata             String                @default("{}")
  confirmedAt          DateTime?
  preparedAt           DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  delivery             Delivery?
  invoice              Invoice?
  promoCode            PromoCode?            @relation(fields: [promoCodeId], references: [id])
  customerSubscription CustomerSubscription? @relation(fields: [subscriptionId], references: [id])
  posSession           POSSession?           @relation(fields: [posSessionId], references: [id])
  customer             Customer?             @relation(fields: [customerId], references: [id])
  store                Store                 @relation(fields: [storeId], references: [id])
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveryPartner      DeliveryPartner?      @relation("OrderDeliveryPartner", fields: [deliveryPartnerId], references: [id])
  pickupPartner        DeliveryPartner?      @relation("OrderPickupPartner", fields: [pickupPartnerId], references: [id])
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  refunds              Refund[]
  locationHistory      PartnerLocationHistory[]
  liveTrackingSession  LiveTrackingSession?

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderType])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  itemType            String
  itemId              String
  itemName            String
  variantName         String?
  sku                 String?
  barcode             String?
  quantity            Float
  unitPrice           Float
  mrp                 Float?
  discountPrice       Float?
  discountPercent     Float?
  totalPrice          Float
  totalMrp            Float?
  gstRate             Float    @default(0)
  gstAmount           Float    @default(0)
  cgstAmount          Float    @default(0)
  sgstAmount          Float    @default(0)
  igstAmount          Float    @default(0)
  specialInstructions String?
  customizations      String?
  isVeg               Boolean?
  unit                String?
  metadata            String   @default("{}")
  createdAt           DateTime @default(now())
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemType])
  @@index([itemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
