// Commission Slip — amounts snapshotted only at approval; generated dynamically until then
model CommissionSlip {
  id             String               @id @default(cuid())
  employeeId     String
  periodType     String
  periodFrom     DateTime
  periodTo       DateTime
  policyId       String?
  signupLines    String               @default("[]")
  renewalLines   String               @default("[]")
  addonLines     String               @default("[]")
  adjustments    Float                @default(0)
  adjustmentNote String?
  status         CommissionSlipStatus @default(DRAFT)
  generatedBy    String?
  approvedBy     String?
  paidAt         DateTime?
  approvedAt     DateTime?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  employee       Employee             @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
}

// Offer Letter Template — reusable with {{MergeTag}} placeholders
model OfferLetterTemplate {
  id           String        @id @default(cuid())
  name         String
  description  String?
  content      String
  isDefault    Boolean       @default(false)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  offerLetters OfferLetter[]
  annexures    Annexure[]
}

// Generated Offer Letter — rendered content after merge tag substitution
model OfferLetter {
  id               String               @id @default(cuid())
  offerRef         String?
  templateId       String?
  employeeId       String?
  candidateName    String
  candidateEmail   String?
  candidateMobile  String?
  designation      String
  joiningDate      DateTime?
  department       String?
  reportingManager String?
  workLocation     String?
  employmentType   EmploymentType       @default(PERMANENT)
  content          String
  status           OfferLetterStatus    @default(DRAFT)
  emailedAt        DateTime?
  sentBy           String?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  expiredAt        DateTime?
  deletedAt        DateTime?
  createdBy        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  template         OfferLetterTemplate? @relation(fields: [templateId], references: [id])
  employee         Employee?            @relation(fields: [employeeId], references: [id])
  annexures        Annexure[]

  @@index([status])
}

// Annexure — independently stored, linked to an Offer Letter
// Numbered: QT/HR/2026/00001-A, QT/HR/2026/00001-B, etc.
model Annexure {
  id            String    @id @default(cuid())
  offerLetterId String
  label         String // "A", "B", "C" — auto-assigned at creation
  annexureRef   String? // "QT/HR/2026/00001-A"
  title         String // "Commission & Incentive Policy"
  content       String    @default("")
  templateId    String?
  deletedAt     DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  offerLetter OfferLetter          @relation(fields: [offerLetterId], references: [id])
  template    OfferLetterTemplate? @relation(fields: [templateId], references: [id])

  @@index([offerLetterId])
}

// ============================================================================
// Platform Audit Log — Quantix internal operations only.
// Tracks every meaningful action by Quantix team members across CRM, Leads,
// Proposals, HRMS, User Management, Settings, etc.
// Never stores client business activities, orders, or customer app actions.
// ============================================================================
model PlatformAuditLog {
  id              String   @id @default(cuid())
  userId          String?
  userName        String?
  email           String?
  role            String?
  module          String // AUTHENTICATION | PROPOSALS | LEADS | etc.
  action          String // LOGIN | CREATE | UPDATE | DELETE | etc.
  page            String? // URL path that was accessed
  resourceType    String? // Entity type: Proposal, Lead, User, etc.
  resourceId      String? // Primary key of affected record
  description     String // Human-readable one-liner
  oldValues       String? // JSON — state before the change
  newValues       String? // JSON — state after the change
  severity        String   @default("INFO") // INFO | WARNING | CRITICAL
  ipAddress       String?
  browser         String?
  operatingSystem String?
  deviceType      String?
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([severity])
}

// ============================================================================
// Quantix Corporate Website — Content Management
// Manages content for quantixtechnology.in — pricing plans, features,
// company information, and legal registrations.
// Editable by Platform Admin through the "Quantix Website" module.
// ============================================================================

model WebsitePricingPlan {
  id                String               @id @default(cuid())
  planKey           String               @unique // starter | business | yearly | custom | additional-store
  planName          String
  billingType       String // monthly | yearly | one_time | custom
  price             Float? // null = "Contact Us" pricing
  priceDisplay      String? // override display string e.g. "Contact Us"
  implementationFee Float?
  description       String?
  discountMessage   String? // e.g. "Get 2 Months Free"
  displayOrder      Int                  @default(0)
  isActive          Boolean              @default(true)
  features          WebsitePlanFeature[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([displayOrder])
}

model WebsitePlanFeature {
  id           String             @id @default(cuid())
  planId       String
  featureName  String
  displayOrder Int                @default(0)
  plan         WebsitePricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([planId])
  @@index([planId, displayOrder])
}

